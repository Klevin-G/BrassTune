{
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build-marketing.mjs",
  "outputDirectory": "marketing-dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/auth/reset-password/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/recovery-bridge.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/more/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/practice/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/metronome/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/sessions/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/analytics/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/progress/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/coach/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ensemble/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/settings/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tuner/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/class/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/classes/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/recordings/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/scales/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/auth/sign-in/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/auth/sign-up/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/auth/callback/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
