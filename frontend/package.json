{
  "name": "brasstune-analytics-frontend",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build && node scripts/assert-locale-chunks.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "npm run e2e:local",
    "e2e:local": "playwright test e2e/release-journeys.spec.ts e2e/accessibility.spec.ts e2e/class-membership.spec.ts e2e/playalong-catalog.spec.ts e2e/score-practice.spec.ts e2e/practice-audio-lifecycle.spec.ts e2e/practice-library.spec.ts e2e/guest-workspace-access.spec.ts",
    "e2e:offline": "npm run build && playwright test --config=playwright.offline.config.ts",
    "e2e:hosted": "node scripts/run-hosted-smoke.mjs",
    "e2e:hosted:strict": "node scripts/run-hosted-smoke.mjs --strict",
    "smoke:hosted": "npm run e2e:hosted",
    "simulate:devices": "node scripts/device-simulation.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.0.227",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intl": "10.1.18",
    "react-router-dom": "^7.18.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "^1.61.0",
    "typescript": "^5.4.5",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.9"
  }
}
