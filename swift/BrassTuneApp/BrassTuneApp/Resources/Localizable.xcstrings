    "Share class code" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"مشاركة رمز الصف"}},"de":{"stringUnit":{"state":"translated","value":"Kurscode teilen"}},"en":{"stringUnit":{"state":"translated","value":"Share class code"}},"es":{"stringUnit":{"state":"translated","value":"Compartir código de clase"}},"fr":{"stringUnit":{"state":"translated","value":"Partager le code de classe"}},"ja":{"stringUnit":{"state":"translated","value":"クラスコードを共有"}},"ko":{"stringUnit":{"state":"translated","value":"수업 코드 공유"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Compartilhar código da turma"}},"ru":{"stringUnit":{"state":"translated","value":"Поделиться кодом класса"}},"vi":{"stringUnit":{"state":"translated","value":"Chia sẻ mã lớp"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分享班级代码"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"分享班級代碼"}}}},
    "Share the code or send a private invitation to an existing username." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"شارك الرمز أو أرسل دعوة خاصة إلى اسم مستخدم موجود."}},"de":{"stringUnit":{"state":"translated","value":"Teile den Code oder sende eine private Einladung an einen vorhandenen Benutzernamen."}},"en":{"stringUnit":{"state":"translated","value":"Share the code or send a private invitation to an existing username."}},"es":{"stringUnit":{"state":"translated","value":"Comparte el código o envía una invitación privada a un usuario existente."}},"fr":{"stringUnit":{"state":"translated","value":"Partagez le code ou envoyez une invitation privée à un nom d’utilisateur existant."}},"ja":{"stringUnit":{"state":"translated","value":"コードを共有するか、既存のユーザー名に非公開の招待を送信します。"}},"ko":{"stringUnit":{"state":"translated","value":"코드를 공유하거나 기존 사용자 이름으로 비공개 초대를 보내세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Compartilhe o código ou envie um convite privado para um nome de usuário existente."}},"ru":{"stringUnit":{"state":"translated","value":"Поделитесь кодом или отправьте личное приглашение существующему пользователю."}},"vi":{"stringUnit":{"state":"translated","value":"Chia sẻ mã hoặc gửi lời mời riêng tới tên người dùng hiện có."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分享代码，或向现有用户名发送私人邀请。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"分享代碼，或向現有使用者名稱傳送私人邀請。"}}}},
    "Student chooses" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"يختار الطالب"}},"de":{"stringUnit":{"state":"translated","value":"Schüler wählt"}},"en":{"stringUnit":{"state":"translated","value":"Student chooses"}},"es":{"stringUnit":{"state":"translated","value":"El estudiante elige"}},"fr":{"stringUnit":{"state":"translated","value":"L’élève choisit"}},"ja":{"stringUnit":{"state":"translated","value":"生徒が選択"}},"ko":{"stringUnit":{"state":"translated","value":"학생이 선택"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O aluno escolhe"}},"ru":{"stringUnit":{"state":"translated","value":"Ученик выбирает"}},"vi":{"stringUnit":{"state":"translated","value":"Học sinh chọn"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"由学生选择"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"由學生選擇"}}}},
    "Student instrument (optional)" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"آلة الطالب (اختياري)"}},"de":{"stringUnit":{"state":"translated","value":"Instrument des Schülers (optional)"}},"en":{"stringUnit":{"state":"translated","value":"Student instrument (optional)"}},"es":{"stringUnit":{"state":"translated","value":"Instrumento del estudiante (opcional)"}},"fr":{"stringUnit":{"state":"translated","value":"Instrument de l’élève (facultatif)"}},"ja":{"stringUnit":{"state":"translated","value":"生徒の楽器（任意）"}},"ko":{"stringUnit":{"state":"translated","value":"학생 악기(선택 사항)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Instrumento do aluno (opcional)"}},"ru":{"stringUnit":{"state":"translated","value":"Инструмент ученика (необязательно)"}},"vi":{"stringUnit":{"state":"translated","value":"Nhạc cụ của học sinh (không bắt buộc)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"学生乐器（可选）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"學生樂器（選填）"}}}},
    "Student roster" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"قائمة الطلاب"}},"de":{"stringUnit":{"state":"translated","value":"Schülerliste"}},"en":{"stringUnit":{"state":"translated","value":"Student roster"}},"es":{"stringUnit":{"state":"translated","value":"Lista de estudiantes"}},"fr":{"stringUnit":{"state":"translated","value":"Liste des élèves"}},"ja":{"stringUnit":{"state":"translated","value":"生徒名簿"}},"ko":{"stringUnit":{"state":"translated","value":"학생 명단"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Lista de alunos"}},"ru":{"stringUnit":{"state":"translated","value":"Список учеников"}},"vi":{"stringUnit":{"state":"translated","value":"Danh sách học sinh"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"学生名单"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"學生名單"}}}},
    "Student username" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"اسم مستخدم الطالب"}},"de":{"stringUnit":{"state":"translated","value":"Benutzername des Schülers"}},"en":{"stringUnit":{"state":"translated","value":"Student username"}},"es":{"stringUnit":{"state":"translated","value":"Usuario del estudiante"}},"fr":{"stringUnit":{"state":"translated","value":"Nom d’utilisateur de l’élève"}},"ja":{"stringUnit":{"state":"translated","value":"生徒のユーザー名"}},"ko":{"stringUnit":{"state":"translated","value":"학생 사용자 이름"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nome de usuário do aluno"}},"ru":{"stringUnit":{"state":"translated","value":"Имя пользователя ученика"}},"vi":{"stringUnit":{"state":"translated","value":"Tên người dùng của học sinh"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"学生用户名"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"學生使用者名稱"}}}},
    "Tap Start Listening, allow microphone access, then play for 2–3 seconds." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"اضغط على «بدء الاستماع»، واسمح بالوصول إلى الميكروفون، ثم اعزف لمدة ثانيتين إلى 3 ثوانٍ."}},"de":{"stringUnit":{"state":"translated","value":"Tippe auf „Zuhören starten“, erlaube den Mikrofonzugriff und spiele dann 2–3 Sekunden."}},"en":{"stringUnit":{"state":"translated","value":"Tap Start Listening, allow microphone access, then play for 2–3 seconds."}},"es":{"stringUnit":{"state":"translated","value":"Toca Iniciar escucha, permite el acceso al micrófono y toca durante 2–3 segundos."}},"fr":{"stringUnit":{"state":"translated","value":"Touchez Commencer l’écoute, autorisez le micro, puis jouez pendant 2 à 3 secondes."}},"ja":{"stringUnit":{"state":"translated","value":"「聴き取りを開始」をタップし、マイクへのアクセスを許可してから2～3秒演奏してください。"}},"ko":{"stringUnit":{"state":"translated","value":"듣기 시작을 탭하고 마이크 접근을 허용한 다음 2~3초 동안 연주하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Toque em Começar a ouvir, permita o acesso ao microfone e toque por 2–3 segundos."}},"ru":{"stringUnit":{"state":"translated","value":"Нажмите «Начать слушать», разрешите доступ к микрофону и играйте 2–3 секунды."}},"vi":{"stringUnit":{"state":"translated","value":"Chạm Bắt đầu nghe, cho phép truy cập micrô, rồi chơi trong 2–3 giây."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"轻点“开始聆听”，允许麦克风访问，然后演奏 2–3 秒。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"點一下「開始聆聽」，允許麥克風存取，然後演奏 2–3 秒。"}}}},
    "The current code will stop working immediately. Existing members keep access." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"سيتوقف الرمز الحالي عن العمل فورًا. سيحتفظ الأعضاء الحاليون بإمكانية الوصول."}},"de":{"stringUnit":{"state":"translated","value":"Der aktuelle Code funktioniert sofort nicht mehr. Bestehende Mitglieder behalten den Zugriff."}},"en":{"stringUnit":{"state":"translated","value":"The current code will stop working immediately. Existing members keep access."}},"es":{"stringUnit":{"state":"translated","value":"El código actual dejará de funcionar de inmediato. Los miembros actuales conservarán el acceso."}},"fr":{"stringUnit":{"state":"translated","value":"Le code actuel cessera immédiatement de fonctionner. Les membres actuels conserveront leur accès."}},"ja":{"stringUnit":{"state":"translated","value":"現在のコードはすぐに使用できなくなります。既存のメンバーは引き続きアクセスできます。"}},"ko":{"stringUnit":{"state":"translated","value":"현재 코드는 즉시 작동하지 않게 됩니다. 기존 구성원은 계속 접근할 수 있습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O código atual deixará de funcionar imediatamente. Os membros atuais manterão o acesso."}},"ru":{"stringUnit":{"state":"translated","value":"Текущий код немедленно перестанет работать. У существующих участников доступ сохранится."}},"vi":{"stringUnit":{"state":"translated","value":"Mã hiện tại sẽ ngừng hoạt động ngay. Thành viên hiện có vẫn giữ quyền truy cập."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前代码将立即失效。现有成员仍可访问。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前代碼將立即失效。現有成員仍可存取。"}}}},
    "They will lose access to this class. Their recordings and reflections stay private in their own account." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"سيفقدون إمكانية الوصول إلى هذا الصف. ستظل تسجيلاتهم وملاحظاتهم خاصة في حسابهم."}},"de":{"stringUnit":{"state":"translated","value":"Die Person verliert den Zugriff auf diesen Kurs. Aufnahmen und Reflexionen bleiben im eigenen Konto privat."}},"en":{"stringUnit":{"state":"translated","value":"They will lose access to this class. Their recordings and reflections stay private in their own account."}},"es":{"stringUnit":{"state":"translated","value":"Perderá el acceso a esta clase. Sus grabaciones y reflexiones seguirán siendo privadas en su cuenta."}},"fr":{"stringUnit":{"state":"translated","value":"Cette personne perdra l’accès à cette classe. Ses enregistrements et réflexions resteront privés dans son compte."}},"ja":{"stringUnit":{"state":"translated","value":"このクラスにアクセスできなくなります。録音と振り返りは本人のアカウントで非公開のままです。"}},"ko":{"stringUnit":{"state":"translated","value":"이 수업에 접근할 수 없게 됩니다. 녹음과 회고는 본인 계정에서 비공개로 유지됩니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"A pessoa perderá o acesso a esta turma. As gravações e reflexões continuarão privadas na própria conta."}},"ru":{"stringUnit":{"state":"translated","value":"Доступ к этому классу будет потерян. Записи и заметки останутся личными в собственном аккаунте."}},"vi":{"stringUnit":{"state":"translated","value":"Họ sẽ mất quyền truy cập lớp này. Bản ghi âm và ghi chú vẫn riêng tư trong tài khoản của họ."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该成员将无法再访问此班级。其录音和反思仍会保留在自己的账户中且保持私密。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"該成員將無法再存取此班級。其錄音和反思仍會保留在自己的帳戶中且保持私密。"}}}},
    "What the director can see" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"ما يمكن للمدرّس رؤيته"}},"de":{"stringUnit":{"state":"translated","value":"Was die Kursleitung sehen kann"}},"en":{"stringUnit":{"state":"translated","value":"What the director can see"}},"es":{"stringUnit":{"state":"translated","value":"Lo que puede ver el director"}},"fr":{"stringUnit":{"state":"translated","value":"Ce que le directeur peut voir"}},"ja":{"stringUnit":{"state":"translated","value":"指導者に表示される内容"}},"ko":{"stringUnit":{"state":"translated","value":"지도자가 볼 수 있는 항목"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O que o diretor pode ver"}},"ru":{"stringUnit":{"state":"translated","value":"Что видит руководитель"}},"vi":{"stringUnit":{"state":"translated","value":"Những gì giáo viên có thể xem"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"指导老师可以看到的内容"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"指導老師可以看到的內容"}}}},
    "You can start as guest and add account backup later." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"يمكنك البدء كضيف وإضافة النسخ الاحتياطي للحساب لاحقًا."}},"de":{"stringUnit":{"state":"translated","value":"Du kannst als Gast beginnen und die Kontosicherung später hinzufügen."}},"en":{"stringUnit":{"state":"translated","value":"You can start as guest and add account backup later."}},"es":{"stringUnit":{"state":"translated","value":"Puedes empezar como invitado y añadir la copia de la cuenta más tarde."}},"fr":{"stringUnit":{"state":"translated","value":"Vous pouvez commencer en tant qu’invité et ajouter la sauvegarde du compte plus tard."}},"ja":{"stringUnit":{"state":"translated","value":"ゲストとして始め、あとからアカウントのバックアップを追加できます。"}},"ko":{"stringUnit":{"state":"translated","value":"게스트로 시작하고 나중에 계정 백업을 추가할 수 있습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Você pode começar como convidado e adicionar o backup da conta depois."}},"ru":{"stringUnit":{"state":"translated","value":"Можно начать как гость и позже добавить резервную копию аккаунта."}},"vi":{"stringUnit":{"state":"translated","value":"Bạn có thể bắt đầu với tư cách khách và thêm sao lưu tài khoản sau."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你可以先以访客身份开始，稍后再添加账户备份。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"你可以先以訪客身分開始，稍後再加入帳戶備份。"}}}},
    "You choose whether to join. Pick your own instrument before accepting." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"أنت من يقرر الانضمام. اختر آلتك قبل القبول."}},"de":{"stringUnit":{"state":"translated","value":"Du entscheidest, ob du beitrittst. Wähle vor dem Annehmen dein Instrument."}},"en":{"stringUnit":{"state":"translated","value":"You choose whether to join. Pick your own instrument before accepting."}},"es":{"stringUnit":{"state":"translated","value":"Tú decides si unirte. Elige tu instrumento antes de aceptar."}},"fr":{"stringUnit":{"state":"translated","value":"Vous décidez de rejoindre la classe. Choisissez votre instrument avant d’accepter."}},"ja":{"stringUnit":{"state":"translated","value":"参加するかは自分で選べます。承認する前に楽器を選んでください。"}},"ko":{"stringUnit":{"state":"translated","value":"참여 여부는 직접 선택합니다. 수락하기 전에 악기를 선택하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Você decide se quer entrar. Escolha seu instrumento antes de aceitar."}},"ru":{"stringUnit":{"state":"translated","value":"Вы сами решаете, вступать ли в класс. Выберите инструмент перед принятием."}},"vi":{"stringUnit":{"state":"translated","value":"Bạn quyết định có tham gia hay không. Chọn nhạc cụ trước khi chấp nhận."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"是否加入由你决定。接受前请先选择自己的乐器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"是否加入由你決定。接受前請先選擇自己的樂器。"}}}},
    "Your instrument" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"آلتك"}},"de":{"stringUnit":{"state":"translated","value":"Dein Instrument"}},"en":{"stringUnit":{"state":"translated","value":"Your instrument"}},"es":{"stringUnit":{"state":"translated","value":"Tu instrumento"}},"fr":{"stringUnit":{"state":"translated","value":"Votre instrument"}},"ja":{"stringUnit":{"state":"translated","value":"あなたの楽器"}},"ko":{"stringUnit":{"state":"translated","value":"내 악기"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Seu instrumento"}},"ru":{"stringUnit":{"state":"translated","value":"Ваш инструмент"}},"vi":{"stringUnit":{"state":"translated","value":"Nhạc cụ của bạn"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的乐器"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"你的樂器"}}}},
    "aggregate" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"إجمالي"}},"de":{"stringUnit":{"state":"translated","value":"zusammengefasst"}},"en":{"stringUnit":{"state":"translated","value":"aggregate"}},"es":{"stringUnit":{"state":"translated","value":"agregado"}},"fr":{"stringUnit":{"state":"translated","value":"agrégé"}},"ja":{"stringUnit":{"state":"translated","value":"集計"}},"ko":{"stringUnit":{"state":"translated","value":"집계"}},"pt-BR":{"stringUnit":{"state":"translated","value":"agregado"}},"ru":{"stringUnit":{"state":"translated","value":"сводно"}},"vi":{"stringUnit":{"state":"translated","value":"tổng hợp"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"汇总"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"彙總"}}}},
    "all students" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"جميع الطلاب"}},"de":{"stringUnit":{"state":"translated","value":"alle Schüler"}},"en":{"stringUnit":{"state":"translated","value":"all students"}},"es":{"stringUnit":{"state":"translated","value":"todos los estudiantes"}},"fr":{"stringUnit":{"state":"translated","value":"tous les élèves"}},"ja":{"stringUnit":{"state":"translated","value":"全生徒"}},"ko":{"stringUnit":{"state":"translated","value":"모든 학생"}},"pt-BR":{"stringUnit":{"state":"translated","value":"todos os alunos"}},"ru":{"stringUnit":{"state":"translated","value":"все ученики"}},"vi":{"stringUnit":{"state":"translated","value":"tất cả học sinh"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所有学生"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"所有學生"}}}},
