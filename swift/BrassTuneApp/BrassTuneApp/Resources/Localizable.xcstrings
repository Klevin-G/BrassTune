        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune không nghe thấy micrô. Hãy kiểm tra đầu vào âm thanh rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
