    } },
    "A little sharp — ease down" : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"مرتفع قليلًا — اخفضه"}},"de":{"stringUnit":{"state":"translated","value":"Etwas zu hoch — tiefer werden"}},"en":{"stringUnit":{"state":"translated","value":"A little sharp — ease down"}},"es":{"stringUnit":{"state":"translated","value":"Un poco alto — baja suavemente"}},"fr":{"stringUnit":{"state":"translated","value":"Un peu trop haut — descendez doucement"}},"ja":{"stringUnit":{"state":"translated","value":"少し高い — ゆっくり下げる"}},"ko":{"stringUnit":{"state":"translated","value":"조금 높음 — 부드럽게 낮추세요"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Um pouco alto — desça suavemente"}},"ru":{"stringUnit":{"state":"translated","value":"Немного выше — мягко опустите"}},"vi":{"stringUnit":{"state":"translated","value":"Hơi cao — hạ nhẹ xuống"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"稍微偏高 — 轻轻降低"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"稍微偏高 — 輕輕降低"}}
