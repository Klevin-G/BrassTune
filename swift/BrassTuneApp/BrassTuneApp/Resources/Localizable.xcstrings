    "Play your first note in under a minute. Tune accurately, start a guided warm-up, and track progress." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعزف نغمتك الأولى في أقل من دقيقة. اضبط بدقة، وابدأ إحماءً موجّهًا، وتابع تقدمك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele deinen ersten Ton in weniger als einer Minute. Stimme präzise, starte ein geführtes Warm-up und verfolge deinen Fortschritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play your first note in under a minute. Tune accurately, start a guided warm-up, and track progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca tu primera nota en menos de un minuto. Afina con precisión, inicia un calentamiento guiado y sigue tu progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouez votre première note en moins d’une minute. Accordez-vous avec précision, lancez un échauffement guidé et suivez vos progrès."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1分以内に最初の音を鳴らせます。正確にチューニングし、ガイド付きウォームアップを始め、進捗を確認しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1분 안에 첫 음을 연주해 보세요. 정확하게 튜닝하고 가이드 워밍업을 시작해 진행 상황을 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque sua primeira nota em menos de um minuto. Afine com precisão, inicie um aquecimento guiado e acompanhe o progresso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сыграйте первую ноту меньше чем за минуту. Точно настройтесь, начните разминку с подсказками и отслеживайте прогресс."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chơi nốt đầu tiên trong chưa đầy một phút. Chỉnh âm chính xác, bắt đầu khởi động có hướng dẫn và theo dõi tiến độ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不到一分钟即可吹奏第一个音符。准确调音、开始引导热身并跟踪进度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不到一分鐘即可吹奏第一個音符。準確調音、開始引導暖身並追蹤進度。"
          }
        }
      }
    },
