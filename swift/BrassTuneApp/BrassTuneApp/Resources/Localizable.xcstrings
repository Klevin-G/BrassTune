    "Apple and Google sign-in need provider setup. Email and password still work." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب تسجيل الدخول عبر Apple وGoogle إعداد موفري الخدمة. لا يزال البريد الإلكتروني وكلمة المرور يعملان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung mit Apple und Google benötigt eine Anbieter-Einrichtung. E-Mail und Passwort funktionieren weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple and Google sign-in need provider setup. Email and password still work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio con Apple y Google requiere configurar los proveedores. El correo y la contraseña siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion avec Apple et Google nécessite la configuration des fournisseurs. L’e-mail et le mot de passe fonctionnent toujours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleとGoogleでのサインインにはプロバイダ設定が必要です。メールとパスワードは引き続き使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 및 Google 로그인에는 제공업체 설정이 필요합니다. 이메일과 비밀번호는 계속 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O início de sessão com Apple e Google precisa de configuração dos provedores. E-mail e senha continuam funcionando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для входа через Apple и Google нужна настройка провайдеров. Электронная почта и пароль по-прежнему работают."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập bằng Apple và Google cần thiết lập nhà cung cấp. Email và mật khẩu vẫn hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 和 Google 登录需要配置提供商。电子邮件和密码仍可使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 和 Google 登入需要設定提供者。電子郵件和密碼仍可使用。"
          }
        }
      }
    },
