    "Signed out on this device. BrassTune couldn't confirm server logout, so try again online before using a shared device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل الخروج على هذا الجهاز. تعذر تأكيد الخروج من الخادم؛ حاول مجددًا عند الاتصال قبل استخدام جهاز مشترك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät abgemeldet. Die Server-Abmeldung konnte nicht bestätigt werden; versuche es online erneut, bevor du ein geteiltes Gerät nutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed out on this device. BrassTune couldn't confirm server logout, so try again online before using a shared device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión cerrada en este dispositivo. No se pudo confirmar en el servidor; vuelve a intentarlo con conexión antes de usar un dispositivo compartido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté sur cet appareil. La déconnexion du serveur n’a pas été confirmée; réessayez en ligne avant d’utiliser un appareil partagé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではサインアウトしました。サーバー側を確認できなかったため、共有デバイスを使う前にオンラインで再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 로그아웃했습니다. 서버 로그아웃을 확인하지 못했으므로 공유 기기 사용 전 온라인에서 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão encerrada neste dispositivo. Não foi possível confirmar no servidor; tente novamente on-line antes de usar um dispositivo compartilhado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве выполнен выход. Выход на сервере не подтвержден; повторите попытку онлайн перед использованием общего устройства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đăng xuất trên thiết bị này. Không thể xác nhận với máy chủ; hãy thử lại khi trực tuyến trước khi dùng thiết bị chung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在此设备上退出登录。BrassTune 无法确认服务器退出；使用共享设备前请联网重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在此裝置上登出。BrassTune 無法確認伺服器登出；使用共用裝置前請連線重試。"
          }
        }
      }
    },
