          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無理のない音を1つ吹き、中心を見つけて結果を保存しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편안한 음 하나를 연주하고 중심을 찾은 다음 결과를 저장하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
