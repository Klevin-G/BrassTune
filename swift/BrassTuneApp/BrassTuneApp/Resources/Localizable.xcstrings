    "Online accounts aren't configured in this build. You can still practice as a guest, and your data stays on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحسابات عبر الإنترنت غير مهيأة في هذا الإصدار. لا يزال بإمكانك التدريب كضيف، وتبقى بياناتك على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Online-Konten sind in diesem Build nicht eingerichtet. Du kannst als Gast üben; deine Daten bleiben auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online accounts aren't configured in this build. You can still practice as a guest, and your data stays on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas en línea no están configuradas en esta versión. Puedes practicar como invitado; tus datos permanecen en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes en ligne ne sont pas configurés dans cette version. Vous pouvez continuer à vous entraîner en mode invité, et vos données restent sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドではオンラインアカウントが設定されていません。ゲストとして練習でき、データはこのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에는 온라인 계정이 구성되어 있지 않습니다. 게스트로 연습할 수 있으며 데이터는 이 기기에 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As contas on-line não estão configuradas nesta versão. Você pode praticar como convidado; seus dados ficam neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Онлайн-аккаунты не настроены в этой сборке. Можно заниматься как гость; данные останутся на этом устройстве."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản trực tuyến chưa được cấu hình trong bản dựng này. Bạn vẫn có thể luyện tập với tư cách khách; dữ liệu ở lại thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未配置在线账户。你仍可作为访客练习，数据会保留在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
