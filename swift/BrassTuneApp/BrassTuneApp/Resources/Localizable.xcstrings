    "Follow the system language or choose a BrassTune language explicitly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتبع لغة النظام أو اختر لغة BrassTune بشكل صريح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
