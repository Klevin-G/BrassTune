    "The recording reached its local limit. Saved audio is partial; tuning results include the full session." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصل التسجيل إلى حدّه المحلي. الصوت المحفوظ جزئي، لكن نتائج الضبط تشمل الجلسة كاملة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme hat ihr lokales Limit erreicht. Der gespeicherte Ton ist nur teilweise vorhanden; die Stimmungsergebnisse enthalten die ganze Sitzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording reached its local limit. Saved audio is partial; tuning results include the full session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación alcanzó su límite local. El audio guardado es parcial; los resultados de afinación incluyen toda la sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement a atteint sa limite locale. L’audio enregistré est partiel ; les résultats d’accordage couvrent toute la séance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音が端末内の上限に達しました。保存された音声は一部ですが、チューニング結果には練習全体が含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹음이 기기 내 한도에 도달했습니다. 저장된 오디오는 일부이지만 조율 결과에는 전체 연습이 포함됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação atingiu o limite local. O áudio salvo é parcial; os resultados de afinação incluem toda a sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись достигла локального ограничения. Сохранено только частичное аудио, а результаты настройки включают всю сессию."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản ghi đã đạt giới hạn cục bộ. Âm thanh đã lưu chỉ là một phần, nhưng kết quả điều chỉnh bao gồm toàn bộ buổi luyện tập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音达到本地限制。已保存的音频不完整；音准结果包含完整练习。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄音達到本機限制。已儲存的音訊不完整；音準結果包含完整練習。"
          }
        }
      }
    },
    "The reference tone stopped because your audio output changed. Check your headphones or speaker before restarting." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقفت النغمة المرجعية بسبب تغير إخراج الصوت. تحقق من سماعات الرأس أو مكبر الصوت قبل إعادة التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Referenzton wurde gestoppt, weil sich Ihre Audioausgabe geändert hat. Überprüfen Sie vor dem Neustart Ihre Kopfhörer oder Lautsprecher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reference tone stopped because your audio output changed. Check your headphones or speaker before restarting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tono de referencia se detuvo porque su salida de audio cambió. Verifique sus auriculares o altavoz antes de reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tonalité de référence s'est arrêtée car votre sortie audio a changé. Vérifiez vos écouteurs ou votre haut-parleur avant de redémarrer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオ出力が変化したため、基準音が停止しました。再起動する前にヘッドフォンまたはスピーカーを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오 출력이 변경되어 기준음이 중지되었습니다. 다시 시작하기 전에 헤드폰이나 스피커를 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tom de referência parou porque a saída de áudio foi alterada. Verifique seus fones de ouvido ou alto-falante antes de reiniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опорный сигнал прекратился, потому что у вас изменился аудиовыход. Проверьте наушники или динамик перед перезапуском."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm tham chiếu đã dừng do đầu ra âm thanh của bạn thay đổi. Kiểm tra tai nghe hoặc loa của bạn trước khi khởi động lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于音频输出发生变化，参考音停止了。重新启动之前检查您的耳机或扬声器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於音訊輸出變化，參考音停止了。重新啟動之前檢查您的耳機或揚聲器。"
          }
        }
      }
    },
