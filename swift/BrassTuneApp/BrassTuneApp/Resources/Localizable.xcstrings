          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте ноты 1–32. Используйте видимые кнопки перемещения, чтобы расположить их по порядку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm 1–32 ghi chú. Sử dụng các nút di chuyển có thể nhìn thấy để sắp xếp chúng theo thứ tự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
