    "Tap Start Listening, allow microphone access, then play for 2–3 seconds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على «بدء الاستماع»، واسمح بالوصول إلى الميكروفون، ثم اعزف لمدة ثانيتين إلى 3 ثوانٍ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Zuhören starten“, erlaube den Mikrofonzugriff und spiele dann 2–3 Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Start Listening, allow microphone access, then play for 2–3 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Iniciar escucha, permite el acceso al micrófono y toca durante 2–3 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Commencer l’écoute, autorisez le micro, puis jouez pendant 2 à 3 secondes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「聴き取りを開始」をタップし、マイクへのアクセスを許可してから2～3秒演奏してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "듣기 시작을 탭하고 마이크 접근을 허용한 다음 2~3초 동안 연주하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Começar a ouvir, permita o acesso ao microfone e toque por 2–3 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Начать слушать», разрешите доступ к микрофону и играйте 2–3 секунды."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm Bắt đầu nghe, cho phép truy cập micrô, rồi chơi trong 2–3 giây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点“开始聆听”，允许麦克风访问，然后演奏 2–3 秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下「開始聆聽」，允許麥克風存取，然後演奏 2–3 秒。"
          }
        }
      }
    },
