    "Intonation is settling. Add a repertoire excerpt after the next long-tone pass.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التجويد يستقر. أضف مقتطفًا من المرجع بعد تمريرة النغمة الطويلة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Intonation beruhigt sich. Fügen Sie nach dem nächsten Langtondurchgang einen Repertoireauszug hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intonation is settling. Add a repertoire excerpt after the next long-tone pass."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entonación se está asentando. Agregue un extracto del repertorio después del siguiente pase de tono largo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intonation s'installe. Ajoutez un extrait de répertoire après le prochain passage à ton long."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イントネーションが定着してきました。次のロングトーンパスの後にレパートリーの抜粋を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "억양이 안정되고 있습니다. 다음 장음 패스 이후에 발췌 레퍼토리를 추가합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A entonação está se estabilizando. Adicione um trecho do repertório após a próxima passagem de tom longo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Интонация налаживается. Добавьте отрывок из репертуара после следующего прохода длинного тона."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngữ điệu đang ổn định. Thêm một đoạn trích tiết mục sau đoạn dài tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语调正在稳定。在下一个长音通道后添加曲目摘录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語調正在穩定。在下一個長音通道後面加入曲目摘錄。"
          }
        }
      }
    },
    "Join another class": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انضم إلى فصل آخر"
          }
        },
        "de": {
