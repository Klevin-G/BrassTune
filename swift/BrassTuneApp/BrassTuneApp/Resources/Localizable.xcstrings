    "Each pack is stored in the app and opens one focused block at a time. No account or network is required.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تخزين كل حزمة في التطبيق وتفتح كتلة واحدة مركزة في كل مرة. لا يوجد حساب أو شبكة مطلوبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Paket wird in der App gespeichert und öffnet jeweils einen fokussierten Block. Es ist kein Konto oder Netzwerk erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each pack is stored in the app and opens one focused block at a time. No account or network is required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada paquete se almacena en la aplicación y abre un bloque enfocado a la vez. No se requiere cuenta ni red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque pack est stocké dans l'application et ouvre un bloc ciblé à la fois. Aucun compte ou réseau n'est requis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各パックはアプリに保存され、フォーカスされたブロックを一度に 1 つずつ開きます。アカウントやネットワークは必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 팩은 앱에 저장되며 한 번에 하나의 집중된 블록을 엽니다. 계정이나 네트워크가 필요하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pacote é armazenado no aplicativo e abre um bloco específico por vez. Nenhuma conta ou rede é necessária."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый пакет хранится в приложении и открывает по одному блоку за раз. Никакая учетная запись или сеть не требуется."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi gói được lưu trữ trong ứng dụng và mở một khối tập trung tại một thời điểm. Không cần tài khoản hoặc mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个包都存储在应用程序中，并一次打开一个焦点块。无需帐户或网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個包都儲存在應用程式中，並一次打開一個焦點區塊。無需帳戶或網路。"
          }
        }
      }
    },
