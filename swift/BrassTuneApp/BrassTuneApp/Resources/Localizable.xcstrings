    "Your completed practice history will stay saved, but this pack's current place will be removed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظل سجل تدريبك المكتمل محفوظًا، ولكن ستتم إزالة المكان الحالي لهذه الحزمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr abgeschlossener Übungsverlauf bleibt gespeichert, der aktuelle Platz dieses Pakets wird jedoch entfernt."
          }
        },
        "en": {
