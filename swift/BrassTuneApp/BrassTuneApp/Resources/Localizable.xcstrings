    "BrassTune couldn't save your latest changes on this device. Keep the app open, export your data if needed, and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على BrassTune حفظ أحدث تغييراتك على هذا الجهاز. اترك التطبيق مفتوحًا، وصدّر بياناتك عند الحاجة، وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune konnte deine letzten Änderungen nicht speichern. Lass die App geöffnet, exportiere deine Daten bei Bedarf und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune couldn't save your latest changes on this device. Keep the app open, export your data if needed, and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune no pudo guardar los últimos cambios. Mantén la app abierta, exporta tus datos si es necesario e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
