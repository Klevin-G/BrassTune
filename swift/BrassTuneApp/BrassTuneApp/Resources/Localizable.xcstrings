    "One sign-in provider needs setup. Use an available provider or email and password." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج أحد موفري تسجيل الدخول إلى الإعداد. استخدم موفرًا متاحًا أو البريد الإلكتروني وكلمة المرور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Anmeldeanbieter muss eingerichtet werden. Nutze einen verfügbaren Anbieter oder E-Mail und Passwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One sign-in provider needs setup. Use an available provider or email and password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un proveedor de inicio necesita configuración. Usa uno disponible o el correo y la contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fournisseur de connexion doit être configuré. Utilisez un fournisseur disponible ou l’e-mail et le mot de passe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つのサインインプロバイダに設定が必要です。利用可能なプロバイダかメールとパスワードを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 제공업체 하나에 설정이 필요합니다. 사용 가능한 제공업체 또는 이메일과 비밀번호를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um provedor de início precisa ser configurado. Use um provedor disponível ou e-mail e senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один провайдер входа требует настройки. Используйте доступный провайдер или почту и пароль."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một nhà cung cấp đăng nhập cần thiết lập. Hãy dùng nhà cung cấp có sẵn hoặc email và mật khẩu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个登录提供商需要配置。请使用可用的提供商或电子邮件和密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個登入提供者需要設定。請使用可用的提供者或電子郵件和密碼。"
          }
        }
      }
    },
    "Online accounts aren't configured in this build. You can still practice as a guest, and your data stays on this device." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحسابات عبر الإنترنت غير مهيأة في هذا الإصدار. لا يزال بإمكانك التدريب كضيف، وتبقى بياناتك على هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online-Konten sind in diesem Build nicht eingerichtet. Du kannst als Gast üben; deine Daten bleiben auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online accounts aren't configured in this build. You can still practice as a guest, and your data stays on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas en línea no están configuradas en esta versión. Puedes practicar como invitado; tus datos permanecen en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes en ligne ne sont pas configurés dans cette version. Vous pouvez continuer à vous entraîner en mode invité, et vos données restent sur cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビルドではオンラインアカウントが設定されていません。ゲストとして練習でき、データはこのデバイスに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 빌드에는 온라인 계정이 구성되어 있지 않습니다. 게스트로 연습할 수 있으며 데이터는 이 기기에 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas on-line não estão configuradas nesta versão. Você pode praticar como convidado; seus dados ficam neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Онлайн-аккаунты не настроены в этой сборке. Можно заниматься как гость; данные останутся на этом устройстве."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản trực tuyến chưa được cấu hình trong bản dựng này. Bạn vẫn có thể luyện tập với tư cách khách; dữ liệu ở lại thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本未配置在线账户。你仍可作为访客练习，数据会保留在此设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本未設定線上帳戶。你仍可作為訪客練習，資料會保留在此裝置上。"
          }
        }
      }
    },
    "Only class-level and student aggregate practice minutes, session counts, and tuning summaries are shared." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتم مشاركة سوى دقائق التدريب الإجمالية وعدد الجلسات وملخصات الضبط على مستوى الصف والطالب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geteilt werden nur zusammengefasste Übungsminuten, Sitzungszahlen und Stimmübersichten für Kurs und Schüler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only class-level and student aggregate practice minutes, session counts, and tuning summaries are shared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se comparten minutos de práctica, cantidad de sesiones y resúmenes de afinación agregados de la clase y cada estudiante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les minutes de pratique, nombres de séances et résumés d’accordage agrégés de la classe et des élèves sont partagés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラスと生徒ごとの練習時間、セッション数、チューニング概要の集計だけが共有されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클래스 및 학생별 집계 연습 시간, 세션 수, 튜닝 요약만 공유됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas minutos de prática, contagens de sessões e resumos de afinação agregados da turma e dos alunos são compartilhados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передаются только сводные минуты занятий, число сессий и итоги настройки по классу и ученикам."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ chia sẻ số phút luyện tập, số buổi và tóm tắt chỉnh dây tổng hợp của lớp và học sinh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅共享班级和学生的汇总练习分钟数、练习次数和调音摘要。"
          }
        },
        "zh-Hant" : {
