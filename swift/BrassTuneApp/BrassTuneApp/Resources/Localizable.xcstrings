    "Edit or remove saved exercises here. Removing one also clears its shortcuts." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "حرّر التمارين المحفوظة أو احذفها هنا. يؤدي حذف تمرين أيضًا إلى إزالة اختصاراته." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bearbeite oder entferne hier gespeicherte Übungen. Beim Entfernen werden auch die zugehörigen Kurzbefehle gelöscht." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Edit or remove saved exercises here. Removing one also clears its shortcuts." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Edita o elimina aquí los ejercicios guardados. Al eliminar uno, también se borran sus accesos directos." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Modifiez ou supprimez ici les exercices enregistrés. La suppression d’un exercice efface aussi ses raccourcis." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存した練習の編集や削除ができます。削除すると、そのショートカットも消去されます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장한 연습을 여기에서 편집하거나 삭제하세요. 삭제하면 해당 바로가기도 함께 지워집니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Edite ou remova exercícios salvos aqui. Ao remover um exercício, os atalhos dele também são apagados." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Здесь можно изменить или удалить сохранённые упражнения. При удалении также будут удалены их ярлыки." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chỉnh sửa hoặc xóa các bài tập đã lưu tại đây. Khi xóa một bài tập, các lối tắt của bài tập đó cũng bị xóa." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在此编辑或移除已保存的练习。移除练习时，也会清除它的快捷方式。" } },
