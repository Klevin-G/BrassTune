        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune 無法完成身分驗證。"
          }
        }
      }
    },
    "BrassTune could not hear the microphone. Check your audio input and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على BrassTune سماع الميكروفون. تحقق من إدخال الصوت وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune konnte das Mikrofon nicht hören. Prüfe den Audioeingang und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune could not hear the microphone. Check your audio input and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune no pudo oír el micrófono. Revisa la entrada de audio e inténtalo de nuevo."
