    "Repeat stable long tones and hold each pitch through the release.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كرر النغمات الطويلة الثابتة واستمر في الضغط على كل نغمة خلال التحرير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholen Sie stabile lange Töne und halten Sie jede Tonhöhe bis zum Loslassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat stable long tones and hold each pitch through the release."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita tonos largos estables y mantenga cada tono durante el lanzamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétez des tonalités longues et stables et maintenez chaque hauteur jusqu'au relâchement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安定したロングトーンを繰り返し、リリースまで一音一音をキープします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안정적인 긴 톤을 반복하고 릴리스를 통해 각 피치를 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita tons longos e estáveis e mantenha cada tom durante o lançamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторяйте устойчивые длинные звуки и удерживайте каждую ноту до момента отпускания."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lặp lại các âm dài ổn định và giữ từng cao độ khi thả ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复稳定的长音并在释放过程中保持每个音高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複穩定的長音並在釋放過程中保持每個音高。"
          }
        }
      }
    },
