    "Use BrassTune only with consent and within the policies of the school, studio, or organization providing access." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم BrassTune فقط بموافقة ووفق سياسات المدرسة أو الاستوديو أو المؤسسة التي توفر إمكانية الوصول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie BrassTune nur mit Einwilligung und gemäß den Richtlinien der Schule, des Studios oder der Organisation, die den Zugang bereitstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use BrassTune only with consent and within the policies of the school, studio, or organization providing access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa BrassTune solo con consentimiento y conforme a las políticas de la escuela, el estudio o la organización que proporciona el acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez BrassTune uniquement avec consentement et dans le respect des règles de l’école, du studio ou de l’organisation qui fournit l’accès."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BrassTune は同意を得た上で、アクセスを提供する学校、教室、組織のポリシーに従って使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BrassTune은 동의를 받고 접근 권한을 제공하는 학교, 스튜디오 또는 기관의 정책 범위 내에서만 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o BrassTune somente com consentimento e de acordo com as políticas da escola, estúdio ou organização que fornece o acesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте BrassTune только с согласия и в рамках правил школы, студии или организации, предоставляющей доступ."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ sử dụng BrassTune khi có sự đồng ý và theo chính sách của trường, phòng tập hoặc tổ chức cung cấp quyền truy cập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在获得同意并遵守提供访问权限的学校、工作室或组织政策的情况下使用 BrassTune。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在獲得同意並遵守提供存取權限的學校、工作室或組織政策的情況下使用 BrassTune。"
          }
        }
      }
    },
    "Use headphones when possible, then match the tone gently." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم سماعات الرأس عند الإمكان، ثم طابق النغمة المرجعية برفق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie nach Möglichkeit Kopfhörer und gleichen Sie dann vorsichtig den Referenzton ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use headphones when possible, then match the tone gently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa auriculares cuando sea posible y luego iguala suavemente el tono de referencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
