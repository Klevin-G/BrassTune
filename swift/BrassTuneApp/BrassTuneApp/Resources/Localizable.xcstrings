    "Your server account record will be deleted, and this device will clear its saved sign-in, practice history, and imported sheet music. This can't be undone." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف سجل حساب الخادم الخاص بك، وسيقوم هذا الجهاز بمسح تسجيل الدخول المحفوظ وسجل التدريب والنوتة الموسيقية المستوردة. لا يمكن التراجع عن هذا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Serverkontodatensatz wird gelöscht und dieses Gerät löscht seine gespeicherten Anmeldungen, den Übungsverlauf und die importierten Noten. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your server account record will be deleted, and this device will clear its saved sign-in, practice history, and imported sheet music. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará el registro de su cuenta del servidor y este dispositivo borrará su inicio de sesión guardado, su historial de práctica y sus partituras importadas. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement de votre compte serveur sera supprimé et cet appareil effacera sa connexion enregistrée, son historique d'entraînement et ses partitions importées. Cela ne peut pas être annulé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバー アカウントのレコードが削除され、このデバイスでは保存されているサインイン、練習履歴、インポートされた楽譜が消去されます。これを元に戻すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀하의 서버 계정 기록이 삭제되며, 이 기기는 저장된 로그인, 연습 내역, 가져온 악보를 삭제합니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O registro da sua conta do servidor será excluído e este dispositivo limpará o login salvo, o histórico de prática e as partituras importadas. Isso não pode ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись вашей учетной записи на сервере будет удалена, а с этого устройства будут удалены сохраненные данные входа в систему, история тренировок и импортированные ноты. Это невозможно отменить."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản ghi tài khoản máy chủ của bạn sẽ bị xóa và thiết bị này sẽ xóa thông tin đăng nhập đã lưu, lịch sử luyện tập và bản nhạc đã nhập. Không thể hoàn tác việc này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的服务器帐户记录将被删除，并且该设备将清除其保存的登录、练习历史记录和导入的乐谱。这无法撤消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的伺服器帳戶記錄將被刪除，並且該裝置將清除其已儲存的登入、練習歷史記錄和匯入的樂譜。這無法撤消。"
          }
        }
      }
    },
    "Your sign-in expired. Sign in again before deleting your account." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية تسجيل الدخول الخاص بك. قم بتسجيل الدخول مرة أخرى قبل حذف حسابك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Anmeldung ist abgelaufen. Melden Sie sich erneut an, bevor Sie Ihr Konto löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sign-in expired. Sign in again before deleting your account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su inicio de sesión expiró. Inicie sesión nuevamente antes de eliminar su cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre connexion a expiré. Connectez-vous à nouveau avant de supprimer votre compte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインの有効期限が切れました。アカウントを削除する前に、再度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인이 만료되었습니다. 계정을 삭제하기 전에 다시 로그인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu login expirou. Faça login novamente antes de excluir sua conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок действия вашего входа истек. Прежде чем удалять свою учетную запись, войдите еще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập của bạn đã hết hạn. Đăng nhập lại trước khi xóa tài khoản của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的登录已过期。删除您的帐户之前请重新登录。"
