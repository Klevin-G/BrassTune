    "Build steady air" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"ثبّت تدفق الهواء"}},"de":{"stringUnit":{"state":"translated","value":"Baue einen gleichmäßigen Luftstrom auf"}},"en":{"stringUnit":{"state":"translated","value":"Build steady air"}},"es":{"stringUnit":{"state":"translated","value":"Desarrolla un flujo de aire constante"}},"fr":{"stringUnit":{"state":"translated","value":"Développe un souffle régulier"}},"ja":{"stringUnit":{"state":"translated","value":"安定した息を作る"}},"ko":{"stringUnit":{"state":"translated","value":"안정적인 호흡 만들기"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Desenvolva um fluxo de ar constante"}},"ru":{"stringUnit":{"state":"translated","value":"Развивайте ровный поток воздуха"}},"vi":{"stringUnit":{"state":"translated","value":"Tạo luồng hơi đều"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"建立稳定气流"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"建立穩定氣流"}}}} ,
    "Build your scale" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"أنشئ سلمك الموسيقي"}},"de":{"stringUnit":{"state":"translated","value":"Erstelle deine Tonleiter"}},"en":{"stringUnit":{"state":"translated","value":"Build your scale"}},"es":{"stringUnit":{"state":"translated","value":"Crea tu escala"}},"fr":{"stringUnit":{"state":"translated","value":"Crée ta gamme"}},"ja":{"stringUnit":{"state":"translated","value":"音階を作る"}},"ko":{"stringUnit":{"state":"translated","value":"음계 만들기"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Monte sua escala"}},"ru":{"stringUnit":{"state":"translated","value":"Создайте свою гамму"}},"vi":{"stringUnit":{"state":"translated","value":"Tạo thang âm của bạn"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建你的音阶"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"建立你的音階"}}}} ,
    "Centered notes" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"النغمات المضبوطة"}},"de":{"stringUnit":{"state":"translated","value":"Zentrierte Töne"}},"en":{"stringUnit":{"state":"translated","value":"Centered notes"}},"es":{"stringUnit":{"state":"translated","value":"Notas centradas"}},"fr":{"stringUnit":{"state":"translated","value":"Notes centrées"}},"ja":{"stringUnit":{"state":"translated","value":"中心に合った音"}},"ko":{"stringUnit":{"state":"translated","value":"중심에 맞는 음"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Notas centralizadas"}},"ru":{"stringUnit":{"state":"translated","value":"Точные ноты"}},"vi":{"stringUnit":{"state":"translated","value":"Nốt đúng tâm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"音准居中的音符"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"音準置中的音符"}}}} ,
    "Choose a scale and play." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"اختر سلمًا موسيقيًا واعزف."}},"de":{"stringUnit":{"state":"translated","value":"Wähle eine Tonleiter und spiele."}},"en":{"stringUnit":{"state":"translated","value":"Choose a scale and play."}},"es":{"stringUnit":{"state":"translated","value":"Elige una escala y toca."}},"fr":{"stringUnit":{"state":"translated","value":"Choisis une gamme et joue."}},"ja":{"stringUnit":{"state":"translated","value":"音階を選んで演奏しましょう。"}},"ko":{"stringUnit":{"state":"translated","value":"음계를 선택하고 연주하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha uma escala e toque."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите гамму и играйте."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn một thang âm và chơi."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择音阶并演奏。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇音階並演奏。"}}}} ,
    "Choose how BrassTune looks on this device." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"اختر مظهر BrassTune على هذا الجهاز."}},"de":{"stringUnit":{"state":"translated","value":"Wähle, wie BrassTune auf diesem Gerät aussieht."}},"en":{"stringUnit":{"state":"translated","value":"Choose how BrassTune looks on this device."}},"es":{"stringUnit":{"state":"translated","value":"Elige cómo se ve BrassTune en este dispositivo."}},"fr":{"stringUnit":{"state":"translated","value":"Choisis l’apparence de BrassTune sur cet appareil."}},"ja":{"stringUnit":{"state":"translated","value":"このデバイスでのBrassTuneの表示を選びます。"}},"ko":{"stringUnit":{"state":"translated","value":"이 기기에서 BrassTune의 모양을 선택하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha a aparência do BrassTune neste dispositivo."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите внешний вид BrassTune на этом устройстве."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn giao diện BrassTune trên thiết bị này."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择 BrassTune 在此设备上的外观。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇 BrassTune 在此裝置上的外觀。"}}}} ,
    "Color theme" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"سمة الألوان"}},"de":{"stringUnit":{"state":"translated","value":"Farbschema"}},"en":{"stringUnit":{"state":"translated","value":"Color theme"}},"es":{"stringUnit":{"state":"translated","value":"Tema de color"}},"fr":{"stringUnit":{"state":"translated","value":"Thème de couleurs"}},"ja":{"stringUnit":{"state":"translated","value":"カラーテーマ"}},"ko":{"stringUnit":{"state":"translated","value":"색상 테마"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tema de cores"}},"ru":{"stringUnit":{"state":"translated","value":"Цветовая тема"}},"vi":{"stringUnit":{"state":"translated","value":"Chủ đề màu sắc"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"颜色主题"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"色彩主題"}}}} ,
    "Dark" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"داكن"}},"de":{"stringUnit":{"state":"translated","value":"Dunkel"}},"en":{"stringUnit":{"state":"translated","value":"Dark"}},"es":{"stringUnit":{"state":"translated","value":"Oscuro"}},"fr":{"stringUnit":{"state":"translated","value":"Sombre"}},"ja":{"stringUnit":{"state":"translated","value":"ダーク"}},"ko":{"stringUnit":{"state":"translated","value":"어둡게"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escuro"}},"ru":{"stringUnit":{"state":"translated","value":"Тёмная"}},"vi":{"stringUnit":{"state":"translated","value":"Tối"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"深色"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"深色"}}}} ,
    "Decrease tempo by 1 BPM" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"خفّض السرعة بمقدار 1 BPM"}},"de":{"stringUnit":{"state":"translated","value":"Tempo um 1 BPM verringern"}},"en":{"stringUnit":{"state":"translated","value":"Decrease tempo by 1 BPM"}},"es":{"stringUnit":{"state":"translated","value":"Disminuir el tempo en 1 BPM"}},"fr":{"stringUnit":{"state":"translated","value":"Diminuer le tempo de 1 BPM"}},"ja":{"stringUnit":{"state":"translated","value":"テンポを1 BPM下げる"}},"ko":{"stringUnit":{"state":"translated","value":"템포를 1 BPM 낮추기"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Diminuir o andamento em 1 BPM"}},"ru":{"stringUnit":{"state":"translated","value":"Уменьшить темп на 1 BPM"}},"vi":{"stringUnit":{"state":"translated","value":"Giảm nhịp độ 1 BPM"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将速度降低 1 BPM"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將速度降低 1 BPM"}}}} ,
    "Enter the six-digit code from your teacher. Previously issued letter-and-number codes can still be pasted." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"أدخل الرمز المكوّن من ستة أرقام من معلمك. لا يزال بإمكانك لصق الرموز القديمة التي تحتوي على أحرف وأرقام."}},"de":{"stringUnit":{"state":"translated","value":"Gib den sechsstelligen Code deiner Lehrkraft ein. Frühere Buchstaben-Zahlen-Codes können weiterhin eingefügt werden."}},"en":{"stringUnit":{"state":"translated","value":"Enter the six-digit code from your teacher. Previously issued letter-and-number codes can still be pasted."}},"es":{"stringUnit":{"state":"translated","value":"Ingresa el código de seis dígitos de tu profesor. Aún puedes pegar códigos anteriores con letras y números."}},"fr":{"stringUnit":{"state":"translated","value":"Saisis le code à six chiffres de ton professeur. Les anciens codes avec lettres et chiffres peuvent toujours être collés."}},"ja":{"stringUnit":{"state":"translated","value":"先生から受け取った6桁のコードを入力してください。以前の英数字コードも貼り付けられます。"}},"ko":{"stringUnit":{"state":"translated","value":"선생님에게 받은 6자리 코드를 입력하세요. 이전 영문·숫자 코드도 붙여넣을 수 있습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Digite o código de seis dígitos do seu professor. Códigos antigos com letras e números ainda podem ser colados."}},"ru":{"stringUnit":{"state":"translated","value":"Введите шестизначный код от учителя. Ранее выданные буквенно-цифровые коды по-прежнему можно вставить."}},"vi":{"stringUnit":{"state":"translated","value":"Nhập mã sáu chữ số từ giáo viên. Bạn vẫn có thể dán các mã cũ gồm chữ và số."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"输入老师提供的 6 位代码。之前发放的字母数字代码仍可粘贴。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"輸入老師提供的 6 位代碼。先前發放的英數代碼仍可貼上。"}}}} ,
    "Equal temperament" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"التسوية المتساوية"}},"de":{"stringUnit":{"state":"translated","value":"Gleichstufige Stimmung"}},"en":{"stringUnit":{"state":"translated","value":"Equal temperament"}},"es":{"stringUnit":{"state":"translated","value":"Temperamento igual"}},"fr":{"stringUnit":{"state":"translated","value":"Tempérament égal"}},"ja":{"stringUnit":{"state":"translated","value":"平均律"}},"ko":{"stringUnit":{"state":"translated","value":"평균율"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Temperamento igual"}},"ru":{"stringUnit":{"state":"translated","value":"Равномерная темперация"}},"vi":{"stringUnit":{"state":"translated","value":"Bình quân luật"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"十二平均律"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"十二平均律"}}}} ,
    "Follow the notes" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"اتبع النغمات"}},"de":{"stringUnit":{"state":"translated","value":"Folge den Noten"}},"en":{"stringUnit":{"state":"translated","value":"Follow the notes"}},"es":{"stringUnit":{"state":"translated","value":"Sigue las notas"}},"fr":{"stringUnit":{"state":"translated","value":"Suis les notes"}},"ja":{"stringUnit":{"state":"translated","value":"音符に従う"}},"ko":{"stringUnit":{"state":"translated","value":"음표 따라가기"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Siga as notas"}},"ru":{"stringUnit":{"state":"translated","value":"Следуйте нотам"}},"vi":{"stringUnit":{"state":"translated","value":"Theo các nốt nhạc"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"跟随音符"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"跟隨音符"}}}} ,
    "Hear the written notes together, correctly transposed to concert pitch" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"استمع إلى النغمات المكتوبة معًا بعد نقلها بشكل صحيح إلى طبقة الحفل"}},"de":{"stringUnit":{"state":"translated","value":"Höre die geschriebenen Noten zusammen, korrekt in klingende Tonhöhe transponiert"}},"en":{"stringUnit":{"state":"translated","value":"Hear the written notes together, correctly transposed to concert pitch"}},"es":{"stringUnit":{"state":"translated","value":"Escucha juntas las notas escritas, transpuestas correctamente a tono de concierto"}},"fr":{"stringUnit":{"state":"translated","value":"Écoute les notes écrites ensemble, correctement transposées au diapason de concert"}},"ja":{"stringUnit":{"state":"translated","value":"記譜された音を、正しく実音に移調して一緒に聴きます"}},"ko":{"stringUnit":{"state":"translated","value":"기보된 음을 콘서트 피치로 정확히 이조하여 함께 들어 보세요"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ouça as notas escritas juntas, corretamente transpostas para o tom de concerto"}},"ru":{"stringUnit":{"state":"translated","value":"Слушайте записанные ноты вместе, правильно транспонированные в концертный строй"}},"vi":{"stringUnit":{"state":"translated","value":"Nghe các nốt viết cùng nhau, được chuyển giọng đúng sang cao độ hòa nhạc"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"聆听写出的音符，并正确移调到音乐会音高后同时播放"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"聆聽寫出的音符，並正確移調到音樂會音高後同時播放"}}}} ,
