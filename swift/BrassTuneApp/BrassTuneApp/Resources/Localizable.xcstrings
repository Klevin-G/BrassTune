    "You're practicing as a guest. Your data stays on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تتدرب كضيف. تبقى بياناتك على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du übst als Gast. Ihre Daten bleiben auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're practicing as a guest. Your data stays on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás practicando como invitado. Tus datos permanecen en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous continuez à vous entraîner en mode invité. Vos données restent sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストとして練習中です。データはこのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트로 연습 중이시군요. 귀하의 데이터는 이 장치에 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está praticando como convidado. Seus dados permanecem neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты тренируешься в качестве гостя. Ваши данные остаются на этом устройстве."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang tập làm khách. Dữ liệu của bạn vẫn còn trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你以客人的身份练习。您的数据保留在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你以客人的身份練習。您的資料保留在此裝置上。"
          }
        }
      }
    },
    "You're signed out. Your practice data is still on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد قمت بتسجيل الخروج. بيانات التدريب الخاصة بك لا تزال على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist abgemeldet. Ihre Übungsdaten befinden sich noch auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're signed out. Your practice data is still on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has cerrado sesión. Los datos de tu práctica todavía están en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes déconnecté. Vos données de pratique sont toujours sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトしました。あなたの練習データはまだこのデバイス上にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃되었습니다. 연습 데이터는 아직 이 기기에 남아 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está desconectado. Seus dados de prática ainda estão neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы вышли из системы. Данные о ваших тренировках все еще хранятся на этом устройстве."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đăng xuất. Dữ liệu luyện tập của bạn vẫn còn trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已退出。您的练习数据仍在该设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已退出。您的練習數據仍在該裝置上。"
          }
        }
      }
    },
    "Your %@ role cannot leave this class through self-service.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لدور %@ الخاص بك مغادرة هذا الفصل من خلال الخدمة الذاتية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre %@-Rolle kann diesen Kurs nicht über Self-Service verlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %@ role cannot leave this class through self-service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su función %@ no puede abandonar esta clase mediante el autoservicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rôle %@ ne peut pas quitter cette classe via le libre-service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ロールは、セルフサービスを通じてこのクラスを離れることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 %@ 역할은 셀프 서비스를 통해 이 클래스에서 나갈 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua função %@ não pode sair desta turma por meio do autoatendimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша роль %@ не может покинуть этот курс через самообслуживание."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai trò %@ của bạn không thể rời khỏi lớp này thông qua dịch vụ tự phục vụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 %@ 角色无法通过自助服务离开此班级。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 %@ 角色無法透過自助服務離開此班級。"
          }
        }
      }
    },
    "Your account, saved sign-in, practice history, and imported sheet music will be deleted. This can't be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف حسابك وتسجيل الدخول المحفوظ وسجل التدريب والنوتة الموسيقية المستوردة. لا يمكن التراجع عن هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Konto, Ihre gespeicherten Anmeldungen, Ihr Übungsverlauf und Ihre importierten Noten werden gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account, saved sign-in, practice history, and imported sheet music will be deleted. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán su cuenta, el inicio de sesión guardado, el historial de práctica y las partituras importadas. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte, votre connexion enregistrée, votre historique de pratique et vos partitions importées seront supprimés. Cela ne peut pas être annulé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント、保存されているサインイン、練習履歴、インポートされた楽譜が削除されます。これを元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 계정, 저장된 로그인, 연습 내역 및 가져온 악보가 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta, login salvo, histórico de prática e partituras importadas serão excluídos. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша учетная запись, сохраненные данные входа, история тренировок и импортированные ноты будут удалены. Это невозможно отменить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản của bạn, thông tin đăng nhập đã lưu, lịch sử luyện tập và bản nhạc đã nhập sẽ bị xóa. Không thể hoàn tác việc này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的帐户、保存的登录、练习历史记录和导入的乐谱将被删除。这无法撤消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的帳戶、已儲存的登入、練習歷史記錄和匯入的樂譜將被刪除。這無法撤消。"
          }
        }
      }
    },
    "Your audio output changed. Check your headphones or speaker before continuing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد تغير إخراج الصوت الخاص بك. تحقق من سماعات الرأس أو مكبر الصوت قبل المتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Audioausgabe hat sich geändert. Überprüfen Sie Ihre Kopfhörer oder Lautsprecher, bevor Sie fortfahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your audio output changed. Check your headphones or speaker before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su salida de audio cambió. Revisa tus auriculares o altavoz antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre sortie audio a changé. Vérifiez vos écouteurs ou votre haut-parleur avant de continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオ出力が変更されました。続行する前に、ヘッドフォンまたはスピーカーを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 출력이 변경되었습니다. 계속하기 전에 헤드폰이나 스피커를 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua saída de áudio foi alterada. Verifique seus fones de ouvido ou alto-falante antes de continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш аудиовыход изменился. Прежде чем продолжить, проверьте наушники или динамик."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đầu ra âm thanh của bạn đã thay đổi. Kiểm tra tai nghe hoặc loa của bạn trước khi tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的音频输出已更改。在继续之前检查您的耳机或扬声器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的音訊輸出已更改。在繼續之前檢查您的耳機或揚聲器。"
          }
        }
      }
    },
