    } },
    "Microphone access is off. Allow it in Settings, then try again." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"الوصول إلى الميكروفون متوقف. اسمح به في الإعدادات ثم حاول مجددًا."}},"de":{"stringUnit":{"state":"translated","value":"Der Mikrofonzugriff ist aus. Erlaube ihn in den Einstellungen und versuche es erneut."}},"en":{"stringUnit":{"state":"translated","value":"Microphone access is off. Allow it in Settings, then try again."}},"es":{"stringUnit":{"state":"translated","value":"El acceso al micrófono está desactivado. Permítelo en Ajustes e inténtalo de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"L’accès au microphone est désactivé. Autorisez-le dans Réglages, puis réessayez."}},"ja":{"stringUnit":{"state":"translated","value":"マイクへのアクセスがオフです。設定で許可して、もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"마이크 접근이 꺼져 있습니다. 설정에서 허용한 후 다시 시도하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O acesso ao microfone está desativado. Permita-o nos Ajustes e tente novamente."}},"ru":{"stringUnit":{"state":"translated","value":"Доступ к микрофону выключен. Разрешите его в Настройках и повторите попытку."}},"vi":{"stringUnit":{"state":"translated","value":"Quyền truy cập micrô đang tắt. Hãy cho phép trong Cài đặt rồi thử lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"麦克风访问已关闭。请在“设置”中允许，然后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"麥克風存取已關閉。請在「設定」中允許，然後重試。"}}
    } },
    "The account service is unavailable right now." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"خدمة الحساب غير متاحة الآن."}},"de":{"stringUnit":{"state":"translated","value":"Der Kontodienst ist derzeit nicht verfügbar."}},"en":{"stringUnit":{"state":"translated","value":"The account service is unavailable right now."}},"es":{"stringUnit":{"state":"translated","value":"El servicio de cuentas no está disponible ahora."}},"fr":{"stringUnit":{"state":"translated","value":"Le service de compte est indisponible pour le moment."}},"ja":{"stringUnit":{"state":"translated","value":"現在アカウントサービスを利用できません。"}},"ko":{"stringUnit":{"state":"translated","value":"현재 계정 서비스를 사용할 수 없습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O serviço de conta está indisponível no momento."}},"ru":{"stringUnit":{"state":"translated","value":"Служба учетных записей сейчас недоступна."}},"vi":{"stringUnit":{"state":"translated","value":"Dịch vụ tài khoản hiện không khả dụng."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账户服务目前不可用。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"帳戶服務目前無法使用。"}}
    } },
    "The account service returned an unreadable response." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"أعادت خدمة الحساب استجابة غير قابلة للقراءة."}},"de":{"stringUnit":{"state":"translated","value":"Der Kontodienst hat eine unlesbare Antwort gesendet."}},"en":{"stringUnit":{"state":"translated","value":"The account service returned an unreadable response."}},"es":{"stringUnit":{"state":"translated","value":"El servicio de cuentas devolvió una respuesta ilegible."}},"fr":{"stringUnit":{"state":"translated","value":"Le service de compte a renvoyé une réponse illisible."}},"ja":{"stringUnit":{"state":"translated","value":"アカウントサービスから読み取れない応答が返されました。"}},"ko":{"stringUnit":{"state":"translated","value":"계정 서비스가 읽을 수 없는 응답을 반환했습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O serviço de conta retornou uma resposta ilegível."}},"ru":{"stringUnit":{"state":"translated","value":"Служба учетных записей вернула нечитаемый ответ."}},"vi":{"stringUnit":{"state":"translated","value":"Dịch vụ tài khoản trả về phản hồi không đọc được."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账户服务返回了无法读取的响应。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"帳戶服務傳回無法讀取的回應。"}}
    } },
    "The request timed out." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"انتهت مهلة الطلب."}},"de":{"stringUnit":{"state":"translated","value":"Die Anfrage hat zu lange gedauert."}},"en":{"stringUnit":{"state":"translated","value":"The request timed out."}},"es":{"stringUnit":{"state":"translated","value":"La solicitud agotó el tiempo de espera."}},"fr":{"stringUnit":{"state":"translated","value":"La demande a expiré."}},"ja":{"stringUnit":{"state":"translated","value":"リクエストがタイムアウトしました。"}},"ko":{"stringUnit":{"state":"translated","value":"요청 시간이 초과되었습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"A solicitação expirou."}},"ru":{"stringUnit":{"state":"translated","value":"Время ожидания запроса истекло."}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu đã hết thời gian chờ."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请求超时。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"要求逾時。"}}
    } },
    "Apple sign-in was cancelled." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"تم إلغاء تسجيل الدخول عبر Apple."}},"de":{"stringUnit":{"state":"translated","value":"Die Apple-Anmeldung wurde abgebrochen."}},"en":{"stringUnit":{"state":"translated","value":"Apple sign-in was cancelled."}},"es":{"stringUnit":{"state":"translated","value":"Se canceló el inicio de sesión con Apple."}},"fr":{"stringUnit":{"state":"translated","value":"La connexion avec Apple a été annulée."}},"ja":{"stringUnit":{"state":"translated","value":"Appleでのサインインがキャンセルされました。"}},"ko":{"stringUnit":{"state":"translated","value":"Apple 로그인이 취소되었습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O início de sessão com a Apple foi cancelado."}},"ru":{"stringUnit":{"state":"translated","value":"Вход через Apple отменен."}},"vi":{"stringUnit":{"state":"translated","value":"Đăng nhập bằng Apple đã bị hủy."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已取消使用 Apple 登录。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已取消使用 Apple 登入。"}}
    } },
    "Please confirm deletion and try again." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"يرجى تأكيد الحذف والمحاولة مجددًا."}},"de":{"stringUnit":{"state":"translated","value":"Bestätige das Löschen und versuche es erneut."}},"en":{"stringUnit":{"state":"translated","value":"Please confirm deletion and try again."}},"es":{"stringUnit":{"state":"translated","value":"Confirma la eliminación e inténtalo de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"Confirmez la suppression, puis réessayez."}},"ja":{"stringUnit":{"state":"translated","value":"削除を確認して、もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"삭제를 확인한 후 다시 시도하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Confirme a exclusão e tente novamente."}},"ru":{"stringUnit":{"state":"translated","value":"Подтвердите удаление и повторите попытку."}},"vi":{"stringUnit":{"state":"translated","value":"Hãy xác nhận xóa rồi thử lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请确认删除，然后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請確認刪除，然後重試。"}}
    } },
    "Account sign-in isn't available right now. You can keep practicing as a guest." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"تسجيل الدخول إلى الحساب غير متاح الآن. يمكنك مواصلة التدريب كضيف."}},"de":{"stringUnit":{"state":"translated","value":"Die Kontoanmeldung ist derzeit nicht verfügbar. Du kannst als Gast weiterüben."}},"en":{"stringUnit":{"state":"translated","value":"Account sign-in isn't available right now. You can keep practicing as a guest."}},"es":{"stringUnit":{"state":"translated","value":"El inicio de sesión no está disponible ahora. Puedes seguir practicando como invitado."}},"fr":{"stringUnit":{"state":"translated","value":"La connexion au compte est indisponible. Vous pouvez continuer à travailler en tant qu’invité."}},"ja":{"stringUnit":{"state":"translated","value":"現在アカウントにサインインできません。ゲストとして練習を続けられます。"}},"ko":{"stringUnit":{"state":"translated","value":"현재 계정 로그인을 사용할 수 없습니다. 게스트로 계속 연습할 수 있습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O login da conta não está disponível agora. Você pode continuar praticando como visitante."}},"ru":{"stringUnit":{"state":"translated","value":"Вход в аккаунт сейчас недоступен. Можно продолжить занятия как гость."}},"vi":{"stringUnit":{"state":"translated","value":"Hiện không thể đăng nhập tài khoản. Bạn vẫn có thể luyện tập với tư cách khách."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账户登录目前不可用。你可以继续以访客身份练习。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"帳戶登入目前無法使用。你可以繼續以訪客身分練習。"}}
    } },
    "BrassTune could not complete authentication." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"تعذر على BrassTune إكمال المصادقة."}},"de":{"stringUnit":{"state":"translated","value":"BrassTune konnte die Anmeldung nicht abschließen."}},"en":{"stringUnit":{"state":"translated","value":"BrassTune could not complete authentication."}},"es":{"stringUnit":{"state":"translated","value":"BrassTune no pudo completar la autenticación."}},"fr":{"stringUnit":{"state":"translated","value":"BrassTune n’a pas pu terminer l’authentification."}},"ja":{"stringUnit":{"state":"translated","value":"BrassTuneは認証を完了できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"BrassTune에서 인증을 완료하지 못했습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O BrassTune não conseguiu concluir a autenticação."}},"ru":{"stringUnit":{"state":"translated","value":"BrassTune не удалось завершить аутентификацию."}},"vi":{"stringUnit":{"state":"translated","value":"BrassTune không thể hoàn tất xác thực."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"BrassTune 无法完成身份验证。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"BrassTune 無法完成身分驗證。"}}
    } },
    "BrassTune couldn't securely save your sign-in on this device. Check device storage and try again." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"تعذر على BrassTune حفظ تسجيل الدخول بأمان على هذا الجهاز. تحقق من مساحة التخزين وحاول مجددًا."}},"de":{"stringUnit":{"state":"translated","value":"BrassTune konnte deine Anmeldung nicht sicher speichern. Prüfe den Gerätespeicher und versuche es erneut."}},"en":{"stringUnit":{"state":"translated","value":"BrassTune couldn't securely save your sign-in on this device. Check device storage and try again."}},"es":{"stringUnit":{"state":"translated","value":"BrassTune no pudo guardar el inicio de sesión de forma segura. Revisa el almacenamiento e inténtalo de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"BrassTune n’a pas pu enregistrer votre connexion en sécurité. Vérifiez le stockage, puis réessayez."}},"ja":{"stringUnit":{"state":"translated","value":"このデバイスにサインイン情報を安全に保存できませんでした。ストレージを確認して再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 기기에 로그인을 안전하게 저장하지 못했습니다. 저장 공간을 확인하고 다시 시도하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O BrassTune não conseguiu salvar seu login com segurança. Verifique o armazenamento e tente novamente."}},"ru":{"stringUnit":{"state":"translated","value":"BrassTune не удалось безопасно сохранить вход на устройстве. Проверьте хранилище и повторите попытку."}},"vi":{"stringUnit":{"state":"translated","value":"BrassTune không thể lưu đăng nhập an toàn trên thiết bị. Hãy kiểm tra bộ nhớ rồi thử lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"BrassTune 无法在此设备上安全保存登录信息。请检查存储空间并重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"BrassTune 無法在此裝置上安全儲存登入資訊。請檢查儲存空間並重試。"}}
    } },
    "Check your email to confirm this BrassTune account before signing in." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"تحقق من بريدك الإلكتروني لتأكيد حساب BrassTune قبل تسجيل الدخول."}},"de":{"stringUnit":{"state":"translated","value":"Bestätige dein BrassTune-Konto per E-Mail, bevor du dich anmeldest."}},"en":{"stringUnit":{"state":"translated","value":"Check your email to confirm this BrassTune account before signing in."}},"es":{"stringUnit":{"state":"translated","value":"Revisa tu correo para confirmar esta cuenta de BrassTune antes de iniciar sesión."}},"fr":{"stringUnit":{"state":"translated","value":"Consultez votre e-mail pour confirmer ce compte BrassTune avant de vous connecter."}},"ja":{"stringUnit":{"state":"translated","value":"サインインする前にメールを確認してBrassTuneアカウントを認証してください。"}},"ko":{"stringUnit":{"state":"translated","value":"로그인하기 전에 이메일에서 BrassTune 계정을 확인하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Confira seu e-mail para confirmar a conta do BrassTune antes de entrar."}},"ru":{"stringUnit":{"state":"translated","value":"Перед входом подтвердите аккаунт BrassTune по электронной почте."}},"vi":{"stringUnit":{"state":"translated","value":"Hãy kiểm tra email để xác nhận tài khoản BrassTune trước khi đăng nhập."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"登录前请检查电子邮件以确认此 BrassTune 账户。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"登入前請檢查電子郵件以確認此 BrassTune 帳戶。"}}
    } },
    "BrassTune could not hear the microphone. Check your audio input and try again." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"تعذر على BrassTune سماع الميكروفون. تحقق من إدخال الصوت وحاول مجددًا."}},"de":{"stringUnit":{"state":"translated","value":"BrassTune konnte das Mikrofon nicht hören. Prüfe den Audioeingang und versuche es erneut."}},"en":{"stringUnit":{"state":"translated","value":"BrassTune could not hear the microphone. Check your audio input and try again."}},"es":{"stringUnit":{"state":"translated","value":"BrassTune no pudo oír el micrófono. Revisa la entrada de audio e inténtalo de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"BrassTune n’entend pas le microphone. Vérifiez l’entrée audio, puis réessayez."}},"ja":{"stringUnit":{"state":"translated","value":"マイクの音を検出できませんでした。音声入力を確認して再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"BrassTune에서 마이크 소리를 들을 수 없습니다. 오디오 입력을 확인하고 다시 시도하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O BrassTune não ouviu o microfone. Verifique a entrada de áudio e tente novamente."}},"ru":{"stringUnit":{"state":"translated","value":"BrassTune не слышит микрофон. Проверьте аудиовход и повторите попытку."}},"vi":{"stringUnit":{"state":"translated","value":"BrassTune không nghe thấy micrô. Hãy kiểm tra đầu vào âm thanh rồi thử lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"BrassTune 未检测到麦克风声音。请检查音频输入并重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"BrassTune 未偵測到麥克風聲音。請檢查音訊輸入並重試。"}}
    } },
    "BrassTune can import PDF, JPEG, PNG, and HEIC score files." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"يمكن لـ BrassTune استيراد ملفات النوتة PDF وJPEG وPNG وHEIC."}},"de":{"stringUnit":{"state":"translated","value":"BrassTune kann Notendateien als PDF, JPEG, PNG und HEIC importieren."}},"en":{"stringUnit":{"state":"translated","value":"BrassTune can import PDF, JPEG, PNG, and HEIC score files."}},"es":{"stringUnit":{"state":"translated","value":"BrassTune puede importar partituras PDF, JPEG, PNG y HEIC."}},"fr":{"stringUnit":{"state":"translated","value":"BrassTune peut importer des partitions PDF, JPEG, PNG et HEIC."}},"ja":{"stringUnit":{"state":"translated","value":"BrassTuneはPDF、JPEG、PNG、HEICの楽譜ファイルを読み込めます。"}},"ko":{"stringUnit":{"state":"translated","value":"BrassTune은 PDF, JPEG, PNG 및 HEIC 악보 파일을 가져올 수 있습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O BrassTune pode importar partituras em PDF, JPEG, PNG e HEIC."}},"ru":{"stringUnit":{"state":"translated","value":"BrassTune может импортировать партитуры PDF, JPEG, PNG и HEIC."}},"vi":{"stringUnit":{"state":"translated","value":"BrassTune có thể nhập bản nhạc PDF, JPEG, PNG và HEIC."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"BrassTune 可导入 PDF、JPEG、PNG 和 HEIC 乐谱文件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"BrassTune 可匯入 PDF、JPEG、PNG 和 HEIC 樂譜檔案。"}}
    } },
    "BrassTune could not read that score file." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"تعذر على BrassTune قراءة ملف النوتة هذا."}},"de":{"stringUnit":{"state":"translated","value":"BrassTune konnte diese Notendatei nicht lesen."}},"en":{"stringUnit":{"state":"translated","value":"BrassTune could not read that score file."}},"es":{"stringUnit":{"state":"translated","value":"BrassTune no pudo leer esa partitura."}},"fr":{"stringUnit":{"state":"translated","value":"BrassTune n’a pas pu lire cette partition."}},"ja":{"stringUnit":{"state":"translated","value":"その楽譜ファイルを読み取れませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"해당 악보 파일을 읽을 수 없습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O BrassTune não conseguiu ler essa partitura."}},"ru":{"stringUnit":{"state":"translated","value":"BrassTune не удалось прочитать эту партитуру."}},"vi":{"stringUnit":{"state":"translated","value":"BrassTune không thể đọc tệp bản nhạc đó."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"BrassTune 无法读取该乐谱文件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"BrassTune 無法讀取該樂譜檔案。"}}
    } },
    "This file is too large to import." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"هذا الملف كبير جدًا ولا يمكن استيراده."}},"de":{"stringUnit":{"state":"translated","value":"Diese Datei ist zu groß zum Importieren."}},"en":{"stringUnit":{"state":"translated","value":"This file is too large to import."}},"es":{"stringUnit":{"state":"translated","value":"Este archivo es demasiado grande para importarlo."}},"fr":{"stringUnit":{"state":"translated","value":"Ce fichier est trop volumineux pour être importé."}},"ja":{"stringUnit":{"state":"translated","value":"ファイルが大きすぎて読み込めません。"}},"ko":{"stringUnit":{"state":"translated","value":"파일이 너무 커서 가져올 수 없습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este arquivo é grande demais para importar."}},"ru":{"stringUnit":{"state":"translated","value":"Файл слишком велик для импорта."}},"vi":{"stringUnit":{"state":"translated","value":"Tệp này quá lớn để nhập."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此文件太大，无法导入。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此檔案太大，無法匯入。"}}
    } },
    "This PDF has more than %lld pages. Split it into smaller files before importing." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"يحتوي ملف PDF على أكثر من %lld صفحة. قسّمه إلى ملفات أصغر قبل الاستيراد."}},"de":{"stringUnit":{"state":"translated","value":"Dieses PDF hat mehr als %lld Seiten. Teile es vor dem Import in kleinere Dateien."}},"en":{"stringUnit":{"state":"translated","value":"This PDF has more than %lld pages. Split it into smaller files before importing."}},"es":{"stringUnit":{"state":"translated","value":"Este PDF tiene más de %lld páginas. Divídelo en archivos más pequeños antes de importarlo."}},"fr":{"stringUnit":{"state":"translated","value":"Ce PDF contient plus de %lld pages. Divisez-le en fichiers plus petits avant l’importation."}},"ja":{"stringUnit":{"state":"translated","value":"このPDFは%lldページを超えています。読み込む前に小さいファイルに分割してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 PDF는 %lld페이지를 초과합니다. 가져오기 전에 더 작은 파일로 나누세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este PDF tem mais de %lld páginas. Divida-o em arquivos menores antes de importar."}},"ru":{"stringUnit":{"state":"translated","value":"В PDF больше %lld страниц. Перед импортом разделите его на меньшие файлы."}},"vi":{"stringUnit":{"state":"translated","value":"PDF này có hơn %lld trang. Hãy chia thành các tệp nhỏ hơn trước khi nhập."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此 PDF 超过 %lld 页。请在导入前拆分为较小的文件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此 PDF 超過 %lld 頁。請在匯入前拆分為較小的檔案。"}}
    } },
    "No score pages were found in that file." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"لم يتم العثور على صفحات نوتة في هذا الملف."}},"de":{"stringUnit":{"state":"translated","value":"In dieser Datei wurden keine Notenseiten gefunden."}},"en":{"stringUnit":{"state":"translated","value":"No score pages were found in that file."}},"es":{"stringUnit":{"state":"translated","value":"No se encontraron páginas de partitura en ese archivo."}},"fr":{"stringUnit":{"state":"translated","value":"Aucune page de partition n’a été trouvée dans ce fichier."}},"ja":{"stringUnit":{"state":"translated","value":"ファイルに楽譜ページが見つかりませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"파일에서 악보 페이지를 찾을 수 없습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhuma página de partitura foi encontrada nesse arquivo."}},"ru":{"stringUnit":{"state":"translated","value":"В файле не найдено страниц партитуры."}},"vi":{"stringUnit":{"state":"translated","value":"Không tìm thấy trang bản nhạc nào trong tệp."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该文件中未找到乐谱页面。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"該檔案中找不到樂譜頁面。"}}
    } },
    "Settings" : { "localizations" : {
      "ar" : { "stringUnit" : { "state" : "translated", "value" : "الإعدادات" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Einstellungen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Settings" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ajustes" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réglages" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "設定" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "설정" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ajustes" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Настройки" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Cài đặt" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "設定" } }
    } },
    "Online accounts aren't configured in this build. You can still practice as a guest, and your data stays on this device." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"الحسابات عبر الإنترنت غير مهيأة في هذا الإصدار. لا يزال بإمكانك التدريب كضيف، وتبقى بياناتك على هذا الجهاز."}},"de":{"stringUnit":{"state":"translated","value":"Online-Konten sind in diesem Build nicht eingerichtet. Du kannst als Gast üben; deine Daten bleiben auf diesem Gerät."}},"en":{"stringUnit":{"state":"translated","value":"Online accounts aren't configured in this build. You can still practice as a guest, and your data stays on this device."}},"es":{"stringUnit":{"state":"translated","value":"Las cuentas en línea no están configuradas en esta versión. Puedes practicar como invitado; tus datos permanecen en este dispositivo."}},"fr":{"stringUnit":{"state":"translated","value":"Les comptes en ligne ne sont pas configurés dans cette version. Vous pouvez travailler en tant qu’invité; vos données restent sur cet appareil."}},"ja":{"stringUnit":{"state":"translated","value":"このビルドではオンラインアカウントが設定されていません。ゲストとして練習でき、データはこのデバイスに残ります。"}},"ko":{"stringUnit":{"state":"translated","value":"이 빌드에는 온라인 계정이 구성되어 있지 않습니다. 게스트로 연습할 수 있으며 데이터는 이 기기에 유지됩니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"As contas on-line não estão configuradas nesta versão. Você pode praticar como visitante; seus dados ficam neste dispositivo."}},"ru":{"stringUnit":{"state":"translated","value":"Онлайн-аккаунты не настроены в этой сборке. Можно заниматься как гость; данные останутся на этом устройстве."}},"vi":{"stringUnit":{"state":"translated","value":"Tài khoản trực tuyến chưa được cấu hình trong bản dựng này. Bạn vẫn có thể luyện tập với tư cách khách; dữ liệu ở lại thiết bị."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此版本未配置在线账户。你仍可作为访客练习，数据会保留在此设备上。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此版本未設定線上帳戶。你仍可作為訪客練習，資料會保留在此裝置上。"}}
    } },
    "You're offline. BrassTune kept your unexpired sign-in for local practice; online account features may be unavailable." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"أنت غير متصل. احتفظ BrassTune بتسجيل دخولك غير المنتهي للتدريب المحلي؛ قد لا تتوفر ميزات الحساب عبر الإنترنت."}},"de":{"stringUnit":{"state":"translated","value":"Du bist offline. BrassTune behält deine noch gültige Anmeldung für lokales Üben; Online-Kontofunktionen sind eventuell nicht verfügbar."}},"en":{"stringUnit":{"state":"translated","value":"You're offline. BrassTune kept your unexpired sign-in for local practice; online account features may be unavailable."}},"es":{"stringUnit":{"state":"translated","value":"No tienes conexión. BrassTune conservó tu sesión vigente para la práctica local; las funciones en línea pueden no estar disponibles."}},"fr":{"stringUnit":{"state":"translated","value":"Vous êtes hors ligne. BrassTune a conservé votre connexion valide pour le travail local; les fonctions en ligne peuvent être indisponibles."}},"ja":{"stringUnit":{"state":"translated","value":"オフラインです。ローカル練習のため有効なサインインを保持しました。オンライン機能は利用できない場合があります。"}},"ko":{"stringUnit":{"state":"translated","value":"오프라인입니다. 로컬 연습을 위해 만료되지 않은 로그인을 유지했으며 온라인 계정 기능은 사용할 수 없을 수 있습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Você está off-line. O BrassTune manteve seu login válido para prática local; os recursos on-line podem estar indisponíveis."}},"ru":{"stringUnit":{"state":"translated","value":"Нет подключения. BrassTune сохранил действующий вход для локальных занятий; онлайн-функции могут быть недоступны."}},"vi":{"stringUnit":{"state":"translated","value":"Bạn đang ngoại tuyến. BrassTune giữ đăng nhập còn hiệu lực để luyện tập cục bộ; tính năng trực tuyến có thể không khả dụng."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你当前离线。BrassTune 保留了尚未过期的登录以供本地练习；在线账户功能可能不可用。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"你目前離線。BrassTune 保留了尚未過期的登入以供本機練習；線上帳戶功能可能無法使用。"}}
    } },
    "BrassTune couldn't save your latest changes on this device. Keep the app open, export your data if needed, and try again." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"تعذر على BrassTune حفظ أحدث تغييراتك على هذا الجهاز. اترك التطبيق مفتوحًا، وصدّر بياناتك عند الحاجة، وحاول مجددًا."}},"de":{"stringUnit":{"state":"translated","value":"BrassTune konnte deine letzten Änderungen nicht speichern. Lass die App geöffnet, exportiere deine Daten bei Bedarf und versuche es erneut."}},"en":{"stringUnit":{"state":"translated","value":"BrassTune couldn't save your latest changes on this device. Keep the app open, export your data if needed, and try again."}},"es":{"stringUnit":{"state":"translated","value":"BrassTune no pudo guardar los últimos cambios. Mantén la app abierta, exporta tus datos si es necesario e inténtalo de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"BrassTune n’a pas pu enregistrer vos dernières modifications. Gardez l’app ouverte, exportez vos données si nécessaire, puis réessayez."}},"ja":{"stringUnit":{"state":"translated","value":"最新の変更をこのデバイスに保存できませんでした。アプリを開いたままにし、必要ならデータを書き出して再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"최신 변경 사항을 이 기기에 저장하지 못했습니다. 앱을 열어 두고 필요하면 데이터를 내보낸 후 다시 시도하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O BrassTune não conseguiu salvar as alterações mais recentes. Mantenha o app aberto, exporte os dados se necessário e tente novamente."}},"ru":{"stringUnit":{"state":"translated","value":"BrassTune не удалось сохранить последние изменения. Оставьте приложение открытым, при необходимости экспортируйте данные и повторите попытку."}},"vi":{"stringUnit":{"state":"translated","value":"BrassTune không thể lưu thay đổi mới nhất. Hãy giữ ứng dụng mở, xuất dữ liệu nếu cần rồi thử lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"BrassTune 无法在此设备上保存最新更改。请保持应用打开，必要时导出数据，然后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"BrassTune 無法在此裝置上儲存最新變更。請保持 App 開啟，必要時匯出資料，然後重試。"}}
    } },
