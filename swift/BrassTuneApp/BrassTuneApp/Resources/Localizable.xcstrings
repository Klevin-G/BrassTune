    "This instrument doesn't have a verified written-to-concert transposition, so BrassTune did not play a tone." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتوفر لهذه الآلة الموسيقية إحالة موثقة من الطبقة المكتوبة إلى طبقة الكونسيرت، لذلك لم يشغّل BrassTune نغمة مرجعية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Instrument gibt es keine verifizierte Transposition von notierter zu klingender Tonhöhe, daher hat BrassTune keinen Referenzton gespielt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This instrument doesn't have a verified written-to-concert transposition, so BrassTune did not play a tone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este instrumento no tiene una transposición escrita a concierto verificada, por lo que BrassTune no tocó ningún tono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet instrument n'a pas de transposition écrite-concert vérifiée, donc BrassTune n'a pas joué de son."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この楽器には検証済みのコンサート用移調機能がないため、BrassTune はトーンを再生しませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 악기는 기보 음정에서 실음으로의 검증된 조옮김 정보가 없어 BrassTune이 기준음을 재생하지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este instrumento não possui uma transposição verificada escrita para o concerto, então o BrassTune não tocou nenhum tom."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этого инструмента нет проверенной транспозиции от записанной к концертной высоте, поэтому BrassTune не воспроизводил эталонный тон."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhạc cụ này chưa có phép chuyển được xác minh từ cao độ viết sang cao độ hòa nhạc, nên BrassTune không phát âm tham chiếu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此乐器没有经过验证的记谱音高到实音音高移调关系，因此 BrassTune 未播放参考音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此樂器沒有經過驗證的記譜音高到實音音高移調關係，因此 BrassTune 未播放參考音。"
          }
        }
      }
