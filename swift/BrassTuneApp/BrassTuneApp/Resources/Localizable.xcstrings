    "You don't have permission to do that.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لديك إذن للقيام بذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dazu haben Sie keine Erlaubnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to do that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes permiso para hacer eso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez pas la permission de faire ça."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたにはそれをする許可がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신에게는 그렇게 할 권한이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não tem permissão para fazer isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас нет разрешения на это."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn không có quyền làm điều đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您无权这样做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您無權這樣做。"
          }
        }
      }
    },
    "You're offline. BrassTune kept your unexpired sign-in for local practice; online account features may be unavailable.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل. احتفظ BrassTune بتسجيل دخولك غير المنتهي للتدريب المحلي؛ قد لا تتوفر ميزات الحساب عبر الإنترنت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. BrassTune behält deine noch gültige Anmeldung für lokales Üben; Online-Kontofunktionen sind eventuell nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. BrassTune kept your unexpired sign-in for local practice; online account features may be unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes conexión. BrassTune conservó tu sesión vigente para la práctica local; las funciones en línea pueden no estar disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. BrassTune a conservé votre connexion valide pour le travail local; les fonctions en ligne peuvent être indisponibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。ローカル練習のため有効なサインインを保持しました。オンライン機能は利用できない場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인입니다. 로컬 연습을 위해 만료되지 않은 로그인을 유지했으며 온라인 계정 기능은 사용할 수 없을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está off-line. O BrassTune manteve seu login válido para prática local; os recursos on-line podem estar indisponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения. BrassTune сохранил действующий вход для локальных занятий; онлайн-функции могут быть недоступны."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ngoại tuyến. BrassTune giữ đăng nhập còn hiệu lực để luyện tập cục bộ; tính năng trực tuyến có thể không khả dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你当前离线。BrassTune 保留了尚未过期的登录以供本地练习；在线账户功能可能不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前離線。BrassTune 保留了尚未過期的登入以供本機練習；線上帳戶功能可能無法使用。"
          }
        }
      }
    },
