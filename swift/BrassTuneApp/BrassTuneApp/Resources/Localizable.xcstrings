    "Take relaxed four-count breaths." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خذ أنفاسًا مسترخية من أربع عدات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmen Sie entspannt über vier Schläge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take relaxed four-count breaths."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respira de forma relajada durante cuatro tiempos."
          }
        },
