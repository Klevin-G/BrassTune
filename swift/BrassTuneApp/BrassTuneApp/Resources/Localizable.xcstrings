    "You can keep this warm-up paused and resume it later, or discard its progress." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك إيقاف عملية الإحماء هذه مؤقتًا واستئنافها لاحقًا، أو تجاهل تقدمها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können das Aufwärmen anhalten und später fortsetzen oder den Fortschritt verwerfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can keep this warm-up paused and resume it later, or discard its progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes mantener este calentamiento en pausa y reanudarlo más tarde, o descartar su progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez laisser cet échauffement en pause et le reprendre plus tard, ou abandonner sa progression."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウォームアップを一時停止したままにして後で再開することも、進行状況を破棄することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 워밍업을 일시 중지하고 나중에 다시 시작하거나 진행 상황을 취소할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode manter esse aquecimento pausado e retomá-lo mais tarde ou descartar seu progresso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете приостановить разминку и возобновить ее позже или отменить ее ход."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể tạm dừng quá trình khởi động này và tiếp tục lại sau hoặc loại bỏ tiến trình của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以暂停此预热并稍后恢复，或放弃其进度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以暫停此預熱並稍後恢復，或放棄其進度。"
          }
        }
      }
    },
    "You can start as a guest and choose to sign in later." : {
      "localizations" : {
