    "Warm up, tune, practice scales, and see your progress in one calm place." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بالإحماء والضبط والتمرين على المقاييس وشاهد تقدمك في مكان واحد هادئ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wärmen Sie sich auf, stimmen Sie, üben Sie Tonleitern und beobachten Sie Ihre Fortschritte an einem ruhigen Ort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm up, tune, practice scales, and see your progress in one calm place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calienta, afina, practica escalas y observa tu progreso en un lugar tranquilo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échauffez-vous, accordez-vous, pratiquez les gammes et observez vos progrès dans un endroit calme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォーミングアップ、チューニング、スケールの練習を、1 か所の静かな場所で行い、上達を確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차분한 한 곳에서 몸을 풀고, 조정하고, 체중계를 연습하고 진행 상황을 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqueça, afine, pratique escalas e veja seu progresso em um lugar calmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разогревайтесь, настраивайтесь, практикуйте гаммы и наблюдайте за своим прогрессом в одном спокойном месте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khởi động, điều chỉnh, luyện thang âm và theo dõi sự tiến bộ của bạn ở một nơi yên tĩnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一个安静的地方热身、调音、练习音阶并查看您的进步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一個安靜的地方熱身、調音、練習音階並查看您的進步。"
          }
        }
      }
    },
