          }
        }
      }
    },
    "A relaxed, resumable routine. Pause whenever you need to.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "روتين مريح وقابل للاستئناف. توقف مؤقتًا عندما تحتاج إلى ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine entspannte, fortsetzbare Routine. Machen Sie eine Pause, wann immer Sie es brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A relaxed, resumable routine. Pause whenever you need to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una rutina relajada y retomable. Haz una pausa cuando lo necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une routine détendue et reprise. Faites une pause chaque fois que vous en avez besoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リラックスした再開可能なルーチン。必要に応じていつでも一時停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편안하고 재개 가능한 루틴입니다. 필요할 때마다 일시 중지하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma rotina descontraída e retomável. Faça uma pausa sempre que precisar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расслабленная, возобновляемая рутина. Делайте паузу всякий раз, когда вам нужно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thói quen thoải mái, có thể tiếp tục. Tạm dừng bất cứ khi nào bạn cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻松、可恢复的日常活动。需要时就暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕鬆、可恢復的日常活動。需要時就暫停。"
          }
        }
      }
    },
    "A short drone and interval routine with no network required.": {
