    "Tell them what you were doing, which screen you were on, and about when the problem happened." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخبرهم بما كنت تفعله والشاشة التي كنت عليها والوقت التقريبي لحدوث المشكلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilen Sie mit, was Sie getan haben, auf welchem Bildschirm Sie waren und ungefähr wann das Problem auftrat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell them what you were doing, which screen you were on, and about when the problem happened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indícales qué estabas haciendo, en qué pantalla estabas y aproximadamente cuándo ocurrió el problema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez ce que vous faisiez, l’écran affiché et l’heure approximative à laquelle le problème est survenu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行っていた操作、表示していた画面、問題が起きたおおよその時刻を伝えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇을 하고 있었는지, 어느 화면이었는지, 문제가 대략 언제 발생했는지 알려 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe o que você estava fazendo, em qual tela estava e aproximadamente quando o problema aconteceu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщите, что вы делали, на каком экране находились и примерно когда возникла проблема."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy cho họ biết bạn đang làm gì, đang ở màn hình nào và sự cố xảy ra vào khoảng thời gian nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请告诉他们你当时在做什么、处于哪个界面，以及问题大约何时发生。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請告訴他們你當時在做什麼、處於哪個畫面，以及問題大約何時發生。"
          }
        }
      }
    },
