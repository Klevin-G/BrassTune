    "%@ isn't a supported note name. Use a note such as C, F sharp, or B flat.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ليس اسم نغمة مدعومًا. استخدم نغمة مثل C أو F♯ أو B♭."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist kein unterstützter Notenname. Verwende eine Note wie C, F♯ oder B♭."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't a supported note name. Use a note such as C, F sharp, or B flat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no es un nombre de nota compatible. Usa una nota como C, F♯ o B♭."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas un nom de note pris en charge. Utilisez une note comme C, F♯ ou B♭."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は対応している音名ではありません。C、F♯、B♭などを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 지원되는 음이름이 아닙니다. C, F♯ 또는 B♭ 같은 음을 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não é um nome de nota compatível. Use uma nota como C, F♯ ou B♭."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — неподдерживаемое название ноты. Используйте, например, C, F♯ или B♭."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không phải tên nốt được hỗ trợ. Hãy dùng nốt như C, F♯ hoặc B♭."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是支持的音名。请使用 C、F♯ 或 B♭ 等音符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是支援的音名。請使用 C、F♯ 或 B♭ 等音符。"
          }
        }
      }
    },
