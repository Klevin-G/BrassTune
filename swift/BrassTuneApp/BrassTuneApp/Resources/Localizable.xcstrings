    "A cent is a very small pitch step. Smaller numbers are closer to the center.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السنت وحدة صغيرة جدًا لقياس فرق طبقة الصوت. الأرقام الأصغر أقرب إلى الضبط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Cent ist ein sehr kleiner Tonhöhenabstand. Kleinere Zahlen liegen näher am Zentrum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cent is a very small pitch step. Smaller numbers are closer to the center."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cent es una unidad muy pequeña de altura. Los números menores están más cerca del centro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cent est un très petit écart de hauteur. Les nombres plus petits sont plus proches du centre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セントは音高差を表すごく小さな単位です。数値が小さいほど中心に近くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "센트는 음높이 차이를 나타내는 아주 작은 단위입니다. 숫자가 작을수록 중심에 가깝습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cent é uma unidade muito pequena de altura. Números menores ficam mais perto do centro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цент — очень малая единица высоты звука. Чем меньше число, тем ближе к центру."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cent là đơn vị rất nhỏ đo chênh lệch cao độ. Số càng nhỏ thì càng gần tâm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音分是衡量音高差异的很小单位。数值越小，就越接近中心。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音分是衡量音高差異的很小單位。數值越小，就越接近中心。"
          }
        }
      }
    },
    "A cent is a very small pitch step. Smaller numbers mean you are closer to the center of the note.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السنت وحدة صغيرة جدًا لقياس فرق طبقة الصوت. الأرقام الأصغر تعني أنك أقرب إلى مركز النغمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Cent ist ein sehr kleiner Tonhöhenabstand. Kleinere Zahlen bedeuten, dass du näher am Zentrum des Tons bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cent is a very small pitch step. Smaller numbers mean you are closer to the center of the note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cent es una unidad muy pequeña de altura. Los números menores indican que estás más cerca del centro de la nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cent est un très petit écart de hauteur. Les nombres plus petits indiquent que vous êtes plus près du centre de la note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セントは音高差を表すごく小さな単位です。数値が小さいほど音の中心に近いことを示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "센트는 음높이 차이를 나타내는 아주 작은 단위입니다. 숫자가 작을수록 음정 중심에 가깝습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cent é uma unidade muito pequena de altura. Números menores indicam que você está mais perto do centro da nota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цент — очень малая единица высоты звука. Чем меньше число, тем ближе вы к центру ноты."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cent là đơn vị rất nhỏ đo chênh lệch cao độ. Số càng nhỏ thì bạn càng gần tâm nốt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音分是衡量音高差异的很小单位。数值越小，表示越接近音符中心。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音分是衡量音高差異的很小單位。數值越小，表示越接近音符中心。"
          }
        }
      }
    },
