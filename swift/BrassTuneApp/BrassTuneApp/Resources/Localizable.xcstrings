    "Open this goal to log your self-assessment or update it." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Open this goal to log your self-assessment or update it."}},"ar":{"stringUnit":{"state":"translated","value":"افتح هذا الهدف لتسجيل تقييمك الذاتي أو تحديثه."}},"de":{"stringUnit":{"state":"translated","value":"Öffnen Sie dieses Ziel, um Ihre Selbsteinschätzung zu erfassen oder zu aktualisieren."}},"es":{"stringUnit":{"state":"translated","value":"Abre este objetivo para registrar o actualizar tu autoevaluación."}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrez cet objectif pour noter ou mettre à jour votre autoévaluation."}},"ja":{"stringUnit":{"state":"translated","value":"この目標を開いて、自己評価を記録または更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 목표를 열어 자기 평가를 기록하거나 업데이트하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abra esta meta para registrar ou atualizar sua autoavaliação."}},"ru":{"stringUnit":{"state":"translated","value":"Откройте эту цель, чтобы записать или обновить самооценку."}},"vi":{"stringUnit":{"state":"translated","value":"Mở mục tiêu này để ghi lại hoặc cập nhật phần tự đánh giá của bạn."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开此目标以记录或更新你的自我评估。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開啟此目標以記錄或更新你的自我評估。"}}}},
    "Practice at %@ BPM" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Practice at %@ BPM"}},"ar":{"stringUnit":{"state":"translated","value":"تدرّب عند %@ BPM"}},"de":{"stringUnit":{"state":"translated","value":"Üben bei %@ BPM"}},"es":{"stringUnit":{"state":"translated","value":"Practica a %@ BPM"}},"fr":{"stringUnit":{"state":"translated","value":"Travaillez à %@ BPM"}},"ja":{"stringUnit":{"state":"translated","value":"%@ BPMで練習"}},"ko":{"stringUnit":{"state":"translated","value":"%@ BPM으로 연습"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pratique a %@ BPM"}},"ru":{"stringUnit":{"state":"translated","value":"Занимайтесь при %@ BPM"}},"vi":{"stringUnit":{"state":"translated","value":"Luyện tập ở %@ BPM"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"以 %@ BPM 练习"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"以 %@ BPM 練習"}}}},
    "Practice at target %@ BPM" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Practice at target %@ BPM"}},"ar":{"stringUnit":{"state":"translated","value":"تدرّب بالهدف %@ BPM"}},"de":{"stringUnit":{"state":"translated","value":"Üben beim Zieltempo %@ BPM"}},"es":{"stringUnit":{"state":"translated","value":"Practica al objetivo de %@ BPM"}},"fr":{"stringUnit":{"state":"translated","value":"Travaillez au tempo cible de %@ BPM"}},"ja":{"stringUnit":{"state":"translated","value":"目標 %@ BPMで練習"}},"ko":{"stringUnit":{"state":"translated","value":"목표 %@ BPM으로 연습"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pratique na meta de %@ BPM"}},"ru":{"stringUnit":{"state":"translated","value":"Занимайтесь в целевом темпе %@ BPM"}},"vi":{"stringUnit":{"state":"translated","value":"Luyện tập ở mục tiêu %@ BPM"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"以目标 %@ BPM 练习"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"以目標 %@ BPM 練習"}}}},
    "Opens the metronome at this tempo. The metronome stays stopped until you start it." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Opens the metronome at this tempo. The metronome stays stopped until you start it."}},"ar":{"stringUnit":{"state":"translated","value":"يفتح المترونوم بهذا الإيقاع. يبقى المترونوم متوقفًا حتى تبدأه."}},"de":{"stringUnit":{"state":"translated","value":"Öffnet das Metronom bei diesem Tempo. Das Metronom bleibt angehalten, bis Sie es starten."}},"es":{"stringUnit":{"state":"translated","value":"Abre el metrónomo a este tempo. El metrónomo permanece detenido hasta que lo inicies."}},"fr":{"stringUnit":{"state":"translated","value":"Ouvre le métronome à ce tempo. Le métronome reste arrêté jusqu’à ce que vous le démarriez."}},"ja":{"stringUnit":{"state":"translated","value":"このテンポでメトロノームを開きます。開始するまでメトロノームは停止したままです。"}},"ko":{"stringUnit":{"state":"translated","value":"이 템포로 메트로놈을 엽니다. 시작할 때까지 메트로놈은 멈춘 상태로 유지됩니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abre o metrônomo neste andamento. O metrônomo fica parado até você iniciá-lo."}},"ru":{"stringUnit":{"state":"translated","value":"Открывает метроном в этом темпе. Метроном останется остановленным, пока вы его не запустите."}},"vi":{"stringUnit":{"state":"translated","value":"Mở máy đếm nhịp ở tốc độ này. Máy đếm nhịp sẽ dừng cho đến khi bạn bắt đầu."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"以此速度打开节拍器。节拍器会保持停止，直到你启动它。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"以此速度開啟節拍器。節拍器會保持停止，直到你啟動它。"}}}},
    "Choose outcome" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose outcome"}},"ar":{"stringUnit":{"state":"translated","value":"اختر النتيجة"}},"de":{"stringUnit":{"state":"translated","value":"Ergebnis auswählen"}},"es":{"stringUnit":{"state":"translated","value":"Elige el resultado"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir le résultat"}},"ja":{"stringUnit":{"state":"translated","value":"結果を選択"}},"ko":{"stringUnit":{"state":"translated","value":"결과 선택"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha o resultado"}},"ru":{"stringUnit":{"state":"translated","value":"Выберите результат"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn kết quả"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择结果"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇結果"}}}},
    "Record measurements" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Record measurements"}},"ar":{"stringUnit":{"state":"translated","value":"سجّل القياسات"}},"de":{"stringUnit":{"state":"translated","value":"Messwerte erfassen"}},"es":{"stringUnit":{"state":"translated","value":"Registrar mediciones"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrer les mesures"}},"ja":{"stringUnit":{"state":"translated","value":"測定値を記録"}},"ko":{"stringUnit":{"state":"translated","value":"측정값 기록"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Registrar medições"}},"ru":{"stringUnit":{"state":"translated","value":"Записать измерения"}},"vi":{"stringUnit":{"state":"translated","value":"Ghi lại số đo"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记录测量值"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"記錄測量值"}}}},
    "Measurements are optional. Add only the values you observed yourself." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Measurements are optional. Add only the values you observed yourself."}},"ar":{"stringUnit":{"state":"translated","value":"القياسات اختيارية. أضف فقط القيم التي لاحظتها بنفسك."}},"de":{"stringUnit":{"state":"translated","value":"Messwerte sind optional. Fügen Sie nur Werte hinzu, die Sie selbst beobachtet haben."}},"es":{"stringUnit":{"state":"translated","value":"Las mediciones son opcionales. Añade solo los valores que hayas observado personalmente."}},"fr":{"stringUnit":{"state":"translated","value":"Les mesures sont facultatives. Ajoutez uniquement les valeurs que vous avez observées vous-même."}},"ja":{"stringUnit":{"state":"translated","value":"測定値は任意です。自分で観察した値だけを追加してください。"}},"ko":{"stringUnit":{"state":"translated","value":"측정값은 선택 사항입니다. 직접 관찰한 값만 추가하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"As medições são opcionais. Adicione somente os valores que você observou."}},"ru":{"stringUnit":{"state":"translated","value":"Измерения необязательны. Добавляйте только значения, которые вы наблюдали сами."}},"vi":{"stringUnit":{"state":"translated","value":"Các số đo là tùy chọn. Chỉ thêm những giá trị bạn tự quan sát được."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"测量值为可选项。请只添加你自己观察到的数值。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"測量值為選填。請只新增你自己觀察到的數值。"}}}},
    "First drone exercise" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"First drone exercise"}},"ar":{"stringUnit":{"state":"translated","value":"تمرين النغمة المستمرة الأول"}},"de":{"stringUnit":{"state":"translated","value":"Erste Übung mit Dauerton"}},"es":{"stringUnit":{"state":"translated","value":"Primer ejercicio con nota sostenida"}},"fr":{"stringUnit":{"state":"translated","value":"Premier exercice avec son continu"}},"ja":{"stringUnit":{"state":"translated","value":"最初のドローン練習"}},"ko":{"stringUnit":{"state":"translated","value":"첫 드론 연습"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Primeiro exercício com nota de referência"}},"ru":{"stringUnit":{"state":"translated","value":"Первое упражнение с постоянным тоном"}},"vi":{"stringUnit":{"state":"translated","value":"Bài tập âm nền đầu tiên"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"第一个持续音练习"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"第一個持續音練習"}}}},
    "Choose one comfortable note, listen for two calm breaths, then match it softly. Adjust by listening for a steadier sound; the drone does not score your pitch." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose one comfortable note, listen for two calm breaths, then match it softly. Adjust by listening for a steadier sound; the drone does not score your pitch."}},"ar":{"stringUnit":{"state":"translated","value":"اختر نغمة مريحة، واستمع لمدة نفسين هادئين، ثم طابقها برفق. عدّل بالاستماع إلى صوت أكثر ثباتًا؛ فالنغمة المستمرة لا تقيّم طبقتك الصوتية."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie einen bequemen Ton, hören Sie zwei ruhige Atemzüge lang zu und stimmen Sie ihn dann sanft an. Passen Sie sich an, indem Sie auf einen gleichmäßigeren Klang hören; der Dauerton bewertet Ihre Tonhöhe nicht."}},"es":{"stringUnit":{"state":"translated","value":"Elige una nota cómoda, escucha durante dos respiraciones tranquilas y luego iguálala suavemente. Ajusta escuchando un sonido más estable; la nota sostenida no evalúa tu afinación."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez une note confortable, écoutez pendant deux respirations calmes, puis rejoignez-la doucement. Ajustez-vous en écoutant un son plus stable ; le son continu n’évalue pas votre justesse."}},"ja":{"stringUnit":{"state":"translated","value":"出しやすい音を一つ選び、落ち着いて二呼吸分聴いてから、やさしく合わせます。より安定した響きを聴きながら調整してください。ドローンは音程を採点しません。"}},"ko":{"stringUnit":{"state":"translated","value":"편안한 음 하나를 고르고 두 번의 편안한 호흡 동안 들은 다음 부드럽게 맞춰 보세요. 더 안정된 소리가 들리도록 조절하세요. 드론은 음정을 채점하지 않습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha uma nota confortável, ouça por duas respirações calmas e então iguale-a suavemente. Ajuste ouvindo um som mais estável; a nota de referência não avalia sua afinação."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите удобную ноту, послушайте её в течение двух спокойных вдохов, затем мягко подстройтесь. Корректируйте, вслушиваясь в более устойчивое звучание; постоянный тон не оценивает вашу высоту звука."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn một nốt thoải mái, lắng nghe trong hai nhịp thở bình tĩnh, rồi khớp nhẹ nhàng theo nó. Điều chỉnh bằng cách lắng nghe âm thanh ổn định hơn; âm nền không chấm điểm cao độ của bạn."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择一个舒适的音，静听两次平稳的呼吸，然后轻轻与它对齐。通过聆听更稳定的声音来调整；持续音不会为你的音高评分。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇一個舒適的音，靜聽兩次平穩的呼吸，然後輕輕與它對齊。持續音不會為你的音高評分；請透過聆聽更穩定的聲音來調整。"}}}},
    "BrassTune has microphone access, but cannot hear an input right now. Check your audio input and retry." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"BrassTune has microphone access, but cannot hear an input right now. Check your audio input and retry."}},"ar":{"stringUnit":{"state":"translated","value":"لدى BrassTune إذن الوصول إلى الميكروفون، لكنه لا يستطيع سماع إدخال الآن. تحقق من إدخال الصوت وحاول مرة أخرى."}},"de":{"stringUnit":{"state":"translated","value":"BrassTune hat Mikrofonzugriff, kann aber gerade kein Eingangssignal hören. Überprüfen Sie Ihren Audioeingang und versuchen Sie es erneut."}},"es":{"stringUnit":{"state":"translated","value":"BrassTune tiene acceso al micrófono, pero no puede escuchar una entrada en este momento. Revisa la entrada de audio e inténtalo de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"BrassTune a accès au microphone, mais ne reçoit aucun son pour le moment. Vérifiez votre entrée audio et réessayez."}},"ja":{"stringUnit":{"state":"translated","value":"BrassTuneにはマイクへのアクセス許可がありますが、現在は入力を聞き取れません。オーディオ入力を確認して、もう一度試してください。"}},"ko":{"stringUnit":{"state":"translated","value":"BrassTune에 마이크 접근 권한은 있지만 지금은 입력을 들을 수 없습니다. 오디오 입력을 확인한 후 다시 시도하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O BrassTune tem acesso ao microfone, mas não consegue ouvir uma entrada agora. Verifique a entrada de áudio e tente novamente."}},"ru":{"stringUnit":{"state":"translated","value":"У BrassTune есть доступ к микрофону, но сейчас он не слышит входной сигнал. Проверьте аудиовход и повторите попытку."}},"vi":{"stringUnit":{"state":"translated","value":"BrassTune có quyền truy cập micrô nhưng hiện không nghe được âm thanh đầu vào. Hãy kiểm tra đầu vào âm thanh rồi thử lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"BrassTune 已获得麦克风访问权限，但现在听不到输入。请检查你的音频输入后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"BrassTune 已取得麥克風存取權限，但現在聽不到輸入。請檢查你的音訊輸入後重試。"}}}},
    "MIC-INPUT: BrassTune can't hear a microphone. Check your audio input and retry." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"MIC-INPUT: BrassTune can't hear a microphone. Check your audio input and retry."}},"ar":{"stringUnit":{"state":"translated","value":"MIC-INPUT: لا يستطيع BrassTune سماع ميكروفون. تحقق من إدخال الصوت وحاول مرة أخرى."}},"de":{"stringUnit":{"state":"translated","value":"MIC-INPUT: BrassTune kann kein Mikrofonsignal hören. Überprüfen Sie Ihren Audioeingang und versuchen Sie es erneut."}},"es":{"stringUnit":{"state":"translated","value":"MIC-INPUT: BrassTune no puede escuchar un micrófono. Revisa la entrada de audio e inténtalo de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"MIC-INPUT: BrassTune ne reçoit aucun son du microphone. Vérifiez votre entrée audio et réessayez."}},"ja":{"stringUnit":{"state":"translated","value":"MIC-INPUT: BrassTuneはマイク入力を聞き取れません。オーディオ入力を確認して、もう一度試してください。"}},"ko":{"stringUnit":{"state":"translated","value":"MIC-INPUT: BrassTune이 마이크 소리를 들을 수 없습니다. 오디오 입력을 확인한 후 다시 시도하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"MIC-INPUT: o BrassTune não consegue ouvir um microfone. Verifique a entrada de áudio e tente novamente."}},"ru":{"stringUnit":{"state":"translated","value":"MIC-INPUT: BrassTune не слышит сигнал с микрофона. Проверьте аудиовход и повторите попытку."}},"vi":{"stringUnit":{"state":"translated","value":"MIC-INPUT: BrassTune không nghe được micrô. Hãy kiểm tra đầu vào âm thanh rồi thử lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MIC-INPUT: BrassTune 听不到麦克风。请检查你的音频输入后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"MIC-INPUT: BrassTune 聽不到麥克風。請檢查你的音訊輸入後重試。"}}}},
    "MIC-START: BrassTune couldn't start the microphone. Check your audio input and try again." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"MIC-START: BrassTune couldn't start the microphone. Check your audio input and try again."}},"ar":{"stringUnit":{"state":"translated","value":"MIC-START: تعذّر على BrassTune بدء تشغيل الميكروفون. تحقق من إدخال الصوت وحاول مرة أخرى."}},"de":{"stringUnit":{"state":"translated","value":"MIC-START: BrassTune konnte das Mikrofon nicht starten. Überprüfen Sie Ihren Audioeingang und versuchen Sie es erneut."}},"es":{"stringUnit":{"state":"translated","value":"MIC-START: BrassTune no pudo iniciar el micrófono. Revisa la entrada de audio e inténtalo de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"MIC-START: BrassTune n’a pas pu démarrer le microphone. Vérifiez votre entrée audio et réessayez."}},"ja":{"stringUnit":{"state":"translated","value":"MIC-START: BrassTuneはマイクを開始できませんでした。オーディオ入力を確認して、もう一度試してください。"}},"ko":{"stringUnit":{"state":"translated","value":"MIC-START: BrassTune이 마이크를 시작하지 못했습니다. 오디오 입력을 확인한 후 다시 시도하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"MIC-START: o BrassTune não conseguiu iniciar o microfone. Verifique a entrada de áudio e tente novamente."}},"ru":{"stringUnit":{"state":"translated","value":"MIC-START: BrassTune не удалось запустить микрофон. Проверьте аудиовход и попробуйте снова."}},"vi":{"stringUnit":{"state":"translated","value":"MIC-START: BrassTune không thể khởi động micrô. Hãy kiểm tra đầu vào âm thanh rồi thử lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MIC-START: BrassTune 无法启动麦克风。请检查你的音频输入后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"MIC-START: BrassTune 無法啟動麥克風。請檢查你的音訊輸入後重試。"}}}},
    "Practice outcomes" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Practice outcomes"}},"ar":{"stringUnit":{"state":"translated","value":"نتائج التدريب"}},"de":{"stringUnit":{"state":"translated","value":"Übungsergebnisse"}},"es":{"stringUnit":{"state":"translated","value":"Resultados de práctica"}},"fr":{"stringUnit":{"state":"translated","value":"Résultats de pratique"}},"ja":{"stringUnit":{"state":"translated","value":"練習の結果"}},"ko":{"stringUnit":{"state":"translated","value":"연습 결과"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Resultados da prática"}},"ru":{"stringUnit":{"state":"translated","value":"Результаты занятий"}},"vi":{"stringUnit":{"state":"translated","value":"Kết quả luyện tập"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"练习结果"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"練習結果"}}}},
    "Activity" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Activity"}},"ar":{"stringUnit":{"state":"translated","value":"النشاط"}},"de":{"stringUnit":{"state":"translated","value":"Aktivität"}},"es":{"stringUnit":{"state":"translated","value":"Actividad"}},"fr":{"stringUnit":{"state":"translated","value":"Activité"}},"ja":{"stringUnit":{"state":"translated","value":"アクティビティ"}},"ko":{"stringUnit":{"state":"translated","value":"활동"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atividade"}},"ru":{"stringUnit":{"state":"translated","value":"Занятие"}},"vi":{"stringUnit":{"state":"translated","value":"Hoạt động"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"活动"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"活動"}}}},
    "When to use it" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"When to use it"}},"ar":{"stringUnit":{"state":"translated","value":"متى تستخدمه"}},"de":{"stringUnit":{"state":"translated","value":"Wann Sie es verwenden"}},"es":{"stringUnit":{"state":"translated","value":"Cuándo usarlo"}},"fr":{"stringUnit":{"state":"translated","value":"Quand l’utiliser"}},"ja":{"stringUnit":{"state":"translated","value":"使うタイミング"}},"ko":{"stringUnit":{"state":"translated","value":"사용 시기"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Quando usar"}},"ru":{"stringUnit":{"state":"translated","value":"Когда использовать"}},"vi":{"stringUnit":{"state":"translated","value":"Khi nào nên dùng"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"何时使用"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"何時使用"}}}},
    "What to listen for" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"What to listen for"}},"ar":{"stringUnit":{"state":"translated","value":"ما الذي تستمع إليه"}},"de":{"stringUnit":{"state":"translated","value":"Worauf Sie hören sollten"}},"es":{"stringUnit":{"state":"translated","value":"Qué escuchar"}},"fr":{"stringUnit":{"state":"translated","value":"Ce qu’il faut écouter"}},"ja":{"stringUnit":{"state":"translated","value":"聴くポイント"}},"ko":{"stringUnit":{"state":"translated","value":"들을 점"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O que ouvir"}},"ru":{"stringUnit":{"state":"translated","value":"На что обращать внимание на слух"}},"vi":{"stringUnit":{"state":"translated","value":"Điều cần lắng nghe"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"聆听要点"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"聆聽重點"}}}},
    "First exercise" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"First exercise"}},"ar":{"stringUnit":{"state":"translated","value":"التمرين الأول"}},"de":{"stringUnit":{"state":"translated","value":"Erste Übung"}},"es":{"stringUnit":{"state":"translated","value":"Primer ejercicio"}},"fr":{"stringUnit":{"state":"translated","value":"Premier exercice"}},"ja":{"stringUnit":{"state":"translated","value":"最初の練習"}},"ko":{"stringUnit":{"state":"translated","value":"첫 연습"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Primeiro exercício"}},"ru":{"stringUnit":{"state":"translated","value":"Первое упражнение"}},"vi":{"stringUnit":{"state":"translated","value":"Bài tập đầu tiên"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"第一个练习"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"第一個練習"}}}},
    "Use the tuner to check a note after listening to it yourself." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use the tuner to check a note after listening to it yourself."}},"ar":{"stringUnit":{"state":"translated","value":"استخدم الموالف لفحص نغمة بعد أن تستمع إليها بنفسك."}},"de":{"stringUnit":{"state":"translated","value":"Verwenden Sie das Stimmgerät, um einen Ton zu prüfen, nachdem Sie ihn selbst angehört haben."}},"es":{"stringUnit":{"state":"translated","value":"Usa el afinador para comprobar una nota después de escucharla tú mismo."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez l’accordeur pour vérifier une note après l’avoir écoutée vous-même."}},"ja":{"stringUnit":{"state":"translated","value":"まず自分で音を聴いてから、チューナーでその音を確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"먼저 직접 음을 들은 후 튜너로 확인하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use o afinador para conferir uma nota depois de ouvi-la por conta própria."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте тюнер, чтобы проверить ноту после того, как сами её услышите."}},"vi":{"stringUnit":{"state":"translated","value":"Dùng bộ chỉnh âm để kiểm tra một nốt sau khi tự lắng nghe nốt đó."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"先自己聆听一个音，再用调音器检查它。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"先自己聆聽一個音，再用調音器檢查它。"}}}},
    "Listen for a steady pitch instead of chasing every movement of the needle." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Listen for a steady pitch instead of chasing every movement of the needle."}},"ar":{"stringUnit":{"state":"translated","value":"استمع إلى طبقة صوت ثابتة بدلًا من ملاحقة كل حركة للإبرة."}},"de":{"stringUnit":{"state":"translated","value":"Achten Sie auf eine gleichmäßige Tonhöhe, statt jeder Bewegung der Nadel zu folgen."}},"es":{"stringUnit":{"state":"translated","value":"Escucha una afinación estable en vez de perseguir cada movimiento de la aguja."}},"fr":{"stringUnit":{"state":"translated","value":"Écoutez une hauteur stable plutôt que de suivre chaque mouvement de l’aiguille."}},"ja":{"stringUnit":{"state":"translated","value":"針の動きをすべて追いかけるのではなく、安定した音程を聴いてください。"}},"ko":{"stringUnit":{"state":"translated","value":"바늘의 모든 움직임을 따라가기보다 안정된 음정을 들으세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ouça uma afinação estável em vez de perseguir cada movimento da agulha."}},"ru":{"stringUnit":{"state":"translated","value":"Слушайте устойчивую высоту звука, а не следите за каждым движением стрелки."}},"vi":{"stringUnit":{"state":"translated","value":"Hãy lắng nghe cao độ ổn định thay vì chạy theo từng chuyển động của kim."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"聆听稳定的音高，而不是追逐指针的每一次移动。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"聆聽穩定的音高，而不是追逐指針的每一次移動。"}}}},
    "Use the metronome to check the pulse of a short passage at a comfortable tempo." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use the metronome to check the pulse of a short passage at a comfortable tempo."}},"ar":{"stringUnit":{"state":"translated","value":"استخدم المترونوم لفحص نبض مقطع قصير بإيقاع مريح."}},"de":{"stringUnit":{"state":"translated","value":"Verwenden Sie das Metronom, um den Puls einer kurzen Passage in einem angenehmen Tempo zu prüfen."}},"es":{"stringUnit":{"state":"translated","value":"Usa el metrónomo para comprobar el pulso de un pasaje corto a un tempo cómodo."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez le métronome pour vérifier la pulsation d’un court passage à un tempo confortable."}},"ja":{"stringUnit":{"state":"translated","value":"メトロノームを使って、出しやすいテンポで短いフレーズの拍を確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"편안한 템포로 짧은 구절의 박을 확인하려면 메트로놈을 사용하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use o metrônomo para conferir a pulsação de uma passagem curta em um andamento confortável."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте метроном, чтобы проверить пульс короткого фрагмента в удобном темпе."}},"vi":{"stringUnit":{"state":"translated","value":"Dùng máy đếm nhịp để kiểm tra nhịp của một đoạn ngắn ở tốc độ thoải mái."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用节拍器，以舒适的速度检查短乐段的节拍。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用節拍器，以舒適的速度檢查短樂段的節拍。"}}}},
    "Listen for evenly spaced attacks and a steady pulse when the click stops." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Listen for evenly spaced attacks and a steady pulse when the click stops."}},"ar":{"stringUnit":{"state":"translated","value":"استمع إلى بدايات نغمات متباعدة بالتساوي ونبض ثابت عند توقف النقرات."}},"de":{"stringUnit":{"state":"translated","value":"Achten Sie auf gleichmäßig gesetzte Einsätze und einen stabilen Puls, wenn der Klick stoppt."}},"es":{"stringUnit":{"state":"translated","value":"Escucha ataques espaciados de forma uniforme y un pulso estable cuando se detenga el clic."}},"fr":{"stringUnit":{"state":"translated","value":"Écoutez des attaques régulièrement espacées et une pulsation stable lorsque le clic s’arrête."}},"ja":{"stringUnit":{"state":"translated","value":"クリックが止まったとき、均等な間隔のアタックと安定した拍を聴いてください。"}},"ko":{"stringUnit":{"state":"translated","value":"클릭이 멈췄을 때 고르게 간격이 맞는 어택과 안정된 박을 들으세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ouça ataques com espaçamento uniforme e uma pulsação estável quando o clique parar."}},"ru":{"stringUnit":{"state":"translated","value":"Когда щелчки прекратятся, слушайте равномерные атаки и устойчивый пульс."}},"vi":{"stringUnit":{"state":"translated","value":"Khi tiếng nhấp dừng lại, hãy lắng nghe các âm vào đều nhau và nhịp ổn định."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当点击声停止时，聆听均匀的起音和稳定的节拍。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"當點擊聲停止時，聆聽均勻的起音和穩定的節拍。"}}}},
    "Self-assessed results; activity totals do not prove mastery." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Self-assessed results; activity totals do not prove mastery."}},"ar":{"stringUnit":{"state":"translated","value":"نتائج قيّمها المتعلم ذاتيًا؛ إجمالي النشاط لا يثبت الإتقان."}},"de":{"stringUnit":{"state":"translated","value":"Selbst eingeschätzte Ergebnisse; Aktivitätssummen belegen keine Beherrschung."}},"es":{"stringUnit":{"state":"translated","value":"Resultados autoevaluados; los totales de actividad no demuestran dominio."}},"fr":{"stringUnit":{"state":"translated","value":"Résultats autoévalués ; les totaux d’activité ne prouvent pas la maîtrise."}},"ja":{"stringUnit":{"state":"translated","value":"自己評価による結果です。アクティビティの合計は習得の証明ではありません。"}},"ko":{"stringUnit":{"state":"translated","value":"자기 평가 결과이며 활동 합계는 숙달을 증명하지 않습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Resultados autoavaliados; os totais de atividade não comprovam domínio."}},"ru":{"stringUnit":{"state":"translated","value":"Результаты самооценки; общее число занятий не доказывает владение навыком."}},"vi":{"stringUnit":{"state":"translated","value":"Kết quả do người học tự đánh giá; tổng số hoạt động không chứng minh sự thành thạo."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"结果由学习者自行评估；活动总数并不能证明掌握程度。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"結果由學習者自行評估；活動總數並不能證明掌握程度。"}}}},
    "Record tempo" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Record tempo"}},"ar":{"stringUnit":{"state":"translated","value":"تسجيل السرعة"}},"de":{"stringUnit":{"state":"translated","value":"Tempo erfassen"}},"es":{"stringUnit":{"state":"translated","value":"Registrar tempo"}},"fr":{"stringUnit":{"state":"translated","value":"Noter le tempo"}},"ja":{"stringUnit":{"state":"translated","value":"テンポを記録"}},"ko":{"stringUnit":{"state":"translated","value":"템포 기록"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Registrar andamento"}},"ru":{"stringUnit":{"state":"translated","value":"Записать темп"}},"vi":{"stringUnit":{"state":"translated","value":"Ghi lại tốc độ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记录速度"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"記錄速度"}}}},
    "Self-reported: %@ repetitions" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Self-reported: %@ repetitions"}},"ar":{"stringUnit":{"state":"translated","value":"تقييم ذاتي: %@ تكرارات"}},"de":{"stringUnit":{"state":"translated","value":"Selbst angegeben: %@ Wiederholungen"}},"es":{"stringUnit":{"state":"translated","value":"Autoevaluación: %@ repeticiones"}},"fr":{"stringUnit":{"state":"translated","value":"Auto-évaluation : %@ répétitions"}},"ja":{"stringUnit":{"state":"translated","value":"自己申告：%@回の反復"}},"ko":{"stringUnit":{"state":"translated","value":"자기 보고: %@회 반복"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Autorrelato: %@ repetições"}},"ru":{"stringUnit":{"state":"translated","value":"Самооценка: %@ повторений"}},"vi":{"stringUnit":{"state":"translated","value":"Tự báo cáo: %@ lần lặp"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自我记录：%@ 次重复"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自我記錄：%@ 次重複"}}}},
    "%@ completed practice sessions" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"%@ جلسات تدريب مكتملة"}},"de":{"stringUnit":{"state":"translated","value":"%@ abgeschlossene Übungseinheiten"}},"en":{"stringUnit":{"state":"translated","value":"%@ completed practice sessions"}},"es":{"stringUnit":{"state":"translated","value":"%@ sesiones de práctica completadas"}},"fr":{"stringUnit":{"state":"translated","value":"%@ séances d’entraînement terminées"}},"ja":{"stringUnit":{"state":"translated","value":"%@ 回の完了した練習セッション"}},"ko":{"stringUnit":{"state":"translated","value":"완료된 연습 세션 %@회"}},"pt-BR":{"stringUnit":{"state":"translated","value":"%@ sessões de prática concluídas"}},"ru":{"stringUnit":{"state":"translated","value":"%@ завершённых занятий"}},"vi":{"stringUnit":{"state":"translated","value":"%@ buổi luyện tập đã hoàn thành"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已完成 %@ 次练习"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已完成 %@ 次練習"}}}} ,
    "%@ BPM" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"%@ BPM"}},"de":{"stringUnit":{"state":"translated","value":"%@ BPM"}},"en":{"stringUnit":{"state":"translated","value":"%@ BPM"}},"es":{"stringUnit":{"state":"translated","value":"%@ BPM"}},"fr":{"stringUnit":{"state":"translated","value":"%@ BPM"}},"ja":{"stringUnit":{"state":"translated","value":"%@ BPM"}},"ko":{"stringUnit":{"state":"translated","value":"%@ BPM"}},"pt-BR":{"stringUnit":{"state":"translated","value":"%@ BPM"}},"ru":{"stringUnit":{"state":"translated","value":"%@ BPM"}},"vi":{"stringUnit":{"state":"translated","value":"%@ BPM"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ BPM"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ BPM"}}}} ,
    "Choose from 1 to 168 completed practice sessions for this week." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"اختر من 1 إلى 168 جلسة تدريب مكتملة لهذا الأسبوع."}},"de":{"stringUnit":{"state":"translated","value":"Wähle für diese Woche zwischen 1 und 168 abgeschlossenen Übungseinheiten."}},"en":{"stringUnit":{"state":"translated","value":"Choose from 1 to 168 completed practice sessions for this week."}},"es":{"stringUnit":{"state":"translated","value":"Elige de 1 a 168 sesiones de práctica completadas para esta semana."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez de 1 à 168 séances d’entraînement terminées pour cette semaine."}},"ja":{"stringUnit":{"state":"translated","value":"今週の完了した練習セッションを1回から168回の間で選びます。"}},"ko":{"stringUnit":{"state":"translated","value":"이번 주 완료한 연습 세션 목표를 1회에서 168회 사이로 선택하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha de 1 a 168 sessões de prática concluídas para esta semana."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите от 1 до 168 завершённых занятий на эту неделю."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn từ 1 đến 168 buổi luyện tập đã hoàn thành cho tuần này."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为本周选择 1 到 168 次已完成练习。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"為本週選擇 1 到 168 次已完成練習。"}}}} ,
    "Equal temperament spaces an octave into 12 equal semitone steps. Just intonation uses simple ratios from the selected root, so an interval or chord can differ slightly from equal temperament." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"يقسم الضبط المتساوي الأوكتاف إلى 12 نصف درجة متساوية. يستخدم الضبط بالنسب البسيطة نسبًا بسيطة من الجذر المختار، لذلك قد يختلف الفاصل أو الوتر قليلًا عن الضبط المتساوي."}},"de":{"stringUnit":{"state":"translated","value":"Die gleichstufige Stimmung teilt eine Oktave in 12 gleich große Halbtonschritte. Die reine Stimmung verwendet einfache Verhältnisse vom gewählten Grundton aus, daher kann ein Intervall oder Akkord leicht von der gleichstufigen Stimmung abweichen."}},"en":{"stringUnit":{"state":"translated","value":"Equal temperament spaces an octave into 12 equal semitone steps. Just intonation uses simple ratios from the selected root, so an interval or chord can differ slightly from equal temperament."}},"es":{"stringUnit":{"state":"translated","value":"El temperamento igual divide una octava en 12 semitonos iguales. La afinación justa usa proporciones simples desde la fundamental elegida, por lo que un intervalo o acorde puede diferir ligeramente del temperamento igual."}},"fr":{"stringUnit":{"state":"translated","value":"Le tempérament égal divise une octave en 12 demi-tons égaux. L’intonation juste utilise des rapports simples à partir de la fondamentale choisie, donc un intervalle ou un accord peut différer légèrement du tempérament égal."}},"ja":{"stringUnit":{"state":"translated","value":"平均律は1オクターブを等しい12の半音に分けます。純正律は選んだ根音からの単純な比を使うため、音程や和音は平均律とわずかに異なることがあります。"}},"ko":{"stringUnit":{"state":"translated","value":"평균율은 한 옥타브를 같은 12개의 반음으로 나눕니다. 순정률은 선택한 근음의 단순한 비율을 사용하므로 음정이나 화음이 평균율과 약간 다를 수 있습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O temperamento igual divide uma oitava em 12 semitons iguais. A entonação justa usa proporções simples a partir da fundamental selecionada, portanto um intervalo ou acorde pode diferir um pouco do temperamento igual."}},"ru":{"stringUnit":{"state":"translated","value":"Равномерная темперация делит октаву на 12 равных полутонов. Чистый строй использует простые соотношения от выбранного основного тона, поэтому интервал или аккорд может немного отличаться от равномерной темперации."}},"vi":{"stringUnit":{"state":"translated","value":"Bình quân luật chia một quãng tám thành 12 nửa cung bằng nhau. Âm luật thuần dùng các tỉ lệ đơn giản từ âm gốc đã chọn, vì vậy một quãng hoặc hợp âm có thể hơi khác với bình quân luật."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"十二平均律把一个八度分成12个相等的半音。纯律使用从所选根音出发的简单比例，因此音程或和弦可能与十二平均律略有不同。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"十二平均律把一個八度分成12個相等的半音。純律使用從所選根音出發的簡單比例，因此音程或和弦可能與十二平均律略有不同。"}}}} ,
    "How the tuning references differ" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"كيف تختلف مراجع الضبط"}},"de":{"stringUnit":{"state":"translated","value":"Unterschiede zwischen den Stimmreferenzen"}},"en":{"stringUnit":{"state":"translated","value":"How the tuning references differ"}},"es":{"stringUnit":{"state":"translated","value":"Cómo difieren las referencias de afinación"}},"fr":{"stringUnit":{"state":"translated","value":"Différences entre les références d’accord"}},"ja":{"stringUnit":{"state":"translated","value":"チューニングの基準の違い"}},"ko":{"stringUnit":{"state":"translated","value":"조율 기준의 차이"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Como as referências de afinação diferem"}},"ru":{"stringUnit":{"state":"translated","value":"Чем отличаются эталоны настройки"}},"vi":{"stringUnit":{"state":"translated","value":"Sự khác nhau giữa các tham chiếu chỉnh âm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"调音参考的差异"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"調音參考的差異"}}}} ,
    "Measurable session target" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"هدف جلسات قابل للقياس"}},"de":{"stringUnit":{"state":"translated","value":"Messbares Ziel für Übungseinheiten"}},"en":{"stringUnit":{"state":"translated","value":"Measurable session target"}},"es":{"stringUnit":{"state":"translated","value":"Objetivo medible de sesiones"}},"fr":{"stringUnit":{"state":"translated","value":"Objectif mesurable de séances"}},"ja":{"stringUnit":{"state":"translated","value":"測定できるセッション目標"}},"ko":{"stringUnit":{"state":"translated","value":"측정 가능한 세션 목표"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Meta mensurável de sessões"}},"ru":{"stringUnit":{"state":"translated","value":"Измеримая цель по занятиям"}},"vi":{"stringUnit":{"state":"translated","value":"Mục tiêu buổi luyện tập có thể đo lường"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可衡量的练习次数目标"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可衡量的練習次數目標"}}}} ,
    "Only completed sessions with recorded practice time count toward this target." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"تُحتسب فقط الجلسات المكتملة ذات وقت التدريب المسجل ضمن هذا الهدف."}},"de":{"stringUnit":{"state":"translated","value":"Nur abgeschlossene Einheiten mit erfasster Übungszeit zählen für dieses Ziel."}},"en":{"stringUnit":{"state":"translated","value":"Only completed sessions with recorded practice time count toward this target."}},"es":{"stringUnit":{"state":"translated","value":"Solo cuentan para este objetivo las sesiones completadas con tiempo de práctica registrado."}},"fr":{"stringUnit":{"state":"translated","value":"Seules les séances terminées avec un temps de pratique enregistré comptent pour cet objectif."}},"ja":{"stringUnit":{"state":"translated","value":"記録された練習時間のある完了したセッションだけが、この目標にカウントされます。"}},"ko":{"stringUnit":{"state":"translated","value":"기록된 연습 시간이 있는 완료된 세션만 이 목표에 반영됩니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Somente sessões concluídas com tempo de prática registrado contam para esta meta."}},"ru":{"stringUnit":{"state":"translated","value":"В эту цель засчитываются только завершённые занятия с записанным временем практики."}},"vi":{"stringUnit":{"state":"translated","value":"Chỉ các buổi đã hoàn thành có thời gian luyện tập được ghi lại mới được tính vào mục tiêu này."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只有记录了练习时间的已完成练习才计入此目标。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只有記錄了練習時間的已完成練習才計入此目標。"}}}} ,
    "Use the drone to hear beat speed and color, then adjust for the musical setting. It is a listening reference, not an absolute in-tune verdict." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"استخدم النغمة المستمرة لسماع سرعة الخفقات ولون الصوت، ثم اضبط بحسب السياق الموسيقي. إنها مرجع للاستماع وليست حكمًا مطلقًا على صحة النغمة."}},"de":{"stringUnit":{"state":"translated","value":"Nutze den Dauerton, um Schwebungsgeschwindigkeit und Klangfarbe zu hören, und passe dich dann dem musikalischen Kontext an. Er ist eine Hörreferenz, kein absolutes Urteil über die Intonation."}},"en":{"stringUnit":{"state":"translated","value":"Use the drone to hear beat speed and color, then adjust for the musical setting. It is a listening reference, not an absolute in-tune verdict."}},"es":{"stringUnit":{"state":"translated","value":"Usa el sonido sostenido para escuchar la velocidad de los batimientos y el color, y luego ajusta según el contexto musical. Es una referencia auditiva, no un veredicto absoluto de afinación."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez le bourdon pour entendre la vitesse des battements et la couleur du son, puis ajustez selon le contexte musical. C’est une référence d’écoute, pas un verdict absolu sur la justesse."}},"ja":{"stringUnit":{"state":"translated","value":"ドローンでうなりの速さと音色を聴き、音楽的な状況に合わせて調整します。これは聴くための基準であり、絶対的な音程判定ではありません。"}},"ko":{"stringUnit":{"state":"translated","value":"드론으로 맥놀이의 속도와 음색을 듣고 음악적 상황에 맞게 조정하세요. 이는 듣기 위한 기준이며 절대적인 음정 판정이 아닙니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use o som contínuo para ouvir a velocidade dos batimentos e a cor sonora, depois ajuste ao contexto musical. Ele é uma referência de escuta, não um veredito absoluto de afinação."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте эталонный тон, чтобы услышать скорость биений и окраску звука, затем корректируйте в соответствии с музыкальным контекстом. Это ориентир для слуха, а не абсолютный вердикт о точности интонации."}},"vi":{"stringUnit":{"state":"translated","value":"Dùng âm ngân để nghe tốc độ phách đập và màu âm, rồi điều chỉnh theo bối cảnh âm nhạc. Đây là tham chiếu để lắng nghe, không phải kết luận tuyệt đối về độ chuẩn xác cao độ."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用持续音聆听拍频速度和音色，再根据音乐情境调整。它是聆听参考，不是绝对的音准判定。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用持續音聆聽拍頻速度和音色，再根據音樂情境調整。它是聆聽參考，不是絕對的音準判定。"}}}} ,
    "Weekly session target" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"هدف الجلسات الأسبوعي"}},"de":{"stringUnit":{"state":"translated","value":"Wochenziel für Übungseinheiten"}},"en":{"stringUnit":{"state":"translated","value":"Weekly session target"}},"es":{"stringUnit":{"state":"translated","value":"Objetivo semanal de sesiones"}},"fr":{"stringUnit":{"state":"translated","value":"Objectif hebdomadaire de séances"}},"ja":{"stringUnit":{"state":"translated","value":"週間セッション目標"}},"ko":{"stringUnit":{"state":"translated","value":"주간 세션 목표"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Meta semanal de sessões"}},"ru":{"stringUnit":{"state":"translated","value":"Еженедельная цель по занятиям"}},"vi":{"stringUnit":{"state":"translated","value":"Mục tiêu buổi luyện tập hằng tuần"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每周练习次数目标"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每週練習次數目標"}}}} ,
    "Your tuner cents use equal temperament, so a just third or fifth can show a non-zero value." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"تستخدم السنتات في الموالف الضبط المتساوي، لذلك قد تظهر الثالثة أو الخامسة بالنسب البسيطة بقيمة غير صفرية."}},"de":{"stringUnit":{"state":"translated","value":"Die Cent-Anzeige deines Stimmgeräts verwendet die gleichstufige Stimmung; daher kann eine reine Terz oder Quinte einen Wert ungleich null anzeigen."}},"en":{"stringUnit":{"state":"translated","value":"Your tuner cents use equal temperament, so a just third or fifth can show a non-zero value."}},"es":{"stringUnit":{"state":"translated","value":"Los cents del afinador usan temperamento igual, por lo que una tercera o quinta justa puede mostrar un valor distinto de cero."}},"fr":{"stringUnit":{"state":"translated","value":"Les cents de votre accordeur utilisent le tempérament égal ; une tierce ou quinte juste peut donc afficher une valeur différente de zéro."}},"ja":{"stringUnit":{"state":"translated","value":"チューナーのセント表示は平均律を使うため、純正な長3度や完全5度でもゼロ以外の値を示すことがあります。"}},"ko":{"stringUnit":{"state":"translated","value":"튜너의 센트 표시는 평균율을 사용하므로 순정 장3도나 완전5도도 0이 아닌 값으로 나타날 수 있습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os cents do afinador usam o temperamento igual, portanto uma terça ou quinta justa pode mostrar um valor diferente de zero."}},"ru":{"stringUnit":{"state":"translated","value":"Показания тюнера в центах используют равномерную темперацию, поэтому чистая терция или квинта может показывать ненулевое значение."}},"vi":{"stringUnit":{"state":"translated","value":"Số cent của máy lên dây dùng bình quân luật, vì vậy quãng ba hoặc quãng năm thuần có thể hiển thị giá trị khác không."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"调音器的音分读数使用十二平均律，因此纯律三度或五度可能显示非零数值。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"調音器的音分讀數使用十二平均律，因此純律三度或五度可能顯示非零數值。"}}}} ,
    "Weekly session goal" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"هدف الجلسات الأسبوعي"}},"de":{"stringUnit":{"state":"translated","value":"Wöchentliches Ziel für Übungseinheiten"}},"en":{"stringUnit":{"state":"translated","value":"Weekly session goal"}},"es":{"stringUnit":{"state":"translated","value":"Objetivo semanal de sesiones"}},"fr":{"stringUnit":{"state":"translated","value":"Objectif hebdomadaire de séances"}},"ja":{"stringUnit":{"state":"translated","value":"週間セッション目標"}},"ko":{"stringUnit":{"state":"translated","value":"주간 세션 목표"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Meta semanal de sessões"}},"ru":{"stringUnit":{"state":"translated","value":"Еженедельная цель по занятиям"}},"vi":{"stringUnit":{"state":"translated","value":"Mục tiêu buổi luyện tập hằng tuần"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每周练习次数目标"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每週練習次數目標"}}}} ,
    "6-digit class code" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"رمز الصف المكوّن من 6 أرقام"}},"de":{"stringUnit":{"state":"translated","value":"6-stelliger Kurscode"}},"en":{"stringUnit":{"state":"translated","value":"6-digit class code"}},"es":{"stringUnit":{"state":"translated","value":"Código de clase de 6 dígitos"}},"fr":{"stringUnit":{"state":"translated","value":"Code de classe à 6 chiffres"}},"ja":{"stringUnit":{"state":"translated","value":"6桁のクラスコード"}},"ko":{"stringUnit":{"state":"translated","value":"6자리 클래스 코드"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Código da turma de 6 dígitos"}},"ru":{"stringUnit":{"state":"translated","value":"6-значный код класса"}},"vi":{"stringUnit":{"state":"translated","value":"Mã lớp gồm 6 chữ số"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"6 位班级代码"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"6 位班級代碼"}}}} ,
