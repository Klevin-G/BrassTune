    "Pick your instrument. Change it anytime in Settings." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"اختر آلتك. يمكنك تغييرها في الإعدادات في أي وقت."}},"de":{"stringUnit":{"state":"translated","value":"Wähle dein Instrument. Du kannst es jederzeit in den Einstellungen ändern."}},"en":{"stringUnit":{"state":"translated","value":"Pick your instrument. Change it anytime in Settings."}},"es":{"stringUnit":{"state":"translated","value":"Elige tu instrumento. Puedes cambiarlo en Configuración cuando quieras."}},"fr":{"stringUnit":{"state":"translated","value":"Choisis ton instrument. Tu peux le modifier à tout moment dans Réglages."}},"ja":{"stringUnit":{"state":"translated","value":"楽器を選んでください。いつでも設定で変更できます。"}},"ko":{"stringUnit":{"state":"translated","value":"악기를 선택하세요. 언제든 설정에서 변경할 수 있습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha seu instrumento. Você pode mudá-lo a qualquer momento em Ajustes."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите инструмент. Его можно изменить в настройках в любое время."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn nhạc cụ của bạn. Bạn có thể đổi bất cứ lúc nào trong Cài đặt."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择你的乐器。你可随时在“设置”中更改。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇你的樂器。你可隨時在「設定」中變更。"}}}} ,
    "Practice setup" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"إعداد التمرين"}},"de":{"stringUnit":{"state":"translated","value":"Übungseinrichtung"}},"en":{"stringUnit":{"state":"translated","value":"Practice setup"}},"es":{"stringUnit":{"state":"translated","value":"Configuración de práctica"}},"fr":{"stringUnit":{"state":"translated","value":"Configuration de l’entraînement"}},"ja":{"stringUnit":{"state":"translated","value":"練習の設定"}},"ko":{"stringUnit":{"state":"translated","value":"연습 설정"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Configuração de prática"}},"ru":{"stringUnit":{"state":"translated","value":"Настройка занятий"}},"vi":{"stringUnit":{"state":"translated","value":"Thiết lập luyện tập"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"练习设置"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"練習設定"}}}} ,
    "Reference tone volume, maximum 90 percent" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"مستوى صوت النغمة المرجعية، بحد أقصى 90 بالمئة"}},"de":{"stringUnit":{"state":"translated","value":"Lautstärke des Referenztons, maximal 90 Prozent"}},"en":{"stringUnit":{"state":"translated","value":"Reference tone volume, maximum 90 percent"}},"es":{"stringUnit":{"state":"translated","value":"Volumen del tono de referencia, máximo 90 por ciento"}},"fr":{"stringUnit":{"state":"translated","value":"Volume de la note de référence, maximum 90 pour cent"}},"ja":{"stringUnit":{"state":"translated","value":"基準音の音量（最大90パーセント）"}},"ko":{"stringUnit":{"state":"translated","value":"기준음 볼륨, 최대 90퍼센트"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Volume do som de referência, máximo de 90 por cento"}},"ru":{"stringUnit":{"state":"translated","value":"Громкость эталонного тона, не более 90 процентов"}},"vi":{"stringUnit":{"state":"translated","value":"Âm lượng nốt tham chiếu, tối đa 90 phần trăm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参考音音量，最高 90%"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"參考音音量，最高 90%"}}}} ,
