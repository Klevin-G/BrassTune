    },
    "BrassTune couldn't read its saved practice data. Your existing data was kept; restart the app or contact support before continuing." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على BrassTune قراءة بيانات التدريب المحفوظة. تم الاحتفاظ ببياناتك الحالية؛ أعد تشغيل التطبيق أو تواصل مع الدعم قبل المتابعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BrassTune konnte die gespeicherten Übungsdaten nicht lesen. Ihre vorhandenen Daten wurden beibehalten; starten Sie die App neu oder kontaktieren Sie den Support, bevor Sie fortfahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
