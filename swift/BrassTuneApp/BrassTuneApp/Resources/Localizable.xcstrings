    "A guided five-minute routine for steady air and relaxed attacks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روتين موجه مدته خمس دقائق للهواء الثابت والهجمات المريحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine geführte Fünf-Minuten-Routine für gleichmäßige Luft und entspannte Angriffe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A guided five-minute routine for steady air and relaxed attacks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una rutina guiada de cinco minutos para aire estable y ataques relajados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une routine guidée de cinq minutes pour un air stable et des attaques détendues."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安定した空気とリラックスした攻撃のためのガイド付き 5 分間のルーチン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꾸준한 공중 공격과 편안한 공격을 위한 5분 루틴 안내입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma rotina guiada de cinco minutos para ataques aéreos constantes e relaxados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пятиминутная программа под руководством инструктора для ровного воздуха и расслабленных атак."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thói quen kéo dài 5 phút có hướng dẫn để có không khí ổn định và các đòn tấn công thoải mái."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为期五分钟的指导练习，可实现稳定的空气和轻松的攻击。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為期五分鐘的指導練習，可實現穩定的空氣和輕鬆的攻擊。"
          }
        }
      }
    },
