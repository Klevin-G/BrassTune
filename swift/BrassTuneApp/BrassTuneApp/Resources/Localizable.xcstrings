    "This three-octave scale does not fit the selected instrument’s practical written range. Choose a shorter range or a different key." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This three-octave scale does not fit the selected instrument’s practical written range. Choose a shorter range or a different key."
          }
        }
,
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا السلم ذو الثلاثة أوكتافات لا يناسب المدى المكتوب العملي للآلة المحددة. اختر مدى أقصر أو مفتاحًا مختلفًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Dreioktavtonleiter liegt außerhalb des praktischen notierten Bereichs des ausgewählten Instruments. Wähle einen kürzeren Bereich oder eine andere Tonart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta escala de tres octavas no cabe en el rango escrito práctico del instrumento seleccionado. Elige un rango más corto u otra tonalidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette gamme de trois octaves dépasse la tessiture écrite pratique de l’instrument sélectionné. Choisissez une tessiture plus courte ou une autre tonalité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この3オクターブ音階は、選択した楽器の実用的な記譜音域に収まりません。短い音域または別の調を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 3옥타브 스케일은 선택한 악기의 실용적인 기보 음역에 맞지 않습니다. 더 짧은 음역이나 다른 조를 선택하세요."
          }
        }
,
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta escala de três oitavas não cabe na extensão escrita prática do instrumento selecionado. Escolha uma extensão menor ou outra tonalidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта трёхоктавная гамма не помещается в практический записанный диапазон выбранного инструмента. Выберите более короткий диапазон или другую тональность."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm giai ba quãng tám này vượt quá âm vực viết thực tế của nhạc cụ đã chọn. Hãy chọn quãng ngắn hơn hoặc giọng khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个三八度音阶超出所选乐器的实用记谱音域。请选择更短的音域或其他调。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個三八度音階超出所選樂器的實用記譜音域。請選擇較短的音域或其他調。"
          }
        }
      }
    },
