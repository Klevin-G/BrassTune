        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ein Übungspaket benötigt zwischen 1 und 12 Blöcke." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A practice pack needs between 1 and 12 blocks." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Un paquete de práctica debe tener entre 1 y 12 bloques." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Un pack d’entraînement doit comporter entre 1 et 12 blocs." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "練習パックには1〜12個のブロックが必要です。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "연습 팩에는 1~12개의 블록이 필요합니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Um pacote de prática precisa ter entre 1 e 12 blocos." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Набор для занятий должен содержать от 1 до 12 блоков." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Gói luyện tập cần có từ 1 đến 12 khối." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "练习包需要包含 1 到 12 个练习块。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "練習包需要包含 1 到 12 個練習區塊。" } }
