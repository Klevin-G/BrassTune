    "Start with an account, or choose local guest practice below." : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"ابدأ بحساب، أو اختر تدريب الضيف المحلي أدناه."}},"de":{"stringUnit":{"state":"translated","value":"Starte mit einem Konto oder wähle unten lokales Üben als Gast."}},"en":{"stringUnit":{"state":"translated","value":"Start with an account, or choose local guest practice below."}},"es":{"stringUnit":{"state":"translated","value":"Empieza con una cuenta o elige la práctica local como invitado a continuación."}},"fr":{"stringUnit":{"state":"translated","value":"Commencez avec un compte ou choisissez la pratique locale en invité ci-dessous."}},"ja":{"stringUnit":{"state":"translated","value":"アカウントで始めるか、下のローカルゲスト練習を選んでください。"}},"ko":{"stringUnit":{"state":"translated","value":"계정으로 시작하거나 아래에서 로컬 게스트 연습을 선택하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Comece com uma conta ou escolha a prática local como convidado abaixo."}},"ru":{"stringUnit":{"state":"translated","value":"Начните с учётной записи или выберите ниже локальные занятия в гостевом режиме."}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu bằng tài khoản hoặc chọn luyện tập khách cục bộ bên dưới."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用账户开始，或在下方选择本地访客练习。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用帳戶開始，或在下方選擇本機訪客練習。"}}}},
    "Start with one observable target" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"ابدأ بهدف واحد قابل للملاحظة"}},"de":{"stringUnit":{"state":"translated","value":"Beginne mit einem beobachtbaren Ziel"}},"en":{"stringUnit":{"state":"translated","value":"Start with one observable target"}},"es":{"stringUnit":{"state":"translated","value":"Empieza con un objetivo observable"}},"fr":{"stringUnit":{"state":"translated","value":"Commencez par un objectif observable"}},"ja":{"stringUnit":{"state":"translated","value":"観察できる目標を一つから始める"}},"ko":{"stringUnit":{"state":"translated","value":"관찰 가능한 목표 하나로 시작하세요"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Comece com uma meta observável"}},"ru":{"stringUnit":{"state":"translated","value":"Начните с одной наблюдаемой цели"}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu với một mục tiêu có thể quan sát"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从一个可观察的目标开始"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"從一個可觀察的目標開始"}}}},
