    "That class action conflicts with your current membership." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعارض إجراء الصف هذا مع عضويتك الحالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sammelklage steht im Widerspruch zu Ihrer aktuellen Mitgliedschaft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That class action conflicts with your current membership."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa demanda colectiva entra en conflicto con su membresía actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce recours collectif entre en conflit avec votre adhésion actuelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その集団訴訟は現在のメンバーシップと競合します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 집단 소송은 귀하의 현재 멤버십과 충돌합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa ação coletiva entra em conflito com sua associação atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот групповой иск противоречит вашему нынешнему членству."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vụ kiện tập thể đó xung đột với tư cách thành viên hiện tại của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该集体诉讼与您当前的会员资格相冲突。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該集體訴訟與您目前的會員資格相衝突。"
          }
        }
      }
    },
