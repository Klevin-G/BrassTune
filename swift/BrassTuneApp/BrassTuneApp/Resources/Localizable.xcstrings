    } },
    "Signed out." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"تم تسجيل الخروج."}},"de":{"stringUnit":{"state":"translated","value":"Abgemeldet."}},"en":{"stringUnit":{"state":"translated","value":"Signed out."}},"es":{"stringUnit":{"state":"translated","value":"Sesión cerrada."}},"fr":{"stringUnit":{"state":"translated","value":"Déconnecté."}},"ja":{"stringUnit":{"state":"translated","value":"サインアウトしました。"}},"ko":{"stringUnit":{"state":"translated","value":"로그아웃했습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sessão encerrada."}},"ru":{"stringUnit":{"state":"translated","value":"Вы вышли."}},"vi":{"stringUnit":{"state":"translated","value":"Đã đăng xuất."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已退出登录。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已登出。"}}
    } },
    "Signed out on this device. BrassTune couldn't confirm server logout, so try again online before using a shared device." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"تم تسجيل الخروج على هذا الجهاز. تعذر تأكيد الخروج من الخادم؛ حاول مجددًا عند الاتصال قبل استخدام جهاز مشترك."}},"de":{"stringUnit":{"state":"translated","value":"Auf diesem Gerät abgemeldet. Die Server-Abmeldung konnte nicht bestätigt werden; versuche es online erneut, bevor du ein geteiltes Gerät nutzt."}},"en":{"stringUnit":{"state":"translated","value":"Signed out on this device. BrassTune couldn't confirm server logout, so try again online before using a shared device."}},"es":{"stringUnit":{"state":"translated","value":"Sesión cerrada en este dispositivo. No se pudo confirmar en el servidor; vuelve a intentarlo con conexión antes de usar un dispositivo compartido."}},"fr":{"stringUnit":{"state":"translated","value":"Déconnecté sur cet appareil. La déconnexion du serveur n’a pas été confirmée; réessayez en ligne avant d’utiliser un appareil partagé."}},"ja":{"stringUnit":{"state":"translated","value":"このデバイスではサインアウトしました。サーバー側を確認できなかったため、共有デバイスを使う前にオンラインで再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 기기에서 로그아웃했습니다. 서버 로그아웃을 확인하지 못했으므로 공유 기기 사용 전 온라인에서 다시 시도하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sessão encerrada neste dispositivo. Não foi possível confirmar no servidor; tente novamente on-line antes de usar um dispositivo compartilhado."}},"ru":{"stringUnit":{"state":"translated","value":"На этом устройстве выполнен выход. Выход на сервере не подтвержден; повторите попытку онлайн перед использованием общего устройства."}},"vi":{"stringUnit":{"state":"translated","value":"Đã đăng xuất trên thiết bị này. Không thể xác nhận với máy chủ; hãy thử lại khi trực tuyến trước khi dùng thiết bị chung."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已在此设备上退出登录。BrassTune 无法确认服务器退出；使用共享设备前请联网重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已在此裝置上登出。BrassTune 無法確認伺服器登出；使用共用裝置前請連線重試。"}}
    } },
    "The score could not be imported, and BrassTune could not remove its copied file. The copied file remains on this device." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"تعذر استيراد النوتة أو إزالة الملف المنسوخ. يبقى الملف المنسوخ على هذا الجهاز."}},"de":{"stringUnit":{"state":"translated","value":"Die Noten konnten nicht importiert und die Kopie nicht entfernt werden. Die Kopie bleibt auf diesem Gerät."}},"en":{"stringUnit":{"state":"translated","value":"The score could not be imported, and BrassTune could not remove its copied file. The copied file remains on this device."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo importar la partitura ni eliminar la copia. El archivo copiado permanece en este dispositivo."}},"fr":{"stringUnit":{"state":"translated","value":"La partition n’a pas pu être importée ni sa copie supprimée. Le fichier copié reste sur cet appareil."}},"ja":{"stringUnit":{"state":"translated","value":"楽譜を読み込めず、コピーしたファイルも削除できませんでした。コピーはこのデバイスに残っています。"}},"ko":{"stringUnit":{"state":"translated","value":"악보를 가져오거나 복사 파일을 삭제하지 못했습니다. 복사된 파일은 이 기기에 남아 있습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível importar a partitura nem remover a cópia. O arquivo copiado permanece neste dispositivo."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось импортировать партитуру и удалить ее копию. Скопированный файл остается на устройстве."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể nhập bản nhạc hoặc xóa tệp đã sao chép. Tệp sao chép vẫn còn trên thiết bị."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法导入乐谱，也无法移除其副本。复制的文件仍保留在此设备上。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法匯入樂譜，也無法移除其副本。複製的檔案仍保留在此裝置上。"}}
    } },
    "Signed in with Apple." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"تم تسجيل الدخول عبر Apple."}},"de":{"stringUnit":{"state":"translated","value":"Mit Apple angemeldet."}},"en":{"stringUnit":{"state":"translated","value":"Signed in with Apple."}},"es":{"stringUnit":{"state":"translated","value":"Sesión iniciada con Apple."}},"fr":{"stringUnit":{"state":"translated","value":"Connecté avec Apple."}},"ja":{"stringUnit":{"state":"translated","value":"Appleでサインインしました。"}},"ko":{"stringUnit":{"state":"translated","value":"Apple로 로그인했습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sessão iniciada com a Apple."}},"ru":{"stringUnit":{"state":"translated","value":"Вход через Apple выполнен."}},"vi":{"stringUnit":{"state":"translated","value":"Đã đăng nhập bằng Apple."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已使用 Apple 登录。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已使用 Apple 登入。"}}
    } },
    "Password reset email sent. Check your inbox." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"تم إرسال رسالة إعادة تعيين كلمة المرور. تحقق من بريدك."}},"de":{"stringUnit":{"state":"translated","value":"E-Mail zum Zurücksetzen gesendet. Prüfe deinen Posteingang."}},"en":{"stringUnit":{"state":"translated","value":"Password reset email sent. Check your inbox."}},"es":{"stringUnit":{"state":"translated","value":"Se envió el correo para restablecer la contraseña. Revisa tu bandeja."}},"fr":{"stringUnit":{"state":"translated","value":"E-mail de réinitialisation envoyé. Consultez votre boîte de réception."}},"ja":{"stringUnit":{"state":"translated","value":"パスワード再設定メールを送信しました。受信トレイを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"비밀번호 재설정 이메일을 보냈습니다. 받은편지함을 확인하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"E-mail de redefinição enviado. Confira sua caixa de entrada."}},"ru":{"stringUnit":{"state":"translated","value":"Письмо для сброса пароля отправлено. Проверьте входящие."}},"vi":{"stringUnit":{"state":"translated","value":"Đã gửi email đặt lại mật khẩu. Hãy kiểm tra hộp thư."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"密码重置邮件已发送。请检查收件箱。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"密碼重設郵件已傳送。請檢查收件匣。"}}
    } },
