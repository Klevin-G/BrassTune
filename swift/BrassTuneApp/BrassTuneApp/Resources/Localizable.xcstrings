    "Repeat stable long tones and hold each pitch through the release." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كرر النغمات الطويلة الثابتة وحافظ على كل طبقة صوتية حتى نهاية النغمة."
          }
        },
        "de" : {
          "stringUnit" : {
