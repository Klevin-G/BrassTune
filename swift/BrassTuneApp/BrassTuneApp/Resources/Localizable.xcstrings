    "See what you did today, how this week is going, and what to try next." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد ما أنجزته اليوم، وكيف يسير هذا الأسبوع، وما يمكنك تجربته بعد ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, was du heute geschafft hast, wie diese Woche läuft und was du als Nächstes versuchen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See what you did today, how this week is going, and what to try next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira lo que hiciste hoy, cómo va la semana y qué probar después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrez ce que vous avez fait aujourd’hui, comment se passe la semaine et quoi essayer ensuite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日取り組んだこと、今週の進み具合、次に試すことを確認できます。"
          }
        },
        "ko" : {
