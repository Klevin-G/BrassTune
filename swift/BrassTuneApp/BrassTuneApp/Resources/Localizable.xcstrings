        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ～ 32 の音符を追加します。表示されている移動ボタンを使用して順番に並べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1~32개의 메모를 추가합니다. 눈에 보이는 이동 버튼을 사용하여 순서대로 배치하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
