    "Tap Record take to save audio." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"اضغط «تسجيل مقطع» لحفظ الصوت."}},"de":{"stringUnit":{"state":"translated","value":"Tippe auf „Take aufnehmen“, um Audio zu speichern."}},"en":{"stringUnit":{"state":"translated","value":"Tap Record take to save audio."}},"es":{"stringUnit":{"state":"translated","value":"Toca Grabar toma para guardar el audio."}},"fr":{"stringUnit":{"state":"translated","value":"Touchez Enregistrer une prise pour sauvegarder l’audio."}},"ja":{"stringUnit":{"state":"translated","value":"「テイクを録音」をタップして音声を保存します。"}},"ko":{"stringUnit":{"state":"translated","value":"오디오를 저장하려면 테이크 녹음을 탭하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Toque em Gravar take para salvar o áudio."}},"ru":{"stringUnit":{"state":"translated","value":"Нажмите «Записать дубль», чтобы сохранить аудио."}},"vi":{"stringUnit":{"state":"translated","value":"Chạm Ghi bản thu để lưu âm thanh."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"轻点“录制片段”以保存音频。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"點一下「錄製片段」以儲存音訊。"}}}} ,
    "Temperament" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"نظام الضبط"}},"de":{"stringUnit":{"state":"translated","value":"Stimmung"}},"en":{"stringUnit":{"state":"translated","value":"Temperament"}},"es":{"stringUnit":{"state":"translated","value":"Temperamento"}},"fr":{"stringUnit":{"state":"translated","value":"Tempérament"}},"ja":{"stringUnit":{"state":"translated","value":"音律"}},"ko":{"stringUnit":{"state":"translated","value":"음률"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Temperamento"}},"ru":{"stringUnit":{"state":"translated","value":"Строй"}},"vi":{"stringUnit":{"state":"translated","value":"Hệ thống chỉnh âm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"律制"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"律制"}}}} ,
    "This scale does not fit the selected instrument range. Choose another key or scale type." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"هذا السلم لا يناسب نطاق الآلة المختارة. اختر مفتاحًا أو نوع سلم آخر."}},"de":{"stringUnit":{"state":"translated","value":"Diese Tonleiter passt nicht in den Tonumfang des ausgewählten Instruments. Wähle eine andere Tonart oder Tonleiterart."}},"en":{"stringUnit":{"state":"translated","value":"This scale does not fit the selected instrument range. Choose another key or scale type."}},"es":{"stringUnit":{"state":"translated","value":"Esta escala no se ajusta al registro del instrumento seleccionado. Elige otra tonalidad o tipo de escala."}},"fr":{"stringUnit":{"state":"translated","value":"Cette gamme ne convient pas à l’étendue de l’instrument sélectionné. Choisis une autre tonalité ou un autre type de gamme."}},"ja":{"stringUnit":{"state":"translated","value":"この音階は選択した楽器の音域に合いません。別の調または音階の種類を選んでください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 음계는 선택한 악기의 음역에 맞지 않습니다. 다른 조성이나 음계 유형을 선택하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta escala não cabe na extensão do instrumento selecionado. Escolha outra tonalidade ou tipo de escala."}},"ru":{"stringUnit":{"state":"translated","value":"Эта гамма не подходит для диапазона выбранного инструмента. Выберите другую тональность или тип гаммы."}},"vi":{"stringUnit":{"state":"translated","value":"Thang âm này không phù hợp với quãng âm của nhạc cụ đã chọn. Hãy chọn giọng hoặc loại thang âm khác."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该音阶不适合所选乐器的音域。请选择其他调或音阶类型。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此音階不適合所選樂器的音域。請選擇其他調或音階類型。"}}}} ,
    "Today, this week, and what to try next." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"اليوم، هذا الأسبوع، وما الذي ستجربه لاحقًا."}},"de":{"stringUnit":{"state":"translated","value":"Heute, diese Woche und was du als Nächstes ausprobieren kannst."}},"en":{"stringUnit":{"state":"translated","value":"Today, this week, and what to try next."}},"es":{"stringUnit":{"state":"translated","value":"Hoy, esta semana y qué probar después."}},"fr":{"stringUnit":{"state":"translated","value":"Aujourd’hui, cette semaine et quoi essayer ensuite."}},"ja":{"stringUnit":{"state":"translated","value":"今日、今週、次に試すこと。"}},"ko":{"stringUnit":{"state":"translated","value":"오늘, 이번 주, 그리고 다음에 해 볼 것."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Hoje, esta semana e o que tentar depois."}},"ru":{"stringUnit":{"state":"translated","value":"Сегодня, на этой неделе и что попробовать дальше."}},"vi":{"stringUnit":{"state":"translated","value":"Hôm nay, tuần này và điều nên thử tiếp theo."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"今天、本周，以及下一步可以尝试什么。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"今天、本週，以及下一步可以嘗試什麼。"}}}} ,
    "Tune, build steady habits, and keep track of your practice." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"اضبط آلتك، وابنِ عادات ثابتة، وتابع تمرينك."}},"de":{"stringUnit":{"state":"translated","value":"Stimme dein Instrument, baue feste Gewohnheiten auf und behalte deine Übung im Blick."}},"en":{"stringUnit":{"state":"translated","value":"Tune, build steady habits, and keep track of your practice."}},"es":{"stringUnit":{"state":"translated","value":"Afina, crea hábitos constantes y sigue tu práctica."}},"fr":{"stringUnit":{"state":"translated","value":"Accorde-toi, crée des habitudes régulières et suis tes entraînements."}},"ja":{"stringUnit":{"state":"translated","value":"チューニングし、安定した習慣を作り、練習を記録しましょう。"}},"ko":{"stringUnit":{"state":"translated","value":"튜닝하고, 꾸준한 습관을 만들고, 연습을 기록하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Afine, crie hábitos constantes e acompanhe sua prática."}},"ru":{"stringUnit":{"state":"translated","value":"Настраивайте инструмент, вырабатывайте привычки и отслеживайте занятия."}},"vi":{"stringUnit":{"state":"translated","value":"Lên dây, xây dựng thói quen đều đặn và theo dõi việc luyện tập."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"调音、建立稳定习惯，并跟踪你的练习。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"調音、建立穩定習慣，並追蹤你的練習。"}}}} ,
    "Voicing" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"تشكيل الصوت"}},"de":{"stringUnit":{"state":"translated","value":"Tonbildung"}},"en":{"stringUnit":{"state":"translated","value":"Voicing"}},"es":{"stringUnit":{"state":"translated","value":"Emisión"}},"fr":{"stringUnit":{"state":"translated","value":"Émission du son"}},"ja":{"stringUnit":{"state":"translated","value":"発音"}},"ko":{"stringUnit":{"state":"translated","value":"발음"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Emissão"}},"ru":{"stringUnit":{"state":"translated","value":"Звукоизвлечение"}},"vi":{"stringUnit":{"state":"translated","value":"Tạo âm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"发音"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"發音"}}}} ,
    "Volume is safely limited to 90 percent." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"يتم تحديد مستوى الصوت بأمان عند 90 بالمئة."}},"de":{"stringUnit":{"state":"translated","value":"Die Lautstärke ist sicher auf 90 Prozent begrenzt."}},"en":{"stringUnit":{"state":"translated","value":"Volume is safely limited to 90 percent."}},"es":{"stringUnit":{"state":"translated","value":"El volumen está limitado de forma segura al 90 por ciento."}},"fr":{"stringUnit":{"state":"translated","value":"Le volume est limité en toute sécurité à 90 pour cent."}},"ja":{"stringUnit":{"state":"translated","value":"音量は安全のため90パーセントに制限されています。"}},"ko":{"stringUnit":{"state":"translated","value":"볼륨은 안전을 위해 90퍼센트로 제한됩니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O volume é limitado com segurança a 90 por cento."}},"ru":{"stringUnit":{"state":"translated","value":"Громкость безопасно ограничена 90 процентами."}},"vi":{"stringUnit":{"state":"translated","value":"Âm lượng được giới hạn an toàn ở 90 phần trăm."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"音量为安全起见限制在 90%。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"音量為安全起見限制在 90%。"}}}} ,
    "Written notes" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"النغمات المكتوبة"}},"de":{"stringUnit":{"state":"translated","value":"Geschriebene Noten"}},"en":{"stringUnit":{"state":"translated","value":"Written notes"}},"es":{"stringUnit":{"state":"translated","value":"Notas escritas"}},"fr":{"stringUnit":{"state":"translated","value":"Notes écrites"}},"ja":{"stringUnit":{"state":"translated","value":"記譜された音"}},"ko":{"stringUnit":{"state":"translated","value":"기보된 음"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Notas escritas"}},"ru":{"stringUnit":{"state":"translated","value":"Записанные ноты"}},"vi":{"stringUnit":{"state":"translated","value":"Nốt viết"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"写出的音符"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"寫出的音符"}}}} ,
    "Written notes: %@" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"النغمات المكتوبة: %@"}},"de":{"stringUnit":{"state":"translated","value":"Geschriebene Noten: %@"}},"en":{"stringUnit":{"state":"translated","value":"Written notes: %@"}},"es":{"stringUnit":{"state":"translated","value":"Notas escritas: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Notes écrites : %@"}},"ja":{"stringUnit":{"state":"translated","value":"記譜された音: %@"}},"ko":{"stringUnit":{"state":"translated","value":"기보된 음: %@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Notas escritas: %@"}},"ru":{"stringUnit":{"state":"translated","value":"Записанные ноты: %@"}},"vi":{"stringUnit":{"state":"translated","value":"Nốt viết: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"写出的音符：%@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"寫出的音符：%@"}}}} ,
    "Your guest practice stays on this device." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"يبقى تمرينك كضيف على هذا الجهاز."}},"de":{"stringUnit":{"state":"translated","value":"Deine Gastübungen bleiben auf diesem Gerät."}},"en":{"stringUnit":{"state":"translated","value":"Your guest practice stays on this device."}},"es":{"stringUnit":{"state":"translated","value":"Tu práctica como invitado permanece en este dispositivo."}},"fr":{"stringUnit":{"state":"translated","value":"Tes entraînements en invité restent sur cet appareil."}},"ja":{"stringUnit":{"state":"translated","value":"ゲストとしての練習はこのデバイスに保存されます。"}},"ko":{"stringUnit":{"state":"translated","value":"게스트 연습은 이 기기에 유지됩니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sua prática como convidado fica neste dispositivo."}},"ru":{"stringUnit":{"state":"translated","value":"Ваши гостевые занятия остаются на этом устройстве."}},"vi":{"stringUnit":{"state":"translated","value":"Bài luyện tập của khách chỉ lưu trên thiết bị này."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的访客练习会保留在此设备上。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"你的訪客練習會保留在此裝置上。"}}}} ,
