    "Microphone access is off": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف الوصول إلى الميكروفون"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonzugriff ist deaktiviert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al micrófono está desactivado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au microphone est désactivé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクアクセスがオフになっています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 액세스가 사용 중지되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone está desativado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к микрофону отключен"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập micrô bị tắt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风访问已关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風存取已關閉"
          }
        }
      }
    },
    "Microphone access is off. Allow it in Settings, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الميكروفون متوقف. اسمح به في الإعدادات ثم حاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonzugriff ist aus. Erlaube ihn in den Einstellungen und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is off. Allow it in Settings, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al micrófono está desactivado. Permítelo en Ajustes e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au microphone est désactivé. Autorisez-le dans Réglages, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスがオフです。設定で許可して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근이 꺼져 있습니다. 설정에서 허용한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone está desativado. Permita-o nos Ajustes e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к микрофону выключен. Разрешите его в Настройках и повторите попытку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập micrô đang tắt. Hãy cho phép trong Cài đặt rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风访问已关闭。请在“设置”中允许，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風存取已關閉。請在「設定」中允許，然後重試。"
          }
        }
      }
    },
    "Most bands use A4 = 440 Hz. Change this only if your director asks you to.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم معظم النطاقات A4 = 440 هرتز. قم بتغيير هذا فقط إذا طلب منك مديرك ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten Bänder verwenden A4 = 440 Hz. Ändern Sie dies nur, wenn Ihr Direktor Sie dazu auffordert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most bands use A4 = 440 Hz. Change this only if your director asks you to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de las bandas utilizan A4 = 440 Hz. Cambie esto sólo si su director se lo pide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des bandes utilisent A4 = 440 Hz. Changez cela uniquement si votre directeur vous le demande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんどの帯域は A4 = 440 Hz を使用します。これは、ディレクターから要求された場合にのみ変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 대역은 A4 = 440Hz를 사용합니다. 감독이 요청하는 경우에만 이를 변경하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A maioria das bandas usa A4 = 440 Hz. Altere isso apenas se o seu diretor solicitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большинство диапазонов используют A4 = 440 Гц. Меняйте это только в том случае, если ваш директор попросит вас об этом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hầu hết các băng tần đều sử dụng A4 = 440 Hz. Chỉ thay đổi điều này nếu giám đốc yêu cầu bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大多数频段使用 A4 = 440 Hz。仅当您的主管要求您时才更改此设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大多數頻段使用 A4 = 440 Hz。僅當您的主管要求您時才更改此設定。"
          }
        }
      }
    },
