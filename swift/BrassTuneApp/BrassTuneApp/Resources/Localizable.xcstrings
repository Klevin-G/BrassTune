    "Save every tempo, meter, subdivision, sound, haptic, and volume setting together.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ كل إعدادات الإيقاع والعداد والتقسيم الفرعي والصوت واللمس ومستوى الصوت معًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie alle Tempo-, Takt-, Unterteilungs-, Klang-, Haptik- und Lautstärkeeinstellungen zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save every tempo, meter, subdivision, sound, haptic, and volume setting together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde todos los ajustes de tempo, metro, subdivisión, sonido, háptica y volumen juntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez tous les paramètres de tempo, de mesure, de subdivision, de son, d'haptique et de volume ensemble."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのテンポ、メーター、サブディビジョン、サウンド、ハプティック、ボリューム設定をまとめて保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 템포, 미터, 세분화, 사운드, 햅틱 및 볼륨 설정을 함께 저장하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve todas as configurações de andamento, medidor, subdivisão, som, sensação tátil e volume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните вместе все настройки темпа, метра, подразделения, звука, тактильных ощущений и громкости."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu mọi cài đặt nhịp độ, mét, phân chia, âm thanh, xúc giác và âm lượng cùng nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将每个速度、节拍、细分、声音、触觉和音量设置保存在一起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將每個速度、節拍、細分、聲音、觸覺和音量設定保存在一起。"
          }
        }
      }
    },
