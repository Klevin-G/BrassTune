          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Центы показывают небольшое отклонение от центра ноты."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cent cho biết độ lệch nhỏ so với tâm nốt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
