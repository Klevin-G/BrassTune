    "Practice history, imported sheet music, and saved sign-in information will be deleted from this device. This can't be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف سجل التدريبات والنوتة الموسيقية المستوردة ومعلومات تسجيل الدخول المحفوظة من هذا الجهاز. لا يمكن التراجع عن هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Übungsverlauf, importierte Noten und gespeicherte Anmeldeinformationen werden von diesem Gerät gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice history, imported sheet music, and saved sign-in information will be deleted from this device. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de práctica, las partituras importadas y la información de inicio de sesión guardada se eliminarán de este dispositivo. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique des entraînements, les partitions importées et les informations de connexion enregistrées seront supprimés de cet appareil. Cela ne peut pas être annulé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "練習履歴、取り込んだ楽譜、保存されているサインイン情報が本機から削除されます。これを元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연습 내역, 가져온 악보, 저장된 로그인 정보가 이 기기에서 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de treinos, partituras importadas e informações de login salvas serão excluídos deste dispositivo. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История тренировок, импортированные ноты и сохраненная информация для входа в систему будут удалены с этого устройства. Это невозможно отменить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử luyện tập, bản nhạc đã nhập và thông tin đăng nhập đã lưu sẽ bị xóa khỏi thiết bị này. Không thể hoàn tác việc này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "练习历史记录、导入的乐谱和保存的登录信息将从该设备中删除。这无法撤消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "練習歷史記錄、匯入的樂譜和已儲存的登入資訊將從該裝置中刪除。這無法撤消。"
          }
        }
      }
    },
