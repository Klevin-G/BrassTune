    "All practice history and imported sheet music on this device will be deleted. This can't be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف كل سجل التدريبات والنوتة الموسيقية المستوردة على هذا الجهاز. لا يمكن التراجع عن هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gesamte Übungsverlauf und die importierten Noten auf diesem Gerät werden gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All practice history and imported sheet music on this device will be deleted. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todo el historial de práctica y las partituras importadas en este dispositivo. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout l’historique des entraînements et les partitions importées sur cet appareil seront supprimés. Cela ne peut pas être annulé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本機内の練習履歴や取り込んだ楽譜はすべて削除されます。これを元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 있는 모든 연습 내역과 가져온 악보가 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o histórico de prática e partituras importadas neste dispositivo serão excluídos. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся история тренировок и импортированные ноты на этом устройстве будут удалены. Это невозможно отменить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả lịch sử luyện tập và bản nhạc đã nhập trên thiết bị này sẽ bị xóa. Không thể hoàn tác việc này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备上的所有练习历史记录和导入的乐谱都将被删除。这无法撤消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該設備上的所有練習歷史記錄和匯入的樂譜都將被刪除。這無法撤消。"
          }
        }
      }
    },
    "Allow microphone access in iOS Settings, then come back and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الميكروفون في إعدادات iOS، ثم عد وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie den Mikrofonzugriff in den iOS-Einstellungen, kehren Sie dann zurück und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access in iOS Settings, then come back and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita el acceso al micrófono en la configuración de iOS, luego regrese e inténtelo nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès au microphone dans les paramètres iOS, puis revenez et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 設定でマイクへのアクセスを許可してから、戻って再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정에서 마이크 액세스를 허용한 후 돌아와서 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao microfone nas configurações do iOS, volte e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к микрофону в настройках iOS, затем вернитесь и повторите попытку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập micrô trong Cài đặt iOS, sau đó quay lại và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 设置中允许访问麦克风，然后返回并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 設定中允許存取麥克風，然後返回並重試。"
          }
        }
      }
    },
