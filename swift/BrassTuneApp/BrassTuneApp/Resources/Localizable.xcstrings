          }
        }
      }
    },
    "Keep a steady beat while you practice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على إيقاع ثابت أثناء التدرب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie beim Üben einen gleichmäßigen Takt ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a steady beat while you practice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén un ritmo constante mientras practicas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez un rythme régulier pendant que vous pratiquez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "練習中は安定したビートを維持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연습하는 동안 일정한 박자를 유지하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha uma batida constante enquanto pratica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время тренировки сохраняйте ровный ритм."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nhịp đều đặn trong khi luyện tập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "练习时保持稳定的节奏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "練習時保持穩定的節奏。"
          }
        }
      }
    },
    "Keep going. Slow, even air will help.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمر. ببطء، حتى الهواء سوف يساعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach weiter. Langsames, gleichmäßiges Lüften hilft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep going. Slow, even air will help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue adelante. El aire lento y uniforme ayudará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez. L'air lent et uniforme aidera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けてください。ゆっくりと均一な空気を入れると効果的です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하세요. 천천히, 고른 공기가 도움이 될 것입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue. O ar lento e uniforme ajudará."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте. Медленно, даже воздух поможет."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục đi. Chậm rãi, không khí đều sẽ giúp ích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续。慢慢地，即使是空气也会有所帮助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續。慢慢地，即使是空氣也會有所幫助。"
          }
        }
      }
    },
