        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 계정 서비스에서 로그인을 새로 고칠 수 없습니다. 저장된 세션은 나중에 다시 시도됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de conta não conseguiu atualizar seu login no momento. Sua sessão salva será repetida mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
