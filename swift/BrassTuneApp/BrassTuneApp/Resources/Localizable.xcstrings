    "Add 1–32 notes. Use the visible move buttons to put them in order.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف 1–32 ملاحظة. استخدم أزرار الحركة المرئية لترتيبها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie 1–32 Noten hinzu. Verwenden Sie die sichtbaren Verschiebeschaltflächen, um sie zu ordnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add 1–32 notes. Use the visible move buttons to put them in order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue de 1 a 32 notas. Utilice los botones de movimiento visibles para ponerlos en orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez 1 à 32 notes. Utilisez les boutons de déplacement visibles pour les mettre en ordre."
          }
