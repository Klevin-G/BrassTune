    "Your account was deleted. BrassTune will retry removing its remaining local data the next time the app opens." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حذف حسابك. سيعيد BrassTune محاولة إزالة البيانات المحلية المتبقية عند فتح التطبيق في المرة القادمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
