          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement n'est plus sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この録音はこのデバイスにはもうありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 녹음은 더 이상 이 기기에 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
