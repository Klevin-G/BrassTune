    "Guest practice remains on this device. An optional account lets you sign in on this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظل ممارسة الضيف على هذا الجهاز. يتيح لك الحساب الاختياري تسجيل الدخول على هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gasttraining bleibt auf diesem Gerät bestehen. Mit einem optionalen Konto können Sie sich auf diesem Gerät anmelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guest practice remains on this device. An optional account lets you sign in on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La práctica de los invitados permanece en este dispositivo. Una cuenta opcional le permite iniciar sesión en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pratique des invités reste sur cet appareil. Un compte facultatif vous permet de vous connecter sur cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲストの練習はこのデバイスに残ります。オプションのアカウントを使用すると、このデバイスにサインインできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게스트 연습은 이 기기에 남아 있습니다. 선택적 계정을 사용하면 이 장치에 로그인할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A prática do convidado permanece neste dispositivo. Uma conta opcional permite fazer login neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гостевая практика сохраняется на этом устройстве. Дополнительная учетная запись позволяет вам войти в систему на этом устройстве."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thực hành của khách vẫn còn trên thiết bị này. Tài khoản tùy chọn cho phép bạn đăng nhập trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "访客练习仍保留在此设备上。可选帐户可让您登录此设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訪客練習仍保留在此設備上。可選帳戶可讓您登入此裝置。"
          }
        }
      }
    },
    "Guest practice remains on this device. Create an account to back up progress and join Classes." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى تدريبات الضيف على هذا الجهاز. أنشئ حسابًا لنسخ تقدمك احتياطيًا والانضمام إلى الصفوف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gastübungen bleiben auf diesem Gerät. Erstelle ein Konto, um deinen Fortschritt zu sichern und Klassen beizutreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guest practice remains on this device. Create an account to back up progress and join Classes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La práctica como invitado permanece en este dispositivo. Crea una cuenta para guardar tu progreso y unirte a las clases."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pratique en mode invité reste sur cet appareil. Créez un compte pour sauvegarder votre progression et rejoindre des classes."
          }
        },
        "ja" : {
          "stringUnit" : {
