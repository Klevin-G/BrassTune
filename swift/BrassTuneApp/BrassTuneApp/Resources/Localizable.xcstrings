    "You found the center often. Keep building that steady sound." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصلت إلى مركز النغمة كثيرًا. واصل بناء ذلك الصوت الثابت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast die Tonmitte oft getroffen. Baue diesen stabilen Klang weiter aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You found the center often. Keep building that steady sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontraste el centro a menudo. Sigue desarrollando ese sonido estable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez souvent trouvé le centre. Continuez à construire ce son stable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音の中心を何度も捉えました。その安定した響きを伸ばしていきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음의 중심을 자주 찾았습니다. 그 안정적인 소리를 계속 키워 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você encontrou o centro muitas vezes. Continue desenvolvendo esse som estável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы часто попадали в центр ноты. Продолжайте развивать ровное звучание."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn thường xuyên tìm đúng tâm nốt. Hãy tiếp tục xây dựng âm thanh ổn định đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你经常找到音准中心。继续培养这种稳定的声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你經常找到音準中心。繼續培養這種穩定的聲音。"
          }
        }
      }
    },
    "You're offline. BrassTune kept your unexpired sign-in for local practice; online account features may be unavailable." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت غير متصل. احتفظ BrassTune بتسجيل دخولك غير المنتهي للتدريب المحلي؛ قد لا تتوفر ميزات الحساب عبر الإنترنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. BrassTune behält deine noch gültige Anmeldung für lokales Üben; Online-Kontofunktionen sind eventuell nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're offline. BrassTune kept your unexpired sign-in for local practice; online account features may be unavailable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes conexión. BrassTune conservó tu sesión vigente para la práctica local; las funciones en línea pueden no estar disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors ligne. BrassTune a conservé votre connexion valide pour le travail local; les fonctions en ligne peuvent être indisponibles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインです。ローカル練習のため有効なサインインを保持しました。オンライン機能は利用できない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인입니다. 로컬 연습을 위해 만료되지 않은 로그인을 유지했으며 온라인 계정 기능은 사용할 수 없을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está off-line. O BrassTune manteve seu login válido para prática local; os recursos on-line podem estar indisponíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет подключения. BrassTune сохранил действующий вход для локальных занятий; онлайн-функции могут быть недоступны."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đang ngoại tuyến. BrassTune giữ đăng nhập còn hiệu lực để luyện tập cục bộ; tính năng trực tuyến có thể không khả dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你当前离线。BrassTune 保留了尚未过期的登录以供本地练习；在线账户功能可能不可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你目前離線。BrassTune 保留了尚未過期的登入以供本機練習；線上帳戶功能可能無法使用。"
          }
        }
      }
    },
