            "value": "Rejoindre un autre cours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のクラスに参加する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 클래스에 참여하기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Participe de outra turma"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Присоединяйтесь к другому классу"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tham gia một lớp học khác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入另一个班级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入另一個班級"
          }
        }
      }
    },
    "Join more than one class, switch between them, or leave a class without changing your practice setup.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انضم إلى أكثر من فصل دراسي واحد، أو قم بالتبديل بينهم، أو اترك فصلًا دراسيًا دون تغيير إعداد التدريب الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treten Sie mehr als einer Klasse bei, wechseln Sie zwischen ihnen oder verlassen Sie eine Klasse, ohne Ihre Übungseinrichtung zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join more than one class, switch between them, or leave a class without changing your practice setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únase a más de una clase, cambie entre ellas o abandone una clase sin cambiar la configuración de su práctica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez plusieurs cours, basculez entre eux ou quittez un cours sans modifier la configuration de votre pratique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "練習設定を変更せずに、複数のクラスに参加したり、クラスを切り替えたり、クラスを退席したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나 이상의 클래스에 참여하거나, 클래스 간에 전환하거나, 연습 설정을 변경하지 않고 클래스을 나가세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Participe de mais de uma aula, alterne entre elas ou saia de uma aula sem alterar a configuração do seu treino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Присоединяйтесь к нескольким классам, переключайтесь между ними или покидайте класс, не меняя настройки практики."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tham gia nhiều lớp, chuyển đổi giữa các lớp hoặc rời khỏi một lớp mà không thay đổi thiết lập thực hành của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入多个班级、在班级之间切换或离开班级，而无需更改练习设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入多個班級、在班級之間切換或離開班級，而無需更改練習設定。"
          }
        }
      }
    },
    "Joining a class won't change your tuner, instrument, or practice history.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يؤدي الانضمام إلى الفصل إلى تغيير الموالف أو الآلة أو تاريخ التدريب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch die Teilnahme an einem Kurs ändert sich nichts an Ihrem Stimmgerät, Ihrem Instrument oder Ihrem Übungsverlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joining a class won't change your tuner, instrument, or practice history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unirse a una clase no cambiará su afinador, instrumento o historial de práctica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoindre un cours ne changera pas votre accordeur, votre instrument ou votre historique de pratique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラスに参加しても、チューナー、楽器、練習歴は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클래스에 참여해도 튜너, 악기 또는 연습 내역은 변경되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Participar de uma aula não mudará seu afinador, instrumento ou histórico de prática."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Присоединение к классу не изменит ваш тюнер, инструмент или историю тренировок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc tham gia lớp học sẽ không thay đổi lịch sử bộ chỉnh, nhạc cụ hoặc lịch sử luyện tập của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入班级不会改变您的调音师、乐器或练习历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入班級不會改變您的調音師、樂器或練習歷史。"
          }
        }
      }
    },
    "Jot notes for the tricky spots.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتدوين الملاحظات حول النقاط الصعبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
