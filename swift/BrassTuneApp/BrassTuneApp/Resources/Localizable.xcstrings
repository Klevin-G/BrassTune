          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сыграйте удобную ноту, найдите центр и сохраните результат."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chơi một nốt thoải mái, tìm đúng tâm âm rồi lưu kết quả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
