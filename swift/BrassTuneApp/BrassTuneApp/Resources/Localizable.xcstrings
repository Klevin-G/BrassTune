            "value": "Делайте заметки для сложных мест."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú cho những điểm khó khăn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为棘手的地方记下笔记。"
          }
        },
        "zh-Hant": {
