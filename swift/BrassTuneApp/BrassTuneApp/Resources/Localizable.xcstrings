    "%@ cents flat — lift up": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ سنت أخفض من المطلوب — ارفع الطبقة قليلًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Cent zu tief — etwas höher"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cents flat — lift up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cents por debajo — sube un poco"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cents trop bas — montez légèrement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@セント低め — 少し上げましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@센트 낮음 — 조금 높이세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cents abaixo — suba um pouco"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ центов ниже — немного поднимите"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cent thấp — nâng lên một chút"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 音分偏低 — 稍微提高"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 音分偏低 — 稍微提高"
          }
        }
      }
    },
    "%@ cents sharp — ease down": {
