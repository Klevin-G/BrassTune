    "Save every tempo, meter, subdivision, sound, haptic, and volume setting together." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ جميع إعدادات السرعة والميزان الإيقاعي والتقسيم الإيقاعي والصوت والاهتزاز ومستوى الصوت معًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern Sie alle Tempo-, Taktart-, rhythmischen Unterteilungs-, Klang-, Haptik- und Lautstärkeeinstellungen zusammen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save every tempo, meter, subdivision, sound, haptic, and volume setting together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda juntos todos los ajustes de tempo, compás, subdivisión rítmica, sonido, respuesta háptica y volumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez ensemble tous les réglages de tempo, de mesure, de subdivision rythmique, de son, de retour haptique et de volume sonore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テンポ、拍子、拍の分割、サウンド、触覚フィードバック、音量の各設定をまとめて保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "템포, 박자, 박 세분, 소리, 햅틱 및 음량 설정을 함께 저장하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve juntas todas as configurações de andamento, compasso, subdivisão rítmica, som, resposta tátil e volume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните вместе все настройки темпа, размера, деления доли, звука, тактильной отдачи и громкости."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu cùng nhau mọi cài đặt tốc độ, nhịp, phân chia nhịp, âm thanh, phản hồi xúc giác và âm lượng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将速度、拍号、节拍细分、声音、触觉反馈和音量设置一并保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將速度、拍號、節拍細分、聲音、觸覺回饋和音量設定一併儲存。"
          }
        }
      }
    },
