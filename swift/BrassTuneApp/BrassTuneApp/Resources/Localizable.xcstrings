    "Play a note and BrassTune will show whether it is flat, in tune, or sharp.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعزف نغمة وسيعرض BrassTune ما إذا كانت منخفضة أو مضبوطة أو مرتفعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele eine Note; BrassTune zeigt, ob sie zu tief, richtig oder zu hoch ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a note and BrassTune will show whether it is flat, in tune, or sharp."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una nota y BrassTune mostrará si está baja, afinada o alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez une note; BrassTune indique si elle est trop basse, juste ou trop haute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音を出すと、低い・合っている・高いのどれかをBrassTuneが表示します。"
