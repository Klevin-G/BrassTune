          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ tài khoản không thể làm mới thông tin đăng nhập của bạn ngay bây giờ. Phiên đã lưu của bạn sẽ được thử lại sau."
