        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune kann kein Mikrofon hören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune can't hear a microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune no puede oír un micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune n'entend pas de microphone."
