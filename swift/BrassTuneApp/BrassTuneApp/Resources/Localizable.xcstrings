    "Choose whether BrassTune gives a subtle confirmation after saving practice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما إذا كان BrassTune سيقدّم تأكيدًا لطيفًا بعد حفظ التدريب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, ob BrassTune nach dem Speichern einer Übung eine dezente Bestätigung gibt."
