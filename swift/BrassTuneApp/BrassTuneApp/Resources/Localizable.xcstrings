    "Enter a valid username using letters, numbers, underscores, or hyphens." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"أدخل اسم مستخدم صالحًا باستخدام الأحرف أو الأرقام أو الشرطات السفلية أو الواصلات."}},"de":{"stringUnit":{"state":"translated","value":"Gib einen gültigen Benutzernamen mit Buchstaben, Zahlen, Unter- oder Bindestrichen ein."}},"en":{"stringUnit":{"state":"translated","value":"Enter a valid username using letters, numbers, underscores, or hyphens."}},"es":{"stringUnit":{"state":"translated","value":"Escribe un usuario válido con letras, números, guiones bajos o guiones."}},"fr":{"stringUnit":{"state":"translated","value":"Saisissez un nom d’utilisateur valide avec des lettres, chiffres, tirets bas ou tirets."}},"ja":{"stringUnit":{"state":"translated","value":"英字、数字、アンダースコア、ハイフンを使った有効なユーザー名を入力してください。"}},"ko":{"stringUnit":{"state":"translated","value":"문자, 숫자, 밑줄 또는 하이픈을 사용한 올바른 사용자 이름을 입력하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Digite um nome de usuário válido com letras, números, sublinhados ou hífens."}},"ru":{"stringUnit":{"state":"translated","value":"Введите допустимое имя пользователя из букв, цифр, подчёркиваний или дефисов."}},"vi":{"stringUnit":{"state":"translated","value":"Nhập tên người dùng hợp lệ bằng chữ, số, dấu gạch dưới hoặc gạch nối."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入由字母、数字、下划线或连字符组成的有效用户名。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請輸入由字母、數字、底線或連字號組成的有效使用者名稱。"}}}},
