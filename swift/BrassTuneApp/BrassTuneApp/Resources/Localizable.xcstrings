    "Listen first, then match the reference gently. Headphones help keep the speaker tone out of the microphone." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع أولًا، ثم طابق النغمة المرجعية برفق. تساعد سماعات الرأس على منع وصول نغمة مكبر الصوت إلى الميكروفون."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hören Sie zuerst zu und gleichen Sie dann vorsichtig den Referenzton ab. Kopfhörer verhindern, dass der Lautsprecherton ins Mikrofon gelangt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listen first, then match the reference gently. Headphones help keep the speaker tone out of the microphone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha primero y luego iguala suavemente el tono de referencia. Los auriculares evitan que el tono del altavoz entre en el micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoutez d’abord, puis accordez-vous doucement sur le son de référence. Un casque empêche le son du haut-parleur d’entrer dans le microphone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず基準音を聞き、その音程にやさしく合わせます。ヘッドフォンを使うと、スピーカーの基準音がマイクに入るのを防げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 기준음을 듣고 그 음정에 부드럽게 맞춰 보세요. 헤드폰을 사용하면 스피커의 기준음이 마이크에 들어가는 것을 막을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouça primeiro e depois iguale suavemente o tom de referência. Os fones de ouvido evitam que o tom do alto-falante entre no microfone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала прослушайте эталонный тон, затем мягко подстройтесь под его высоту. Наушники не дают звуку из динамика попасть в микрофон."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy nghe trước, rồi nhẹ nhàng khớp cao độ với âm tham chiếu. Tai nghe giúp âm từ loa không lọt vào micrô."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先聆听参考音，再轻柔地将音高与它匹配。使用耳机可防止扬声器的参考音进入麦克风。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先聽參考音，再輕柔地將音高與它配對。使用耳機可防止揚聲器的參考音進入麥克風。"
          }
        }
      }
    },
    "Listen to the reference before playing." : {
