    "Visual timing advances through the notes without using the microphone or saving a grade." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتقدم التوقيت المرئي من خلال الملاحظات دون استخدام الميكروفون أو حفظ الدرجة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das visuelle Timing schreitet durch die Notizen voran, ohne das Mikrofon zu verwenden oder eine Note zu speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visual timing advances through the notes without using the microphone or saving a grade."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización visual avanza a través de las notas sin usar el micrófono ni guardar una calificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le timing visuel avance à travers les notes sans utiliser le microphone ni enregistrer une note."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクを使用したり成績を保存したりせずに、視覚的なタイミングで音符を進めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크를 사용하거나 성적을 저장하지 않고도 시각적 타이밍이 노트 전체에서 진행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo visual avança pelas notas sem usar o microfone ou salvar uma nota."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Визуальное отсчет времени перемещается по заметкам без использования микрофона и сохранения оценки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian trực quan sẽ tiến triển thông qua các ghi chú mà không cần sử dụng micrô hoặc lưu điểm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视觉计时通过笔记推进，无需使用麦克风或保存成绩。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視覺計時透過筆記推進，無需使用麥克風或保存成績。"
          }
        }
      }
    },
    "Visual timing advances through written note-and-octave targets without a microphone or grade; completed runs are saved as practice time." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتقدم التوقيت المرئي من خلال أهداف النوتة الموسيقية والأوكتاف المكتوبة بدون ميكروفون أو درجة؛ يتم حفظ عمليات التشغيل المكتملة كوقت تدريب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das visuelle Timing wird durch schriftliche Noten- und Oktavvorgaben ohne Mikrofon oder Note vorangetrieben. Abgeschlossene Läufe werden als Übungszeit gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visual timing advances through written note-and-octave targets without a microphone or grade; completed runs are saved as practice time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización visual avanza a través de objetivos escritos de notas y octavas sin micrófono ni calificación; Las carreras completadas se guardan como tiempo de práctica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le timing visuel avance grâce à des cibles écrites de notes et d'octave sans microphone ni note ; les courses terminées sont enregistrées comme temps d’entraînement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクやグレードを使わずに、書かれた音符とオクターブの目標を視覚的にタイミングを進めていきます。完了したランは練習時間として保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크나 등급 없이 작성된 음표 및 옥타브 대상을 통해 시각적 타이밍이 향상됩니다. 완료된 달리기는 연습 시간으로 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo visual avança através de alvos escritos de notas e oitavas sem microfone ou nota; as corridas concluídas são salvas como tempo de prática."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Визуальный тайминг ускоряется с помощью письменных целей в нотах и ​​октавах без микрофона или оценки; завершенные пробежки сохраняются как время тренировки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian trực quan tiến bộ thông qua các mục tiêu nốt và quãng tám được viết mà không cần micrô hoặc điểm; lần chạy hoàn thành được lưu dưới dạng thời gian thực hành."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视觉计时通过书面音符和八度目标进行，无需麦克风或评分；完成的跑步将保存为练习时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視覺計時透過書面音符和八度目標進行，無需麥克風或評分；完成的跑步將保存為練習時間。"
          }
        }
      }
    },
