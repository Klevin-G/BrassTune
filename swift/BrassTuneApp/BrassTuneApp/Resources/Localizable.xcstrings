    "Choose your instrument" : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"اختر آلتك"}},"de":{"stringUnit":{"state":"translated","value":"Wähle dein Instrument"}},"en":{"stringUnit":{"state":"translated","value":"Choose your instrument"}},"es":{"stringUnit":{"state":"translated","value":"Elige tu instrumento"}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez votre instrument"}},"ja":{"stringUnit":{"state":"translated","value":"楽器を選択"}},"ko":{"stringUnit":{"state":"translated","value":"악기 선택"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha seu instrumento"}},"ru":{"stringUnit":{"state":"translated","value":"Выберите инструмент"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn nhạc cụ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择你的乐器"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇你的樂器"}}
    } },
    "BrassTune uses your instrument to show the written notes you expect to see." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"يستخدم BrassTune آلتك لعرض النغمات المكتوبة التي تتوقع رؤيتها."}},"de":{"stringUnit":{"state":"translated","value":"BrassTune zeigt für dein Instrument die erwarteten notierten Töne."}},"en":{"stringUnit":{"state":"translated","value":"BrassTune uses your instrument to show the written notes you expect to see."}},"es":{"stringUnit":{"state":"translated","value":"BrassTune usa tu instrumento para mostrar las notas escritas que esperas ver."}},"fr":{"stringUnit":{"state":"translated","value":"BrassTune utilise votre instrument pour afficher les notes écrites attendues."}},"ja":{"stringUnit":{"state":"translated","value":"BrassTuneは楽器に合わせて、譜面で期待する音名を表示します。"}},"ko":{"stringUnit":{"state":"translated","value":"BrassTune은 선택한 악기에 맞는 기보 음을 표시합니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O BrassTune usa seu instrumento para mostrar as notas escritas esperadas."}},"ru":{"stringUnit":{"state":"translated","value":"BrassTune использует выбранный инструмент, чтобы показывать ожидаемые записанные ноты."}},"vi":{"stringUnit":{"state":"translated","value":"BrassTune dùng nhạc cụ của bạn để hiển thị các nốt được viết như mong đợi."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"BrassTune 会根据你的乐器显示你期望看到的记谱音。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"BrassTune 會根據你的樂器顯示你預期看到的記譜音。"}}
    } },
    "Pick the horn you play now." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"اختر آلة النفخ التي تعزف عليها الآن."}},"de":{"stringUnit":{"state":"translated","value":"Wähle das Blechblasinstrument, das du jetzt spielst."}},"en":{"stringUnit":{"state":"translated","value":"Pick the horn you play now."}},"es":{"stringUnit":{"state":"translated","value":"Elige el instrumento de metal que tocas ahora."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez le cuivre que vous jouez actuellement."}},"ja":{"stringUnit":{"state":"translated","value":"今演奏している金管楽器を選びます。"}},"ko":{"stringUnit":{"state":"translated","value":"현재 연주하는 금관악기를 선택하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha o instrumento de metal que você toca agora."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите медный духовой инструмент, на котором играете сейчас."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn nhạc cụ hơi đồng bạn đang chơi."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择你现在演奏的铜管乐器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇你現在演奏的銅管樂器。"}}
