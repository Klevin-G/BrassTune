    } },
    "Open drone and interval tuning" : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"افتح الضبط بالنغمة المستمرة والفواصل"}},"de":{"stringUnit":{"state":"translated","value":"Bordun- und Intervallstimmung öffnen"}},"en":{"stringUnit":{"state":"translated","value":"Open drone and interval tuning"}},"es":{"stringUnit":{"state":"translated","value":"Abrir afinación con bordón e intervalos"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrir l’accord par bourdon et intervalles"}},"ja":{"stringUnit":{"state":"translated","value":"ドローンと音程のチューニングを開く"}},"ko":{"stringUnit":{"state":"translated","value":"드론 및 음정 튜닝 열기"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abrir afinação com bordão e intervalos"}},"ru":{"stringUnit":{"state":"translated","value":"Открыть настройку по бурдону и интервалам"}},"vi":{"stringUnit":{"state":"translated","value":"Mở chỉnh dây bằng âm nền và quãng"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开持续音与音程调音"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開啟持續音與音程調音"}}
    } },
    "Play a note and BrassTune will show whether it is flat, in tune, or sharp." : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"اعزف نغمة وسيعرض BrassTune ما إذا كانت منخفضة أو مضبوطة أو مرتفعة."}},"de":{"stringUnit":{"state":"translated","value":"Spiele eine Note; BrassTune zeigt, ob sie zu tief, richtig oder zu hoch ist."}},"en":{"stringUnit":{"state":"translated","value":"Play a note and BrassTune will show whether it is flat, in tune, or sharp."}},"es":{"stringUnit":{"state":"translated","value":"Toca una nota y BrassTune mostrará si está baja, afinada o alta."}},"fr":{"stringUnit":{"state":"translated","value":"Jouez une note; BrassTune indique si elle est trop basse, juste ou trop haute."}},"ja":{"stringUnit":{"state":"translated","value":"音を出すと、低い・合っている・高いのどれかをBrassTuneが表示します。"}},"ko":{"stringUnit":{"state":"translated","value":"음을 연주하면 BrassTune이 낮음, 정확함, 높음을 표시합니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Toque uma nota e o BrassTune mostrará se ela está baixa, afinada ou alta."}},"ru":{"stringUnit":{"state":"translated","value":"Сыграйте ноту, и BrassTune покажет, ниже она, точно настроена или выше."}},"vi":{"stringUnit":{"state":"translated","value":"Chơi một nốt và BrassTune sẽ cho biết nốt đó thấp, đúng hay cao."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"演奏一个音，BrassTune 会显示音高偏低、准确或偏高。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"演奏一個音，BrassTune 會顯示音高偏低、準確或偏高。"}}
    } },
    "Play a note" : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"اعزف نغمة"}},"de":{"stringUnit":{"state":"translated","value":"Spiele eine Note"}},"en":{"stringUnit":{"state":"translated","value":"Play a note"}},"es":{"stringUnit":{"state":"translated","value":"Toca una nota"}},"fr":{"stringUnit":{"state":"translated","value":"Jouez une note"}},"ja":{"stringUnit":{"state":"translated","value":"音を出してください"}},"ko":{"stringUnit":{"state":"translated","value":"음을 연주하세요"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Toque uma nota"}},"ru":{"stringUnit":{"state":"translated","value":"Сыграйте ноту"}},"vi":{"stringUnit":{"state":"translated","value":"Chơi một nốt"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"演奏一个音"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"演奏一個音"}}
    } },
