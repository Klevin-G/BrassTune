    "Password reset email sent. Check your inbox." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إرسال رسالة إعادة تعيين كلمة المرور. تحقق من بريدك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-Mail zum Zurücksetzen gesendet. Prüfe deinen Posteingang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Password reset email sent. Check your inbox."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envió el correo para restablecer la contraseña. Revisa tu bandeja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mail de réinitialisation envoyé. Consultez votre boîte de réception."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワード再設定メールを送信しました。受信トレイを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀번호 재설정 이메일을 보냈습니다. 받은편지함을 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mail de redefinição enviado. Confira sua caixa de entrada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Письмо для сброса пароля отправлено. Проверьте входящие."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã gửi email đặt lại mật khẩu. Hãy kiểm tra hộp thư."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码重置邮件已发送。请检查收件箱。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼重設郵件已傳送。請檢查收件匣。"
          }
        }
      }
    },
    "Password reset email sent. Open the secure web reset page from the email, then return to BrassTune and sign in." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إرسال رسالة إعادة تعيين كلمة المرور. افتح صفحة إعادة التعيين الآمنة على الويب من الرسالة، ثم ارجع إلى BrassTune وسجّل الدخول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-Mail zum Zurücksetzen gesendet. Öffne über die E-Mail die sichere Web-Seite zum Zurücksetzen, kehre dann zu BrassTune zurück und melde dich an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Password reset email sent. Open the secure web reset page from the email, then return to BrassTune and sign in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envió el correo para restablecer la contraseña. Abre desde el correo la página web segura de restablecimiento, vuelve a BrassTune e inicia sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mail de réinitialisation envoyé. Ouvrez la page web sécurisée de réinitialisation depuis l’e-mail, puis revenez dans BrassTune et connectez-vous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワード再設定メールを送信しました。メールから安全なウェブ再設定ページを開き、完了後に BrassTune に戻ってサインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀번호 재설정 이메일을 보냈습니다. 이메일에서 안전한 웹 재설정 페이지를 연 다음 BrassTune으로 돌아와 로그인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mail de redefinição enviado. Abra pelo e-mail a página segura de redefinição na web, volte ao BrassTune e entre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Письмо для сброса пароля отправлено. Откройте из письма защищённую веб-страницу сброса, затем вернитесь в BrassTune и войдите."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã gửi email đặt lại mật khẩu. Mở trang đặt lại bảo mật trên web từ email, rồi quay lại BrassTune và đăng nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码重置邮件已发送。请从邮件中打开安全的网页重置页面，然后返回 BrassTune 并登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼重設郵件已傳送。請從郵件中開啟安全的網頁重設頁面，然後返回 BrassTune 並登入。"
          }
        }
      }
    },
