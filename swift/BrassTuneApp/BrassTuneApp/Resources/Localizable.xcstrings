    "They will lose access to this class. Their recordings and reflections stay private in their own account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيفقدون إمكانية الوصول إلى هذا الصف. ستظل تسجيلاتهم وملاحظاتهم خاصة في حسابهم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Person verliert den Zugriff auf diesen Kurs. Aufnahmen und Reflexionen bleiben im eigenen Konto privat."
