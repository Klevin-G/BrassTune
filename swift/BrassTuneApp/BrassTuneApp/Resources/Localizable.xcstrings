        }
      }
    },
    "BrassTune couldn't clear its saved local data, so your practice data was kept. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن BrassTune من مسح بياناته المحلية المحفوظة، لذلك تم الاحتفاظ ببيانات التدريب الخاصة بك. حاول ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune konnte seine gespeicherten lokalen Daten nicht löschen, daher blieben Ihre Übungsdaten erhalten. Versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune couldn't clear its saved local data, so your practice data was kept. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune no pudo borrar los datos locales guardados, por lo que se conservaron los datos de su práctica. Intentar otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune n'a pas pu effacer ses données locales enregistrées, vos données de pratique ont donc été conservées. Essayer à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune は保存されたローカル データを消去できなかったため、練習データは保持されました。もう一度やり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune이 저장된 로컬 데이터를 지울 수 없어 연습 데이터가 보관되었습니다. 다시 시도해 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O BrassTune não conseguiu limpar os dados locais salvos, então os dados da sua prática foram mantidos. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune не удалось очистить сохраненные локальные данные, поэтому данные вашей тренировки были сохранены. Попробуйте еще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune không thể xóa dữ liệu cục bộ đã lưu nên dữ liệu thực hành của bạn vẫn được giữ lại. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune 无法清除其保存的本地数据，因此您的练习数据被保留。再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune 無法清除其保存的本地數據，因此您的練習數據已保留。再試一次。"
          }
        }
      }
    },
    "BrassTune couldn't finish clearing local data or restore its saved copy. Your data is still open; export it before closing the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن BrassTune من إنهاء مسح البيانات المحلية أو استعادة نسخته المحفوظة. بياناتك لا تزال مفتوحة. قم بتصديره قبل إغلاق التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune konnte das Löschen lokaler Daten nicht abschließen oder seine gespeicherte Kopie wiederherstellen. Ihre Daten sind noch offen; Exportieren Sie es, bevor Sie die App schließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune couldn't finish clearing local data or restore its saved copy. Your data is still open; export it before closing the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune no pudo terminar de borrar los datos locales ni restaurar su copia guardada. Tus datos todavía están abiertos; expórtelo antes de cerrar la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune n'a pas pu terminer la suppression des données locales ou restaurer sa copie enregistrée. Vos données sont toujours ouvertes ; exportez-le avant de fermer l’application."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune はローカル データの消去を完了できず、保存されたコピーを復元できませんでした。データはまだオープンなままです。アプリを閉じる前にエクスポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune에서 로컬 데이터 지우기를 완료하거나 저장된 복사본을 복원할 수 없습니다. 귀하의 데이터는 아직 공개되어 있습니다. 앱을 닫기 전에 내보내세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune não conseguiu terminar de limpar os dados locais ou restaurar sua cópia salva. Seus dados ainda estão abertos; exporte-o antes de fechar o aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune не удалось завершить очистку локальных данных или восстановить их сохраненную копию. Ваши данные по-прежнему открыты; экспортируйте его перед закрытием приложения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune không thể hoàn tất việc xóa dữ liệu cục bộ hoặc khôi phục bản sao đã lưu của nó. Dữ liệu của bạn vẫn mở; xuất nó trước khi đóng ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune 无法完成清除本地数据或恢复其保存的副本。您的数据仍然开放；在关闭应用程序之前将其导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune 無法完成清除本機資料或復原其已儲存的副本。您的資料仍然開放；在關閉應用程式之前將其匯出。"
          }
        }
      }
    },
    "BrassTune couldn't remove the local score file or restore its saved state. The score is still open; export your data before closing the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على BrassTune إزالة ملف النوتة الموسيقية المحلية أو استعادة حالته المحفوظة. النوتة الموسيقية لا تزال مفتوحة. قم بتصدير بياناتك قبل إغلاق التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune konnte die lokale Notendatei nicht entfernen oder ihren gespeicherten Zustand wiederherstellen. Die Noten sind noch offen; Exportieren Sie Ihre Daten, bevor Sie die App schließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune couldn't remove the local score file or restore its saved state. The score is still open; export your data before closing the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune no pudo eliminar el archivo de partitura local ni restaurar su estado guardado. La partitura todavía está abierta; exporte sus datos antes de cerrar la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune n'a pas pu supprimer le fichier de partition locale ni restaurer son état enregistré. La partition est toujours ouverte ; exportez vos données avant de fermer l'application."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune はローカルの楽譜ファイルを削除したり、保存された状態を復元したりできませんでした。楽譜はまだ公開されています。アプリを閉じる前にデータをエクスポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune이 로컬 악보 파일을 제거하거나 저장된 상태를 복원할 수 없습니다. 악보는 아직 열려있습니다. 앱을 닫기 전에 데이터를 내보내세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune não conseguiu remover o arquivo de partitura local ou restaurar seu estado salvo. A partitura ainda está aberta; exporte seus dados antes de fechar o aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune не удалось удалить локальный файл нот или восстановить его сохраненное состояние. Ноты все еще открыты; экспортируйте свои данные перед закрытием приложения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune không thể xóa tệp nhạc cục bộ hoặc khôi phục trạng thái đã lưu của nó. Bản nhạc vẫn mở; xuất dữ liệu của bạn trước khi đóng ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune 无法删除本地乐谱文件或恢复其保存状态。乐谱仍然开放；在关闭应用程序之前导出您的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune 無法刪除本機樂譜檔案或恢復其儲存狀態。樂譜仍然開放；在關閉應用程式之前導出您的資料。"
          }
        }
      }
    },
    "BrassTune couldn't remove the local score file, so the score was kept. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
