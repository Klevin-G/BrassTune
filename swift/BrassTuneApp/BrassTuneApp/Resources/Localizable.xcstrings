    "The click is on by default. Use visual-only mode whenever you want silence.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم النقر بشكل افتراضي. استخدم الوضع المرئي فقط عندما تريد الصمت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Klick ist standardmäßig aktiviert. Verwenden Sie den rein visuellen Modus, wann immer Sie Ruhe wünschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The click is on by default. Use visual-only mode whenever you want silence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El clic está activado de forma predeterminada. Utilice el modo solo visual cuando desee silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clic est activé par défaut. Utilisez le mode visuel uniquement chaque fois que vous souhaitez le silence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックはデフォルトでオンになっています。沈黙が必要な場合は、視覚のみモードを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭은 기본적으로 켜져 있습니다. 침묵을 원할 때마다 시각적 전용 모드를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O clique está ativado por padrão. Use o modo somente visual sempre que desejar silêncio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щелчок включен по умолчанию. Используйте только визуальный режим, когда хотите тишины."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấp chuột được bật theo mặc định. Sử dụng chế độ chỉ hiển thị bất cứ khi nào bạn muốn im lặng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认情况下，单击处于打开状态。当您想要安静时，请使用纯视觉模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
