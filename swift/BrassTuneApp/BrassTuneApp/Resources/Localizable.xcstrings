    "Allow microphone access in iOS Settings, then retry. You can still use guided practice without listening." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الميكروفون في إعدادات iOS، ثم أعد المحاولة. لا يزال بإمكانك استخدام التدريب الموجّه دون استماع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Mikrofonzugriff in den iOS-Einstellungen und versuche es erneut. Geführtes Üben funktioniert auch ohne Zuhören."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow microphone access in iOS Settings, then retry. You can still use guided practice without listening."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso al micrófono en Ajustes de iOS y vuelve a intentarlo. Aún puedes usar la práctica guiada sin escucha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès au micro dans les réglages iOS, puis réessayez. Vous pouvez toujours suivre la pratique guidée sans écoute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSの設定でマイクへのアクセスを許可してから、もう一度お試しください。聴き取りなしでもガイド練習を利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 설정에서 마이크 접근을 허용한 후 다시 시도하세요. 듣기 기능 없이도 가이드 연습을 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso ao microfone nos Ajustes do iOS e tente novamente. Você ainda pode usar a prática guiada sem escuta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к микрофону в настройках iOS и повторите попытку. Практика с подсказками доступна и без прослушивания."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép truy cập micrô trong Cài đặt iOS rồi thử lại. Bạn vẫn có thể dùng bài luyện tập có hướng dẫn mà không cần nghe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 iOS“设置”中允许访问麦克风，然后重试。即使不启用聆听功能，你仍可使用引导练习。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在 iOS「設定」中允許取用麥克風，然後重試。即使不啟用聆聽功能，你仍可使用引導練習。"
          }
        }
      }
    },
