    "Start quietly. Stop if the sound feels uncomfortable, and prefer headphones for microphone practice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بهدوء. توقف إذا كان الصوت غير مريح، ويفضل استخدام سماعات الرأس للتدرب على الميكروفون."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie ruhig. Hören Sie auf, wenn sich der Ton unangenehm anfühlt, und bevorzugen Sie zum Üben des Mikrofons Kopfhörer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start quietly. Stop if the sound feels uncomfortable, and prefer headphones for microphone practice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empiece tranquilamente. Deténgase si el sonido le resulta incómodo y prefiera auriculares para practicar con el micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez tranquillement. Arrêtez-vous si le son est inconfortable et préférez des écouteurs pour la pratique du microphone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かに始めてください。音が不快に感じる場合は中止し、マイクの練習にはヘッドフォンを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용히 시작하세요. 소리가 불편하면 중단하고, 마이크 연습에는 헤드폰을 선호하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece calmamente. Pare se o som parecer desconfortável e prefira fones de ouvido para praticar com microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начни тихо. Остановитесь, если звук вам неприятен, и отдайте предпочтение наушникам для занятий с микрофоном."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu lặng lẽ. Hãy dừng lại nếu cảm thấy âm thanh không thoải mái và sử dụng tai nghe để luyện tập micrô."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安静地开始。如果声音感觉不舒服，请停止，并更喜欢使用耳机进行麦克风练习。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安靜地開始。如果聲音感覺不舒服，請停止，並更喜歡使用耳機進行麥克風練習。"
          }
        }
      }
    },
    "Start the tuner and save a short recording.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ تشغيل الموالف واحفظ تسجيلًا قصيرًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie den Tuner und speichern Sie eine kurze Aufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the tuner and save a short recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie el sintonizador y guarde una grabación breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez le tuner et enregistrez un court enregistrement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チューナーを起動し、短い録音を保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "튜너를 시작하고 짧은 녹음을 저장하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie o sintonizador e salve uma gravação curta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите тюнер и сохраните короткую запись."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động bộ chỉnh và lưu bản ghi ngắn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动调谐器并保存简短的录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動調諧器並儲存簡短的錄音。"
          }
        }
      }
    },
    "Start with drone matching and slow attacks before extending range.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بمطابقة النغمة المستمرة وبدايات النغمات البطيئة قبل توسيع المدى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit Bordunabgleich und langsamen Tonanfängen, bevor du den Umfang erweiterst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with drone matching and slow attacks before extending range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza igualando una nota pedal y con ataques lentos antes de ampliar el registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par vous accorder sur un bourdon et par des attaques lentes avant d’élargir la tessiture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音域を広げる前に、ドローン合わせとゆっくりした音の立ち上がりから始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음역을 넓히기 전에 드론 맞추기와 느린 어택부터 연습하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece igualando um bordão e com ataques lentos antes de ampliar a extensão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните со сверки с бурдоном и медленных атак, прежде чем расширять диапазон."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu bằng cách khớp âm nền kéo dài và vào nốt chậm trước khi mở rộng âm vực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩大音域前，先练习对准持续音和缓慢起音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擴大音域前，先練習對準持續音和緩慢起音。"
          }
        }
      }
    },
