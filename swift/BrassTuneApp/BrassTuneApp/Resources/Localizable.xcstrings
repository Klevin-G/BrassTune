    "Strong work — try to beat your best.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمل قوي - حاول التغلب على أفضل ما لديك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starke Arbeit – versuchen Sie, Ihr Bestes zu geben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strong work — try to beat your best."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajo duro: intenta superar lo mejor que puedas."
          }
        },
        "fr": {
