    "Repeat stable long tones and hold each pitch through the release." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كرر النغمات الطويلة الثابتة وحافظ على كل طبقة صوتية حتى نهاية النغمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederholen Sie stabile lange Töne und halten Sie jede Tonhöhe bis zum sauberen Absetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat stable long tones and hold each pitch through the release."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repita tonos largos estables y sostenga cada altura hasta terminar la nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répétez des sons tenus stables et maintenez chaque hauteur jusqu’à la fin du son."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安定したロングトーンを繰り返し、音の終わりまで各音程を保ちます。"
