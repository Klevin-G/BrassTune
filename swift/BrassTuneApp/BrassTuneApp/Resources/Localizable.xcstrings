          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản của bạn đã bị xóa. BrassTune sẽ thử xóa lại dữ liệu cục bộ còn lại vào lần mở ứng dụng tiếp theo."
          }
