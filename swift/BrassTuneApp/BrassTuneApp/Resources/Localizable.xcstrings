        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the system language or choose a BrassTune language explicitly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga el idioma del sistema o elija explícitamente un idioma de BrassTune."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez la langue du système ou choisissez explicitement une langue BrassTune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム言語に従うか、BrassTune 言語を明示的に選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 언어를 따르거나 BrassTune 언어를 명시적으로 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
