        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Löschen Ihres Kontos werden auch der Übungsverlauf und die auf diesem Gerät gespeicherten Noten gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting your account also removes practice history and sheet music saved on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar tu cuenta también se elimina el historial de práctica y las partituras guardadas en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de votre compte supprime également l'historique des entraînements et les partitions enregistrées sur cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除すると、本機に保存されている練習履歴や楽譜も削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 삭제하면 이 기기에 저장된 연습 기록과 악보도 제거됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir sua conta também remove o histórico de treinos e as partituras salvas neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление вашей учетной записи также приведет к удалению истории тренировок и нот, сохраненных на этом устройстве."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc xóa tài khoản của bạn cũng sẽ xóa lịch sử luyện tập và bản nhạc được lưu trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除您的帐户还会删除此设备上保存的练习历史记录和乐谱。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除您的帳戶也會刪除此裝置上已儲存的練習記錄和樂譜。"
          }
        }
      }
    },
    "Deleting your account removes its server record and clears the saved sign-in, practice history, and imported sheet music on this device." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي حذف حسابك إلى إزالة سجل الخادم الخاص به ومسح تسجيل الدخول المحفوظ وسجل التدريب والنوتة الموسيقية المستوردة على هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Löschen Ihres Kontos werden dessen Servereintrag entfernt und die gespeicherten Anmeldungen, der Übungsverlauf und die importierten Noten auf diesem Gerät gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting your account removes its server record and clears the saved sign-in, practice history, and imported sheet music on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar su cuenta, se elimina el registro del servidor y se borra el inicio de sesión guardado, el historial de práctica y las partituras importadas en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de votre compte supprime son enregistrement sur le serveur et efface la connexion enregistrée, l'historique des entraînements et les partitions importées sur cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除すると、そのサーバー記録が削除され、このデバイスに保存されているサインイン、練習履歴、インポートされた楽譜が消去されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 삭제하면 서버 기록이 제거되고 이 장치에 저장된 로그인, 연습 기록 및 가져온 악보가 지워집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir sua conta remove o registro do servidor e limpa o login salvo, o histórico de prática e as partituras importadas neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При удалении вашей учетной записи удаляется ее запись на сервере, а также стираются сохраненные входы в систему, история тренировок и импортированные ноты на этом устройстве."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc xóa tài khoản của bạn sẽ xóa bản ghi máy chủ của tài khoản đó và xóa thông tin đăng nhập đã lưu, lịch sử luyện tập cũng như bản nhạc đã nhập trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除您的帐户会删除其服务器记录，并清除此设备上保存的登录、练习历史记录和导入的乐谱。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除您的帳戶會刪除其伺服器記錄，並清除此裝置上儲存的登入、練習歷史記錄和匯入的樂譜。"
          }
        }
      }
    },
