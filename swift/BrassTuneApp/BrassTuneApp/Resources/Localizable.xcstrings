    "Account, profile, instrument, audio, accessibility, appearance, language, data, privacy, legal, support, and About are all in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحساب والملف الشخصي والأداة والصوت وإمكانية الوصول والمظهر واللغة والبيانات والخصوصية والقانونية والدعم والمعلومات كلها موجودة في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto, Profil, Instrument, Audio, Barrierefreiheit, Erscheinungsbild, Sprache, Daten, Datenschutz, Recht, Support und Info finden Sie alle in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account, profile, instrument, audio, accessibility, appearance, language, data, privacy, legal, support, and About are all in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta, perfil, instrumento, audio, accesibilidad, apariencia, idioma, datos, privacidad, aspectos legales, soporte y Acerca de se encuentran en Configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte, le profil, l'instrument, l'audio, l'accessibilité, l'apparence, la langue, les données, la confidentialité, les informations juridiques, l'assistance et À propos se trouvent tous dans les paramètres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント、プロフィール、楽器、オーディオ、アクセシビリティ、外観、言語、データ、プライバシー、法的、サポート、およびバージョン情報はすべて [設定] にあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정, 프로필, 기기, 오디오, 접근성, 모양, 언어, 데이터, 개인 정보 보호, 법률, 지원 및 정보가 모두 설정에 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta, perfil, instrumento, áudio, acessibilidade, aparência, idioma, dados, privacidade, jurídico, suporte e Sobre estão todos em Configurações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учетная запись, профиль, инструмент, звук, доступность, внешний вид, язык, данные, конфиденциальность, юридические вопросы, поддержка и информация — все это находится в настройках."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản, hồ sơ, công cụ, âm thanh, khả năng truy cập, giao diện, ngôn ngữ, dữ liệu, quyền riêng tư, pháp lý, hỗ trợ và Giới thiệu đều có trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帐户、个人资料、仪器、音频、辅助功能、外观、语言、数据、隐私、法律、支持和关于都在“设置”中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帳戶、個人資料、儀器、音訊、輔助功能、外觀、語言、資料、隱私、法律、支援和關於都在「設定」中。"
          }
        }
      }
    },
