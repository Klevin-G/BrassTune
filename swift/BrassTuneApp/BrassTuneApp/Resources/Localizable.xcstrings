    "Play one comfortable note, find the center, and save the result." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعزف نغمة مريحة، وابحث عن مركزها، ثم احفظ النتيجة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele einen angenehmen Ton, finde die Mitte und speichere das Ergebnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play one comfortable note, find the center, and save the result."
          }
        },
