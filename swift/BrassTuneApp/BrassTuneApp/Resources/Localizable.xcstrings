    "Play a little longer so BrassTune can suggest what to practice next.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العب لفترة أطول قليلاً حتى يتمكن BrassTune من اقتراح ما يجب التدرب عليه بعد ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielen Sie etwas länger, damit BrassTune Ihnen vorschlagen kann, was Sie als nächstes üben sollten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a little longer so BrassTune can suggest what to practice next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque un poco más para que BrassTune pueda sugerirle qué practicar a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez un peu plus longtemps pour que BrassTune puisse vous suggérer quoi pratiquer ensuite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune が次に何を練習すればよいかを提案できるよう、もう少し長く演奏してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BrassTune이 다음에 연습할 내용을 제안할 수 있도록 조금 더 오래 재생하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque um pouco mais para que o BrassTune possa sugerir o que praticar a seguir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиграйте еще немного, чтобы BrassTune подсказал, что потренироваться дальше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi lâu hơn một chút để BrassTune có thể đề xuất nội dung cần luyện tập tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹奏时间长一点，以便 BrassTune 可以建议接下来要练习什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "彈奏時間長一點，讓 BrassTune 可以建議接下來要練習什麼。"
          }
        }
      }
    },
