    "Scroll the wheel for one BPM at a time, or use the stepper for precise accessible controls." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"مرر العجلة لتغيير BPM واحد في كل مرة، أو استخدم أزرار الزيادة والنقصان لتحكم دقيق وسهل الوصول."}},"de":{"stringUnit":{"state":"translated","value":"Scrolle am Rad für jeweils 1 BPM oder nutze die Schrittsteuerung für präzise, barrierefreie Bedienung."}},"en":{"stringUnit":{"state":"translated","value":"Scroll the wheel for one BPM at a time, or use the stepper for precise accessible controls."}},"es":{"stringUnit":{"state":"translated","value":"Desplaza la rueda de un BPM a la vez o usa el control por pasos para ajustes precisos y accesibles."}},"fr":{"stringUnit":{"state":"translated","value":"Fais défiler la roue d’un BPM à la fois ou utilise le sélecteur pour des réglages précis et accessibles."}},"ja":{"stringUnit":{"state":"translated","value":"ホイールを動かすと1 BPMずつ変えられます。正確で使いやすい操作にはステッパーを使ってください。"}},"ko":{"stringUnit":{"state":"translated","value":"휠을 스크롤하면 한 번에 1 BPM씩 바꿀 수 있습니다. 정확하고 접근성 높은 조작에는 스테퍼를 사용하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Role a roda para mudar um BPM por vez ou use o seletor para controles precisos e acessíveis."}},"ru":{"stringUnit":{"state":"translated","value":"Прокручивайте колесо по 1 BPM или используйте пошаговый регулятор для точного и доступного управления."}},"vi":{"stringUnit":{"state":"translated","value":"Cuộn bánh xe để đổi từng 1 BPM, hoặc dùng nút tăng giảm để điều khiển chính xác, dễ tiếp cận."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"滚动滚轮可每次调整 1 BPM；也可使用步进器进行精确、无障碍的控制。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"捲動滾輪可每次調整 1 BPM；也可使用步進器進行精確、無障礙的控制。"}}}} ,
    "Start practicing as a guest" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"ابدأ التمرين كضيف"}},"de":{"stringUnit":{"state":"translated","value":"Als Gast üben"}},"en":{"stringUnit":{"state":"translated","value":"Start practicing as a guest"}},"es":{"stringUnit":{"state":"translated","value":"Comenzar a practicar como invitado"}},"fr":{"stringUnit":{"state":"translated","value":"Commencer à s’entraîner en invité"}},"ja":{"stringUnit":{"state":"translated","value":"ゲストとして練習を始める"}},"ko":{"stringUnit":{"state":"translated","value":"게스트로 연습 시작"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Começar a praticar como convidado"}},"ru":{"stringUnit":{"state":"translated","value":"Начать занятия как гость"}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu luyện tập với tư cách khách"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"以访客身份开始练习"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"以訪客身分開始練習"}}}} ,
