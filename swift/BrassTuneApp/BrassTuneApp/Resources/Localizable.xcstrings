          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat stable long tones and hold each pitch through the release."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repita tonos largos estables y sostenga cada altura hasta terminar la nota."
