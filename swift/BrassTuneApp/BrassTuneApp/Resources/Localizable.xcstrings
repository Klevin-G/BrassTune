    "Practice recordings and imported sheet music stay on this device unless you choose to share or export them." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى تسجيلات التدريب والنوتات الموسيقية المستوردة على هذا الجهاز ما لم تختر مشاركتها أو تصديرها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übungsaufnahmen und importierte Noten bleiben auf diesem Gerät, sofern Sie sie nicht teilen oder exportieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practice recordings and imported sheet music stay on this device unless you choose to share or export them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las grabaciones de práctica y las partituras importadas permanecen en este dispositivo, salvo que decidas compartirlas o exportarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements de séance et les partitions importées restent sur cet appareil, sauf si vous choisissez de les partager ou de les exporter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "練習の録音と取り込んだ楽譜は、共有または書き出しを選ばない限り、この端末に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연습 녹음과 가져온 악보는 공유하거나 내보내기를 선택하지 않는 한 이 기기에 보관됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As gravações de prática e as partituras importadas ficam neste dispositivo, a menos que você escolha compartilhá-las ou exportá-las."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи занятий и импортированные ноты остаются на этом устройстве, если вы не решите поделиться ими или экспортировать их."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản ghi âm luyện tập và bản nhạc đã nhập sẽ được giữ trên thiết bị này trừ khi bạn chọn chia sẻ hoặc xuất chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "练习录音和导入的乐谱会保留在此设备上，除非你选择共享或导出。"
          }
        },
        "zh-Hant" : {
