    "Sustain for %@ seconds" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"حافظ على النغمة لمدة %@ ثوانٍ"}},"de":{"stringUnit":{"state":"translated","value":"%@ Sekunden halten"}},"en":{"stringUnit":{"state":"translated","value":"Sustain for %@ seconds"}},"es":{"stringUnit":{"state":"translated","value":"Sostén durante %@ segundos"}},"fr":{"stringUnit":{"state":"translated","value":"Tenez pendant %@ secondes"}},"ja":{"stringUnit":{"state":"translated","value":"%@秒間音を保つ"}},"ko":{"stringUnit":{"state":"translated","value":"%@초 동안 소리를 유지하기"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sustente por %@ segundos"}},"ru":{"stringUnit":{"state":"translated","value":"Удерживайте %@ секунд"}},"vi":{"stringUnit":{"state":"translated","value":"Giữ âm trong %@ giây"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保持音符 %@ 秒"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"保持音符 %@ 秒"}}}},
    "Sustain: %@ seconds" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"استمرار النغمة: %@ ثانية"}},"de":{"stringUnit":{"state":"translated","value":"Ton halten: %@ Sekunden"}},"en":{"stringUnit":{"state":"translated","value":"Sustain: %@ seconds"}},"es":{"stringUnit":{"state":"translated","value":"Sostener: %@ segundos"}},"fr":{"stringUnit":{"state":"translated","value":"Tenir la note : %@ secondes"}},"ja":{"stringUnit":{"state":"translated","value":"音を伸ばす：%@秒"}},"ko":{"stringUnit":{"state":"translated","value":"음 유지: %@초"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sustentar: %@ segundos"}},"ru":{"stringUnit":{"state":"translated","value":"Удержание ноты: %@ секунд"}},"vi":{"stringUnit":{"state":"translated","value":"Giữ nốt: %@ giây"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"持续：%@ 秒"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"持續：%@ 秒"}}}},
    "Sustained target" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"هدف مستمر"}},"de":{"stringUnit":{"state":"translated","value":"Fortlaufendes Ziel"}},"en":{"stringUnit":{"state":"translated","value":"Sustained target"}},"es":{"stringUnit":{"state":"translated","value":"Objetivo continuo"}},"fr":{"stringUnit":{"state":"translated","value":"Objectif continu"}},"ja":{"stringUnit":{"state":"translated","value":"持続目標"}},"ko":{"stringUnit":{"state":"translated","value":"지속 목표"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Meta contínua"}},"ru":{"stringUnit":{"state":"translated","value":"Постоянная цель"}},"vi":{"stringUnit":{"state":"translated","value":"Mục tiêu duy trì"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"持续目标"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"持續目標"}}}},
    "This goal already has 50 saved self-assessments. Its history is preserved; create another goal to continue logging, or export your local data before deleting this one." : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"يحتوي هذا الهدف بالفعل على 50 تقييمًا ذاتيًا محفوظًا. سيُحفظ سجله؛ أنشئ هدفًا آخر لمتابعة التسجيل، أو صدّر بياناتك المحلية قبل حذف هذا الهدف."}},"de":{"stringUnit":{"state":"translated","value":"Dieses Ziel hat bereits 50 gespeicherte Selbsteinschätzungen. Sein Verlauf bleibt erhalten; erstelle ein weiteres Ziel, um weiter Einträge zu machen, oder exportiere deine lokalen Daten, bevor du dieses löschst."}},"en":{"stringUnit":{"state":"translated","value":"This goal already has 50 saved self-assessments. Its history is preserved; create another goal to continue logging, or export your local data before deleting this one."}},"es":{"stringUnit":{"state":"translated","value":"Este objetivo ya tiene 50 autoevaluaciones guardadas. Su historial se conserva; crea otro objetivo para seguir registrando o exporta tus datos locales antes de eliminar este."}},"fr":{"stringUnit":{"state":"translated","value":"Cet objectif a déjà 50 auto-évaluations enregistrées. Son historique est conservé ; créez un autre objectif pour continuer à enregistrer, ou exportez vos données locales avant de supprimer celui-ci."}},"ja":{"stringUnit":{"state":"translated","value":"この目標にはすでに50件の自己評価が保存されています。履歴は保持されます。記録を続けるには別の目標を作成するか、削除する前にローカルデータを書き出してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 목표에는 이미 50개의 자기 평가가 저장되어 있습니다. 기록은 보존됩니다. 기록을 계속하려면 다른 목표를 만들거나, 이 목표를 삭제하기 전에 로컬 데이터를 내보내세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta meta já tem 50 autoavaliações salvas. Seu histórico é preservado; crie outra meta para continuar registrando ou exporte seus dados locais antes de excluir esta."}},"ru":{"stringUnit":{"state":"translated","value":"У этой цели уже есть 50 сохранённых самооценок. Её история сохраняется; создайте другую цель, чтобы продолжить записи, или экспортируйте локальные данные перед удалением этой."}},"vi":{"stringUnit":{"state":"translated","value":"Mục tiêu này đã có 50 đánh giá tự ghi. Lịch sử của mục tiêu được giữ lại; hãy tạo mục tiêu khác để tiếp tục ghi, hoặc xuất dữ liệu cục bộ trước khi xóa mục tiêu này."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此目标已有 50 条已保存的自我评估。其历史记录会保留；请创建另一个目标以继续记录，或在删除此目标前导出本地数据。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此目標已有 50 筆已儲存的自我評估。其歷史記錄會保留；請建立另一個目標以繼續記錄，或在刪除此目標前匯出本機資料。"}}}},
    "Tune by listening first" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"اضبط الآلة بالاستماع أولاً"}},"de":{"stringUnit":{"state":"translated","value":"Stimme zuerst nach Gehör"}},"en":{"stringUnit":{"state":"translated","value":"Tune by listening first"}},"es":{"stringUnit":{"state":"translated","value":"Afina escuchando primero"}},"fr":{"stringUnit":{"state":"translated","value":"Accordez-vous d’abord à l’écoute"}},"ja":{"stringUnit":{"state":"translated","value":"まず聴いてチューニングする"}},"ko":{"stringUnit":{"state":"translated","value":"먼저 듣고 튜닝하기"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Afine ouvindo primeiro"}},"ru":{"stringUnit":{"state":"translated","value":"Сначала настраивайтесь на слух"}},"vi":{"stringUnit":{"state":"translated","value":"Chỉnh âm bằng cách lắng nghe trước"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"先聆听再调音"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"先聆聽再調音"}}}},
    "Use" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"استخدم"}},"de":{"stringUnit":{"state":"translated","value":"Verwenden"}},"en":{"stringUnit":{"state":"translated","value":"Use"}},"es":{"stringUnit":{"state":"translated","value":"Usar"}},"fr":{"stringUnit":{"state":"translated","value":"Utiliser"}},"ja":{"stringUnit":{"state":"translated","value":"使用"}},"ko":{"stringUnit":{"state":"translated","value":"사용"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usar"}},"ru":{"stringUnit":{"state":"translated","value":"Использовать"}},"vi":{"stringUnit":{"state":"translated","value":"Dùng"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用"}}}},
    "Use this as your next practice approach; it is not an automatic assessment." : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"استخدم هذا كمنهجك في التدريب التالي؛ إنه ليس تقييمًا تلقائيًا."}},"de":{"stringUnit":{"state":"translated","value":"Nutze dies als deinen nächsten Übeansatz; es ist keine automatische Bewertung."}},"en":{"stringUnit":{"state":"translated","value":"Use this as your next practice approach; it is not an automatic assessment."}},"es":{"stringUnit":{"state":"translated","value":"Usa esto como tu próximo enfoque de práctica; no es una evaluación automática."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez ceci comme prochaine approche de pratique ; ce n’est pas une évaluation automatique."}},"ja":{"stringUnit":{"state":"translated","value":"これを次の練習方法として使ってください。自動評価ではありません。"}},"ko":{"stringUnit":{"state":"translated","value":"이것을 다음 연습 방법으로 사용하세요. 자동 평가는 아닙니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use isto como sua próxima abordagem de prática; não é uma avaliação automática."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте это как следующий подход к занятиям; это не автоматическая оценка."}},"vi":{"stringUnit":{"state":"translated","value":"Dùng điều này cho cách luyện tập tiếp theo; đây không phải là đánh giá tự động."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将其作为下一次练习的方法；这不是自动评估。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將其作為下一次練習的方法；這不是自動評估。"}}}},
    "What you achieved" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"ما حققته"}},"de":{"stringUnit":{"state":"translated","value":"Was du erreicht hast"}},"en":{"stringUnit":{"state":"translated","value":"What you achieved"}},"es":{"stringUnit":{"state":"translated","value":"Lo que lograste"}},"fr":{"stringUnit":{"state":"translated","value":"Ce que vous avez accompli"}},"ja":{"stringUnit":{"state":"translated","value":"達成したこと"}},"ko":{"stringUnit":{"state":"translated","value":"달성한 내용"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O que você alcançou"}},"ru":{"stringUnit":{"state":"translated","value":"Чего вы достигли"}},"vi":{"stringUnit":{"state":"translated","value":"Điều bạn đã đạt được"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你达成的内容"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"你達成的內容"}}}},
    "You have %@ preserved goals. This device supports creating up to 24 new goals; export your local data, then delete a goal if you need room for another." : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"لديك %@ أهداف محفوظة. يدعم هذا الجهاز إنشاء ما يصل إلى 24 هدفًا جديدًا؛ صدّر بياناتك المحلية، ثم احذف هدفًا إذا احتجت مساحة لهدف آخر."}},"de":{"stringUnit":{"state":"translated","value":"Du hast %@ erhaltene Ziele. Auf diesem Gerät können bis zu 24 neue Ziele erstellt werden; exportiere deine lokalen Daten und lösche dann ein Ziel, wenn du Platz für ein weiteres brauchst."}},"en":{"stringUnit":{"state":"translated","value":"You have %@ preserved goals. This device supports creating up to 24 new goals; export your local data, then delete a goal if you need room for another."}},"es":{"stringUnit":{"state":"translated","value":"Tienes %@ objetivos conservados. Este dispositivo permite crear hasta 24 objetivos nuevos; exporta tus datos locales y luego elimina un objetivo si necesitas espacio para otro."}},"fr":{"stringUnit":{"state":"translated","value":"Vous avez %@ objectifs conservés. Cet appareil permet de créer jusqu’à 24 nouveaux objectifs ; exportez vos données locales, puis supprimez un objectif si vous avez besoin de place pour un autre."}},"ja":{"stringUnit":{"state":"translated","value":"%@件の目標が保存されています。このデバイスでは新しい目標を最大24件作成できます。ローカルデータを書き出してから、別の目標の空きが必要なら目標を削除してください。"}},"ko":{"stringUnit":{"state":"translated","value":"보존된 목표가 %@개 있습니다. 이 기기에서는 새 목표를 최대 24개까지 만들 수 있습니다. 로컬 데이터를 내보낸 뒤 다른 목표를 위한 공간이 필요하면 목표를 삭제하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Você tem %@ metas preservadas. Este dispositivo permite criar até 24 novas metas; exporte seus dados locais e exclua uma meta se precisar de espaço para outra."}},"ru":{"stringUnit":{"state":"translated","value":"У вас %@ сохранённых целей. На этом устройстве можно создать до 24 новых целей; экспортируйте локальные данные, затем удалите цель, если нужно место для другой."}},"vi":{"stringUnit":{"state":"translated","value":"Bạn có %@ mục tiêu được lưu giữ. Thiết bị này hỗ trợ tạo tối đa 24 mục tiêu mới; hãy xuất dữ liệu cục bộ, sau đó xóa một mục tiêu nếu cần chỗ cho mục tiêu khác."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你有 %@ 个已保留的目标。此设备最多支持创建 24 个新目标；请导出本地数据，如果需要为新目标腾出空间，再删除一个目标。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"你有 %@ 個已保留的目標。此裝置最多支援建立 24 個新目標；請匯出本機資料，若需要為新目標騰出空間，再刪除一個目標。"}}}},
    "You have reached the 24-goal limit. Export your local data, then delete a goal if you need room for another." : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"لقد وصلت إلى حد 24 هدفًا. صدّر بياناتك المحلية، ثم احذف هدفًا إذا احتجت مساحة لهدف آخر."}},"de":{"stringUnit":{"state":"translated","value":"Du hast das Limit von 24 Zielen erreicht. Exportiere deine lokalen Daten und lösche dann ein Ziel, wenn du Platz für ein weiteres brauchst."}},"en":{"stringUnit":{"state":"translated","value":"You have reached the 24-goal limit. Export your local data, then delete a goal if you need room for another."}},"es":{"stringUnit":{"state":"translated","value":"Has alcanzado el límite de 24 objetivos. Exporta tus datos locales y luego elimina un objetivo si necesitas espacio para otro."}},"fr":{"stringUnit":{"state":"translated","value":"Vous avez atteint la limite de 24 objectifs. Exportez vos données locales, puis supprimez un objectif si vous avez besoin de place pour un autre."}},"ja":{"stringUnit":{"state":"translated","value":"24件の目標上限に達しました。ローカルデータを書き出してから、別の目標の空きを作る必要があれば目標を削除してください。"}},"ko":{"stringUnit":{"state":"translated","value":"24개 목표 한도에 도달했습니다. 로컬 데이터를 내보낸 뒤 다른 목표를 위한 공간이 필요하면 목표를 삭제하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Você atingiu o limite de 24 metas. Exporte seus dados locais e exclua uma meta se precisar de espaço para outra."}},"ru":{"stringUnit":{"state":"translated","value":"Вы достигли лимита в 24 цели. Экспортируйте локальные данные, затем удалите цель, если нужно место для другой."}},"vi":{"stringUnit":{"state":"translated","value":"Bạn đã đạt giới hạn 24 mục tiêu. Hãy xuất dữ liệu cục bộ, sau đó xóa một mục tiêu nếu cần chỗ cho mục tiêu khác."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你已达到 24 个目标的上限。请导出本地数据；如果需要为新目标腾出空间，再删除一个目标。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"你已達到 24 個目標的上限。請匯出本機資料；若需要為新目標騰出空間，再刪除一個目標。"}}}},
    "Your practice loop" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"حلقة تدريبك"}},"de":{"stringUnit":{"state":"translated","value":"Dein Übezyklus"}},"en":{"stringUnit":{"state":"translated","value":"Your practice loop"}},"es":{"stringUnit":{"state":"translated","value":"Tu ciclo de práctica"}},"fr":{"stringUnit":{"state":"translated","value":"Votre boucle de pratique"}},"ja":{"stringUnit":{"state":"translated","value":"あなたの練習サイクル"}},"ko":{"stringUnit":{"state":"translated","value":"나의 연습 순환"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Seu ciclo de prática"}},"ru":{"stringUnit":{"state":"translated","value":"Ваш цикл занятий"}},"vi":{"stringUnit":{"state":"translated","value":"Chu trình luyện tập của bạn"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的练习循环"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"你的練習循環"}}}},
    "Account options" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"خيارات الحساب"}},"de":{"stringUnit":{"state":"translated","value":"Kontooptionen"}},"en":{"stringUnit":{"state":"translated","value":"Account options"}},"es":{"stringUnit":{"state":"translated","value":"Opciones de cuenta"}},"fr":{"stringUnit":{"state":"translated","value":"Options du compte"}},"ja":{"stringUnit":{"state":"translated","value":"アカウントのオプション"}},"ko":{"stringUnit":{"state":"translated","value":"계정 옵션"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Opções da conta"}},"ru":{"stringUnit":{"state":"translated","value":"Параметры учётной записи"}},"vi":{"stringUnit":{"state":"translated","value":"Tùy chọn tài khoản"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账户选项"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"帳戶選項"}}}},
    "Displayed with a responsive crop." : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"يُعرض باقتصاص متجاوب."}},"de":{"stringUnit":{"state":"translated","value":"Wird mit einem responsiven Bildausschnitt angezeigt."}},"en":{"stringUnit":{"state":"translated","value":"Displayed with a responsive crop."}},"es":{"stringUnit":{"state":"translated","value":"Se muestra con un recorte adaptable."}},"fr":{"stringUnit":{"state":"translated","value":"Affiché avec un recadrage adaptatif."}},"ja":{"stringUnit":{"state":"translated","value":"画面に合わせてトリミングして表示されます。"}},"ko":{"stringUnit":{"state":"translated","value":"화면에 맞게 잘라 표시됩니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Exibida com um recorte responsivo."}},"ru":{"stringUnit":{"state":"translated","value":"Отображается с адаптивным кадрированием."}},"vi":{"stringUnit":{"state":"translated","value":"Được hiển thị với khung cắt thích ứng."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"以自适应裁剪方式显示。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"以自適應裁切方式顯示。"}}}},
    "Photo credit" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"نَسب الصورة"}},"de":{"stringUnit":{"state":"translated","value":"Bildnachweis"}},"en":{"stringUnit":{"state":"translated","value":"Photo credit"}},"es":{"stringUnit":{"state":"translated","value":"Crédito de la foto"}},"fr":{"stringUnit":{"state":"translated","value":"Crédit photo"}},"ja":{"stringUnit":{"state":"translated","value":"写真クレジット"}},"ko":{"stringUnit":{"state":"translated","value":"사진 출처"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Crédito da foto"}},"ru":{"stringUnit":{"state":"translated","value":"Указание автора фото"}},"vi":{"stringUnit":{"state":"translated","value":"Ghi công ảnh"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"照片署名"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"照片署名"}}}},
    "Pick up your instrument." : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"أمسك بآلتك الموسيقية."}},"de":{"stringUnit":{"state":"translated","value":"Nimm dein Instrument zur Hand."}},"en":{"stringUnit":{"state":"translated","value":"Pick up your instrument."}},"es":{"stringUnit":{"state":"translated","value":"Toma tu instrumento."}},"fr":{"stringUnit":{"state":"translated","value":"Prenez votre instrument."}},"ja":{"stringUnit":{"state":"translated","value":"楽器を手に取りましょう。"}},"ko":{"stringUnit":{"state":"translated","value":"악기를 들어 보세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pegue seu instrumento."}},"ru":{"stringUnit":{"state":"translated","value":"Возьмите свой инструмент."}},"vi":{"stringUnit":{"state":"translated","value":"Hãy cầm nhạc cụ của bạn lên."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"拿起你的乐器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"拿起你的樂器。"}}}},
    "Tune a note, set a pulse, or choose a passage to work on." : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"اضبط نغمة، أو حدّد نبضًا إيقاعيًا، أو اختر مقطعًا للتدرّب عليه."}},"de":{"stringUnit":{"state":"translated","value":"Stimme einen Ton, stelle einen Puls ein oder wähle eine Passage zum Üben."}},"en":{"stringUnit":{"state":"translated","value":"Tune a note, set a pulse, or choose a passage to work on."}},"es":{"stringUnit":{"state":"translated","value":"Afina una nota, marca un pulso o elige un pasaje para practicar."}},"fr":{"stringUnit":{"state":"translated","value":"Accordez une note, réglez une pulsation ou choisissez un passage à travailler."}},"ja":{"stringUnit":{"state":"translated","value":"音を合わせ、拍を設定するか、練習するフレーズを選びましょう。"}},"ko":{"stringUnit":{"state":"translated","value":"음을 맞추고, 박을 설정하거나, 연습할 구절을 선택하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Afine uma nota, defina uma pulsação ou escolha uma passagem para praticar."}},"ru":{"stringUnit":{"state":"translated","value":"Настройте ноту, задайте пульс или выберите фрагмент для работы."}},"vi":{"stringUnit":{"state":"translated","value":"Hãy chỉnh một nốt, đặt nhịp hoặc chọn một đoạn để luyện tập."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"校准一个音，设定节拍，或选择一段来练习。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"校準一個音，設定節拍，或選擇一段來練習。"}}}}
  },
  "version" : "1.0"
}
