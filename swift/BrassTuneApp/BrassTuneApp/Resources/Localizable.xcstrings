    "The reference tone stopped because your audio output changed. Check your headphones or speaker before restarting.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت النغمة المرجعية بسبب تغير إخراج الصوت. تحقق من سماعات الرأس أو مكبر الصوت قبل إعادة التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Referenzton wurde gestoppt, weil sich Ihre Audioausgabe geändert hat. Überprüfen Sie vor dem Neustart Ihre Kopfhörer oder Lautsprecher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reference tone stopped because your audio output changed. Check your headphones or speaker before restarting."
          }
        },
        "es": {
