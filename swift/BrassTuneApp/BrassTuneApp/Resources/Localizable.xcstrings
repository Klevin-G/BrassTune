    "Enter a username with 3–32 letters, numbers, underscores, or hyphens." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a username with 3–32 letters, numbers, underscores, or hyphens."}},"ar":{"stringUnit":{"state":"translated","value":"أدخل اسم مستخدم من 3 إلى 32 حرفًا أو رقمًا أو شرطة سفلية أو واصلة."}},"de":{"stringUnit":{"state":"translated","value":"Gib einen Benutzernamen mit 3–32 Buchstaben, Zahlen, Unterstrichen oder Bindestrichen ein."}},"es":{"stringUnit":{"state":"translated","value":"Escribe un nombre de usuario con 3–32 letras, números, guiones bajos o guiones."}},"fr":{"stringUnit":{"state":"translated","value":"Saisissez un nom d’utilisateur de 3 à 32 lettres, chiffres, traits de soulignement ou traits d’union."}},"ja":{"stringUnit":{"state":"translated","value":"3～32文字の英字、数字、下線、ハイフンを含むユーザー名を入力してください。"}},"ko":{"stringUnit":{"state":"translated","value":"영문자, 숫자, 밑줄 또는 하이픈으로 된 3~32자 사용자 이름을 입력하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Digite um nome de usuário com 3–32 letras, números, sublinhados ou hífens."}},"ru":{"stringUnit":{"state":"translated","value":"Введите имя пользователя из 3–32 букв, цифр, символов подчёркивания или дефисов."}},"vi":{"stringUnit":{"state":"translated","value":"Nhập tên người dùng gồm 3–32 chữ cái, số, dấu gạch dưới hoặc gạch nối."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入包含 3–32 个字母、数字、下划线或连字符的用户名。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請輸入包含 3–32 個字母、數字、底線或連字號的使用者名稱。"}}}},
    "Enter a display name to save your profile." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a display name to save your profile."}},"ar":{"stringUnit":{"state":"translated","value":"أدخل اسم عرض لحفظ ملفك الشخصي."}},"de":{"stringUnit":{"state":"translated","value":"Gib einen Anzeigenamen ein, um dein Profil zu speichern."}},"es":{"stringUnit":{"state":"translated","value":"Escribe un nombre para mostrar para guardar tu perfil."}},"fr":{"stringUnit":{"state":"translated","value":"Saisissez un nom d’affichage pour enregistrer votre profil."}},"ja":{"stringUnit":{"state":"translated","value":"プロフィールを保存するには表示名を入力してください。"}},"ko":{"stringUnit":{"state":"translated","value":"프로필을 저장하려면 표시 이름을 입력하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Digite um nome de exibição para salvar seu perfil."}},"ru":{"stringUnit":{"state":"translated","value":"Введите отображаемое имя, чтобы сохранить профиль."}},"vi":{"stringUnit":{"state":"translated","value":"Nhập tên hiển thị để lưu hồ sơ của bạn."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入显示名称以保存您的个人资料。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請輸入顯示名稱以儲存您的個人資料。"}}}},
    "Enter a display name of 80 characters or fewer to save your profile." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a display name of 80 characters or fewer to save your profile."}},"ar":{"stringUnit":{"state":"translated","value":"أدخل اسم عرض لا يزيد عن 80 حرفًا لحفظ ملفك الشخصي."}},"de":{"stringUnit":{"state":"translated","value":"Gib einen Anzeigenamen mit höchstens 80 Zeichen ein, um dein Profil zu speichern."}},"es":{"stringUnit":{"state":"translated","value":"Escribe un nombre para mostrar de 80 caracteres o menos para guardar tu perfil."}},"fr":{"stringUnit":{"state":"translated","value":"Saisissez un nom d’affichage de 80 caractères ou moins pour enregistrer votre profil."}},"ja":{"stringUnit":{"state":"translated","value":"プロフィールを保存するには、80文字以内の表示名を入力してください。"}},"ko":{"stringUnit":{"state":"translated","value":"프로필을 저장하려면 80자 이하의 표시 이름을 입력하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Digite um nome de exibição com até 80 caracteres para salvar seu perfil."}},"ru":{"stringUnit":{"state":"translated","value":"Введите отображаемое имя не длиннее 80 символов, чтобы сохранить профиль."}},"vi":{"stringUnit":{"state":"translated","value":"Nhập tên hiển thị tối đa 80 ký tự để lưu hồ sơ của bạn."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入不超过 80 个字符的显示名称以保存您的个人资料。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請輸入不超過 80 個字元的顯示名稱以儲存您的個人資料。"}}}},
    "Enter the 4-16 character class code from your teacher." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
