    "Buzz a comfortable pitch softly. Rest whenever the sound feels forced." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصدر طنينًا ناعمًا على طبقة مريحة. استرح كلما شعرت بأن الصوت مجهد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summen Sie leise auf einer angenehmen Tonhöhe. Machen Sie Pause, sobald der Ton erzwungen wirkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buzz a comfortable pitch softly. Rest whenever the sound feels forced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz un zumbido suave en una altura cómoda. Descansa cuando el sonido se sienta forzado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites doucement vibrer les lèvres sur une hauteur confortable. Reposez-vous dès que le son semble forcé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無理のない音程でやさしくバズィングします。音に力みを感じたら休みましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편안한 음정으로 부드럽게 버징하세요. 소리가 억지로 나는 느낌이 들면 쉬세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça um buzz suave em uma altura confortável. Descanse sempre que o som parecer forçado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мягко пожужжите губами на удобной высоте. Отдохните, если звук появляется с напряжением."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rung môi nhẹ ở cao độ thoải mái. Nghỉ bất cứ khi nào âm thanh có vẻ gượng ép."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在舒适的音高上轻柔地震唇。只要感到发音勉强，就停下休息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在舒適的音高上輕柔地震唇。只要感到發音勉強，就停下休息。"
          }
        }
      }
    },
