    "Breathe in quietly for 4 counts and release for 8. Keep shoulders loose." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استنشق بهدوء لأربع عدات وأطلق النفس لثماني عدات. أبقِ كتفيك مسترخيين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmen Sie vier Schläge lang leise ein und acht Schläge lang aus. Halten Sie die Schultern locker."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe in quietly for 4 counts and release for 8. Keep shoulders loose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala en silencio durante 4 tiempos y suelta el aire durante 8. Mantén los hombros relajados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez silencieusement pendant 4 temps et expirez pendant 8. Gardez les épaules détendues."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4拍で静かに息を吸い、8拍で吐きます。肩の力を抜きましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4박 동안 조용히 들이마시고 8박 동안 내쉬세요. 어깨에 힘을 빼세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire em silêncio por 4 tempos e solte o ar por 8. Mantenha os ombros relaxados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тихо вдохните на 4 счёта и выдохните на 8. Держите плечи расслабленными."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hít vào nhẹ nhàng trong 4 phách và thở ra trong 8 phách. Giữ vai thả lỏng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 4 拍安静地吸气，再用 8 拍呼气。保持肩膀放松。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 4 拍安靜地吸氣，再用 8 拍呼氣。保持肩膀放鬆。"
          }
        }
      }
    },
