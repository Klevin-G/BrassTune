    "Recording stopped because another audio session took over." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف التسجيل بسبب تولي جلسة صوتية أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme wurde gestoppt, weil eine andere Audiositzung übernommen wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording stopped because another audio session took over."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación se detuvo porque se hizo cargo otra sesión de audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement s'est arrêté car une autre session audio a pris le relais."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のオーディオ セッションが引き継がれたため、録音が停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 오디오 세션이 이어져서 녹음이 중지되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação foi interrompida porque outra sessão de áudio foi iniciada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись остановлена, поскольку начался другой аудиосеанс."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá trình ghi đã dừng do một phiên âm thanh khác tiếp quản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
