    "Let the air connect the notes before the fingers." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دع الهواء يربط النغمات قبل الأصابع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lassen Sie die Luft die Noten vor den Fingern verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the air connect the notes before the fingers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que el aire conecte las notas antes que los dedos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez l'air relier les notes avant les doigts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指の前で空気が音符を繋ぎましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공기가 손가락 앞에서 음표를 연결하도록 하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o ar conectar as notas antes dos dedos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пусть воздух соединяет ноты перед пальцами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy để không khí kết nối các nốt nhạc trước các ngón tay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让空气在手指之前连接音符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓空氣在手指之前連接音符。"
          }
        }
      }
    },
    "Let the air lead; keep the shoulders quiet." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دع الهواء يقود؛ الحفاظ على الكتفين هادئة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Luft führen; Halte die Schultern ruhig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the air lead; keep the shoulders quiet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que el aire guíe; Mantenga los hombros tranquilos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez l’air conduire ; gardez les épaules tranquilles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空気を導きましょう。肩を静かに保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공기가 이어지도록 하세요. 어깨를 조용히 유지하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o ar conduzir; mantenha os ombros quietos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пусть воздух ведет; держите плечи в покое."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy để không khí dẫn dắt; giữ cho đôi vai yên lặng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让空气主导；保持肩膀安静。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓空氣主導；保持肩膀安靜。"
          }
        }
      }
    },
