          "stringUnit": {
            "state": "translated",
            "value": "La tonalité de référence s'est arrêtée car votre sortie audio a changé. Vérifiez vos écouteurs ou votre haut-parleur avant de redémarrer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオ出力が変化したため、基準音が停止しました。再起動する前にヘッドフォンまたはスピーカーを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 출력이 변경되어 기준음이 중지되었습니다. 다시 시작하기 전에 헤드폰이나 스피커를 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tom de referência parou porque a saída de áudio foi alterada. Verifique seus fones de ouvido ou alto-falante antes de reiniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опорный сигнал прекратился, потому что у вас изменился аудиовыход. Проверьте наушники или динамик перед перезапуском."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm tham chiếu đã dừng do đầu ra âm thanh của bạn thay đổi. Kiểm tra tai nghe hoặc loa của bạn trước khi khởi động lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于音频输出发生变化，参考音停止了。重新启动之前检查您的耳机或扬声器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於音訊輸出變化，參考音停止了。重新啟動之前檢查您的耳機或揚聲器。"
          }
        }
      }
    },
    "The request timed out.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة الطلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage hat zu lange gedauert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request timed out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud agotó el tiempo de espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande a expiré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストがタイムアウトしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 시간이 초과되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A solicitação expirou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время ожидания запроса истекло."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu đã hết thời gian chờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求超时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求逾時。"
          }
        }
      }
    },
    "The score could not be imported, and BrassTune could not remove its copied file. The copied file remains on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر استيراد النوتة أو إزالة الملف المنسوخ. يبقى الملف المنسوخ على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Noten konnten nicht importiert und die Kopie nicht entfernt werden. Die Kopie bleibt auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The score could not be imported, and BrassTune could not remove its copied file. The copied file remains on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo importar la partitura ni eliminar la copia. El archivo copiado permanece en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La partition n’a pas pu être importée ni sa copie supprimée. Le fichier copié reste sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "楽譜を読み込めず、コピーしたファイルも削除できませんでした。コピーはこのデバイスに残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "악보를 가져오거나 복사 파일을 삭제하지 못했습니다. 복사된 파일은 이 기기에 남아 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível importar a partitura nem remover a cópia. O arquivo copiado permanece neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось импортировать партитуру и удалить ее копию. Скопированный файл остается на устройстве."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể nhập bản nhạc hoặc xóa tệp đã sao chép. Tệp sao chép vẫn còn trên thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法导入乐谱，也无法移除其副本。复制的文件仍保留在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法匯入樂譜，也無法移除其副本。複製的檔案仍保留在此裝置上。"
          }
        }
      }
    },
    "This PDF has more than %@ pages. Split it into smaller files before importing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي ملف PDF هذا على أكثر من %@ صفحة. قم بتقسيمها إلى ملفات أصغر قبل الاستيراد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses PDF hat mehr als %@ Seiten. Teilen Sie es vor dem Import in kleinere Dateien auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PDF has more than %@ pages. Split it into smaller files before importing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este PDF tiene más de %@ páginas. Divídalo en archivos más pequeños antes de importarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce PDF comporte plus de %@ pages. Divisez-le en fichiers plus petits avant de l'importer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この PDF には %@ ページを超えています。インポートする前に、小さなファイルに分割してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 PDF에는 %@ 페이지가 넘습니다. 가져오기 전에 더 작은 파일로 분할하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este PDF tem mais de %@ páginas. Divida-o em arquivos menores antes de importar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот PDF-файл содержит более %@ страниц. Перед импортом разделите его на файлы меньшего размера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản PDF này có nhiều hơn %@ trang. Chia nó thành các tệp nhỏ hơn trước khi nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 PDF 超过 %@ 页。在导入之前将其拆分为较小的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 PDF 超過 %@ 頁。在導入之前將其拆分為較小的檔案。"
          }
        }
      }
    },
    "This PDF has more than %lld pages. Split it into smaller files before importing.": {
