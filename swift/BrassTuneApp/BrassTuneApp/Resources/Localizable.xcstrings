    "Live listening needs attention. Use a scale or practice plan while you check your audio connection." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستماع المباشر يحتاج إلى الاهتمام. استخدم مقياسًا أو خطة تدريب أثناء التحقق من اتصالك الصوتي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Zuhören braucht Aufmerksamkeit. Verwenden Sie eine Waage oder einen Übungsplan, während Sie Ihre Audioverbindung überprüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live listening needs attention. Use a scale or practice plan while you check your audio connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La escucha en vivo necesita atención. Utilice una báscula o un plan de práctica mientras comprueba su conexión de audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écoute en direct nécessite de l’attention. Utilisez une balance ou un plan de pratique pendant que vous vérifiez votre connexion audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブリスニングには注意が必要です。オーディオ接続を確認するときは、スケールや練習計画を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 청취에는 주의가 필요합니다. 오디오 연결을 확인하면서 규모 또는 연습 계획을 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A escuta ao vivo precisa de atenção. Use uma escala ou plano prático enquanto verifica sua conexão de áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Живое прослушивание требует внимания. Используйте шкалу или план тренировки, проверяя аудиосоединение."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nghe trực tiếp cần được chú ý. Sử dụng thang âm hoặc kế hoạch luyện tập trong khi bạn kiểm tra kết nối âm thanh của mình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现场聆听需要集中注意力。检查音频连接时使用音阶或练习计划。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現場聆聽需要集中註意力。檢查音訊連接時使用音階或練習計劃。"
          }
        }
      }
    },
