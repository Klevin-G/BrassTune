          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этой записи больше нет на этом устройстве."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi này không còn trên thiết bị này nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该录音已不再在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該錄音已不再在此裝置上。"
          }
        }
      }
    },
    "This removes practice history, sheet music, and saved sign-in information from this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إزالة سجل التدريبات والنوتة الموسيقية ومعلومات تسجيل الدخول المحفوظة من هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden der Übungsverlauf, die Noten und die gespeicherten Anmeldeinformationen von diesem Gerät entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes practice history, sheet music, and saved sign-in information from this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el historial de práctica, las partituras y la información de inicio de sesión guardada de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime l'historique des entraînements, les partitions et les informations de connexion enregistrées de cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、練習履歴、楽譜、保存されたサインイン情報が本機から削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 이 기기에서 연습 내역, 악보, 저장된 로그인 정보가 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o histórico de treinos, partituras e informações de login salvas deste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С этого устройства будет удалена история тренировок, ноты и сохраненная информация для входа."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa lịch sử luyện tập, bản nhạc và thông tin đăng nhập đã lưu khỏi thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从该设备中删除练习历史记录、乐谱和保存的登录信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將從該裝置中刪除練習記錄、樂譜和已儲存的登入資訊。"
          }
        }
      }
    },
    "This removes the imported file and clears score references from local sessions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إزالة الملف المستورد ومسح مراجع النوتة الموسيقية من الجلسات المحلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die importierte Datei entfernt und Notenverweise aus lokalen Sitzungen gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the imported file and clears score references from local sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el archivo importado y borra las referencias de partituras de las sesiones locales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime le fichier importé et efface les références de partitions des sessions locales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、インポートされたファイルが削除され、ローカル セッションから楽譜参照が消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 가져온 파일이 제거되고 로컬 세션에서 악보 참조가 지워집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o arquivo importado e limpa as referências de partituras das sessões locais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При этом импортированный файл будет удален, а ссылки на ноты из локальных сеансов будут удалены."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa tệp đã nhập và xóa tham chiếu bản nhạc khỏi các phiên cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除导入的文件并清除本地会话中的乐谱引用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將刪除匯入的檔案並清除本機會話中的樂譜引用。"
          }
        }
      }
    },
