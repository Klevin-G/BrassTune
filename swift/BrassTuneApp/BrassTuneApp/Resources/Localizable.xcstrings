        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بالضبط على الفور، وممارسة التمارين الموجهة، وحافظ على التقدم على هذا الجهاز. الحساب اختياري إلا إذا كنت تستخدم الفئات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimmen Sie sofort ein, üben Sie geführte Übungen und machen Sie mit diesem Gerät Fortschritte. Ein Konto ist optional, es sei denn, Sie verwenden Klassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tune right away, practice guided exercises, and keep progress on this device. An account is optional unless you use Classes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sintonízalo de inmediato, practica ejercicios guiados y sigue progresando en este dispositivo. Una cuenta es opcional a menos que uses Clases."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez-le immédiatement, pratiquez des exercices guidés et continuez à progresser sur cet appareil. Un compte est facultatif, sauf si vous utilisez des cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに調整し、ガイド付きの演習を練習し、このデバイスで進歩を続けてください。クラスを使用しない限り、アカウントはオプションです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 조정하고, 안내식 연습을 연습하고, 이 장치에서 계속 진행하세요. 클래스를 사용하지 않는 한 계정은 선택 사항입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sintonize imediatamente, pratique exercícios guiados e acompanhe o progresso neste dispositivo. Uma conta é opcional, a menos que você use Classes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настраивайтесь прямо сейчас, практикуйте упражнения с инструкциями и продолжайте прогресс на этом устройстве. Учетная запись не является обязательной, если вы не используете классы."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh ngay, thực hành các bài tập được hướng dẫn và theo dõi tiến độ trên thiết bị này. Tài khoản là tùy chọn trừ khi bạn sử dụng Lớp học."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即调整，练习指导练习，并在该设备上保持进步。除非您使用班级，否则帐户是可选的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即調整，練習指導練習，並在該裝置上保持進步。除非您使用班級，否則帳戶是可選的。"
          }
        }
      }
    },
