    "Every practice block needs a positive duration." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن تكون مدة كل مقطع تدريب أكبر من صفر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Übungsblock benötigt eine Dauer größer als null."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every practice block needs a positive duration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada bloque de práctica debe tener una duración mayor que cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque bloc d’entraînement doit avoir une durée supérieure à zéro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各練習ブロックの長さは0より大きくする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 연습 블록의 길이는 0보다 커야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada bloco de prática precisa ter uma duração maior que zero."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Длительность каждого блока должна быть больше нуля."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi khối luyện tập phải có thời lượng lớn hơn 0."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个练习块的时长必须大于 0。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個練習區塊的時長必須大於 0。"
          }
        }
      }
    },
