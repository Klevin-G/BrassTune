    "Welcome to BrassTune" : { "localizations" : {
      "ar":{"stringUnit":{"state":"translated","value":"مرحبًا بك في BrassTune"}},"de":{"stringUnit":{"state":"translated","value":"Willkommen bei BrassTune"}},"en":{"stringUnit":{"state":"translated","value":"Welcome to BrassTune"}},"es":{"stringUnit":{"state":"translated","value":"Te damos la bienvenida a BrassTune"}},"fr":{"stringUnit":{"state":"translated","value":"Bienvenue dans BrassTune"}},"ja":{"stringUnit":{"state":"translated","value":"BrassTuneへようこそ"}},"ko":{"stringUnit":{"state":"translated","value":"BrassTune에 오신 것을 환영합니다"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Boas-vindas ao BrassTune"}},"ru":{"stringUnit":{"state":"translated","value":"Добро пожаловать в BrassTune"}},"vi":{"stringUnit":{"state":"translated","value":"Chào mừng đến với BrassTune"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"欢迎使用 BrassTune"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"歡迎使用 BrassTune"}}
