    "The reference tone stopped because your audio output changed. Check your headphones or speaker before restarting." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقفت النغمة المرجعية بسبب تغير إخراج الصوت. تحقق من سماعات الرأس أو مكبر الصوت قبل إعادة التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Referenzton wurde gestoppt, weil sich Ihre Audioausgabe geändert hat. Überprüfen Sie vor dem Neustart Ihre Kopfhörer oder Lautsprecher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reference tone stopped because your audio output changed. Check your headphones or speaker before restarting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tono de referencia se detuvo porque su salida de audio cambió. Verifique sus auriculares o altavoz antes de reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tonalité de référence s'est arrêtée car votre sortie audio a changé. Vérifiez vos écouteurs ou votre haut-parleur avant de redémarrer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオ出力が変化したため、基準音が停止しました。再起動する前にヘッドフォンまたはスピーカーを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오 출력이 변경되어 기준음이 중지되었습니다. 다시 시작하기 전에 헤드폰이나 스피커를 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tom de referência parou porque a saída de áudio foi alterada. Verifique seus fones de ouvido ou alto-falante antes de reiniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опорный сигнал прекратился, потому что у вас изменился аудиовыход. Проверьте наушники или динамик перед перезапуском."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm tham chiếu đã dừng do đầu ra âm thanh của bạn thay đổi. Kiểm tra tai nghe hoặc loa của bạn trước khi khởi động lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于音频输出发生变化，参考音停止了。重新启动之前检查您的耳机或扬声器。"
