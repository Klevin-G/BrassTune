    "1/%@ beat" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"1/%@ beat"}},"ar":{"stringUnit":{"state":"translated","value":"1/%@ فوز"}},"de":{"stringUnit":{"state":"translated","value":"1/%@ Schlag"}},"es":{"stringUnit":{"state":"translated","value":"1/%@ latido"}},"fr":{"stringUnit":{"state":"translated","value":"1/%@ battement"}},"ja":{"stringUnit":{"state":"translated","value":"1/%@ビート"}},"ko":{"stringUnit":{"state":"translated","value":"1/%@ 비트"}},"pt-BR":{"stringUnit":{"state":"translated","value":"1/%@ batida"}},"ru":{"stringUnit":{"state":"translated","value":"1/%@ удар"}},"vi":{"stringUnit":{"state":"translated","value":"nhịp 1/%@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"1/%@节拍"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"1/%@節拍"}}}} ,
    "6/8, 9/8, and 12/8 use BPM as a dotted-quarter pulse." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"6/8, 9/8, and 12/8 use BPM as a dotted-quarter pulse."}},"ar":{"stringUnit":{"state":"translated","value":"تستخدم 6/8 و9/8 و12/8 BPM كنبض ربع منقط."}},"de":{"stringUnit":{"state":"translated","value":"6/8, 9/8 und 12/8 verwenden BPM als punktierten Viertelimpuls."}},"es":{"stringUnit":{"state":"translated","value":"6/8, 9/8 y 12/8 utilizan BPM como un pulso de cuarto punteado."}},"fr":{"stringUnit":{"state":"translated","value":"6/8, 9/8 et 12/8 utilisent le BPM comme impulsion en quart pointé."}},"ja":{"stringUnit":{"state":"translated","value":"6/8、9/8、および 12/8 は、BPM を点線 4 分の 1 パルスとして使用します。"}},"ko":{"stringUnit":{"state":"translated","value":"6/8, 9/8, 12/8은 BPM을 점으로 구분된 펄스로 사용합니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"6/8, 9/8 e 12/8 usam BPM como um pulso pontilhado."}},"ru":{"stringUnit":{"state":"translated","value":"6/8, 9/8 и 12/8 используют BPM в виде пульса с пунктирными четвертями."}},"vi":{"stringUnit":{"state":"translated","value":"6/8, 9/8 và 12/8 sử dụng BPM làm xung một phần tư chấm."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"6/8、9/8 和 12/8 使用 BPM 作为点四分之一脉冲。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"6/8、9/8 和 12/8 使用 BPM 作為點四分之一脈衝。"}}}} ,
    "A username is required. Your display name is optional." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A username is required. Your display name is optional."}},"ar":{"stringUnit":{"state":"translated","value":"اسم المستخدم مطلوب. اسم العرض الخاص بك اختياري."}},"de":{"stringUnit":{"state":"translated","value":"Ein Benutzername ist erforderlich. Ihr Anzeigename ist optional."}},"es":{"stringUnit":{"state":"translated","value":"Se requiere un nombre de usuario. Su nombre para mostrar es opcional."}},"fr":{"stringUnit":{"state":"translated","value":"Un nom d'utilisateur est requis. Votre nom d’affichage est facultatif."}},"ja":{"stringUnit":{"state":"translated","value":"ユーザー名は必須です。表示名はオプションです。"}},"ko":{"stringUnit":{"state":"translated","value":"사용자 이름이 필요합니다. 표시 이름은 선택 사항입니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"É necessário um nome de usuário. Seu nome de exibição é opcional."}},"ru":{"stringUnit":{"state":"translated","value":"Требуется имя пользователя. Ваше отображаемое имя не является обязательным."}},"vi":{"stringUnit":{"state":"translated","value":"Cần có tên người dùng. Tên hiển thị của bạn là tùy chọn."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要用户名。您的显示名称是可选的。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"需要用戶名。您的顯示名稱是可選的。"}}}} ,
    "Change your username, display name, or optional profile photo" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Change your username, display name, or optional profile photo"}},"ar":{"stringUnit":{"state":"translated","value":"قم بتغيير اسم المستخدم أو اسم العرض أو صورة الملف الشخصي الاختيارية"}},"de":{"stringUnit":{"state":"translated","value":"Ändern Sie Ihren Benutzernamen, Anzeigenamen oder optional Ihr Profilfoto"}},"es":{"stringUnit":{"state":"translated","value":"Cambie su nombre de usuario, nombre para mostrar o foto de perfil opcional"}},"fr":{"stringUnit":{"state":"translated","value":"Modifiez votre nom d'utilisateur, votre nom d'affichage ou votre photo de profil facultative"}},"ja":{"stringUnit":{"state":"translated","value":"ユーザー名、表示名、またはオプションのプロフィール写真を変更します"}},"ko":{"stringUnit":{"state":"translated","value":"사용자 이름, 표시 이름 또는 선택적 프로필 사진 변경"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Altere seu nome de usuário, nome de exibição ou foto de perfil opcional"}},"ru":{"stringUnit":{"state":"translated","value":"Измените свое имя пользователя, отображаемое имя или дополнительную фотографию профиля."}},"vi":{"stringUnit":{"state":"translated","value":"Thay đổi tên người dùng, tên hiển thị hoặc ảnh hồ sơ tùy chọn của bạn"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"更改您的用户名、显示名称或可选的个人资料照片"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"更改您的使用者名稱、顯示名稱或可選的個人資料照片"}}}} ,
    "Choose photo" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose photo"}},"ar":{"stringUnit":{"state":"translated","value":"اختر الصورة"}},"de":{"stringUnit":{"state":"translated","value":"Foto auswählen"}},"es":{"stringUnit":{"state":"translated","value":"Elige foto"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir une photo"}},"ja":{"stringUnit":{"state":"translated","value":"写真を選択してください"}},"ko":{"stringUnit":{"state":"translated","value":"사진 선택"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha a foto"}},"ru":{"stringUnit":{"state":"translated","value":"Выбрать фото"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn ảnh"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择照片"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇照片"}}}} ,
    "Create an account to choose a profile, keep your practice settings, and use account features when they are available." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Create an account to choose a profile, keep your practice settings, and use account features when they are available."}},"ar":{"stringUnit":{"state":"translated","value":"أنشئ حسابًا لاختيار ملف تعريف، واحتفظ بإعدادات التدريب الخاصة بك، واستخدم ميزات الحساب عندما تكون متاحة."}},"de":{"stringUnit":{"state":"translated","value":"Erstellen Sie ein Konto, um ein Profil auszuwählen, Ihre Praxiseinstellungen beizubehalten und Kontofunktionen zu nutzen, sofern diese verfügbar sind."}},"es":{"stringUnit":{"state":"translated","value":"Cree una cuenta para elegir un perfil, conservar la configuración de su práctica y utilizar las funciones de la cuenta cuando estén disponibles."}},"fr":{"stringUnit":{"state":"translated","value":"Créez un compte pour choisir un profil, conserver vos paramètres de pratique et utiliser les fonctionnalités du compte lorsqu'elles sont disponibles."}},"ja":{"stringUnit":{"state":"translated","value":"アカウントを作成してプロファイルを選択し、練習設定を保持し、アカウント機能が利用可能な場合はそれを使用します。"}},"ko":{"stringUnit":{"state":"translated","value":"프로필을 선택하고, 연습 설정을 유지하고, 가능한 경우 계정 기능을 사용하려면 계정을 만드세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Crie uma conta para escolher um perfil, manter suas configurações de prática e usar os recursos da conta quando estiverem disponíveis."}},"ru":{"stringUnit":{"state":"translated","value":"Создайте учетную запись, чтобы выбрать профиль, сохранить настройки практики и использовать функции учетной записи, когда они доступны."}},"vi":{"stringUnit":{"state":"translated","value":"Tạo một tài khoản để chọn hồ sơ, giữ cài đặt thực hành của bạn và sử dụng các tính năng của tài khoản khi chúng khả dụng."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建帐户以选择配置文件、保留您的练习设置并在可用时使用帐户功能。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"建立帳戶以選擇設定檔、保留您的練習設定並在可用時使用帳戶功能。"}}}} ,
    "Display name" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Display name"}},"ar":{"stringUnit":{"state":"translated","value":"اسم العرض"}},"de":{"stringUnit":{"state":"translated","value":"Anzeigename"}},"es":{"stringUnit":{"state":"translated","value":"Nombre para mostrar"}},"fr":{"stringUnit":{"state":"translated","value":"Nom d'affichage"}},"ja":{"stringUnit":{"state":"translated","value":"表示名"}},"ko":{"stringUnit":{"state":"translated","value":"표시 이름"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nome de exibição"}},"ru":{"stringUnit":{"state":"translated","value":"Отображаемое имя"}},"vi":{"stringUnit":{"state":"translated","value":"Tên hiển thị"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"显示名称"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"顯示名稱"}}}} ,
    "Edit profile" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Edit profile"}},"ar":{"stringUnit":{"state":"translated","value":"تحرير الملف الشخصي"}},"de":{"stringUnit":{"state":"translated","value":"Profil bearbeiten"}},"es":{"stringUnit":{"state":"translated","value":"Editar perfil"}},"fr":{"stringUnit":{"state":"translated","value":"Modifier le profil"}},"ja":{"stringUnit":{"state":"translated","value":"プロフィールの編集"}},"ko":{"stringUnit":{"state":"translated","value":"프로필 수정"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Editar perfil"}},"ru":{"stringUnit":{"state":"translated","value":"Редактировать профиль"}},"vi":{"stringUnit":{"state":"translated","value":"Chỉnh sửa hồ sơ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑个人资料"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"編輯個人資料"}}}} ,
    "Listening" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Listening"}},"ar":{"stringUnit":{"state":"translated","value":"الاستماع"}},"de":{"stringUnit":{"state":"translated","value":"Zuhören"}},"es":{"stringUnit":{"state":"translated","value":"escuchando"}},"fr":{"stringUnit":{"state":"translated","value":"Écoute"}},"ja":{"stringUnit":{"state":"translated","value":"リスニング"}},"ko":{"stringUnit":{"state":"translated","value":"듣기"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ouvindo"}},"ru":{"stringUnit":{"state":"translated","value":"Прослушивание"}},"vi":{"stringUnit":{"state":"translated","value":"Nghe"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"听力"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"聽力"}}}} ,
    "Optional. BrassTune re-encodes your selected photo before upload, so its original photo metadata is not sent." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optional. BrassTune re-encodes your selected photo before upload, so its original photo metadata is not sent."}},"ar":{"stringUnit":{"state":"translated","value":"اختياري. يقوم BrassTune بإعادة ترميز الصورة المحددة قبل التحميل، لذلك لا يتم إرسال البيانات الوصفية للصورة الأصلية."}},"de":{"stringUnit":{"state":"translated","value":"Optional. BrassTune kodiert Ihr ausgewähltes Foto vor dem Hochladen neu, sodass die ursprünglichen Fotometadaten nicht gesendet werden."}},"es":{"stringUnit":{"state":"translated","value":"Opcional. BrassTune vuelve a codificar la foto seleccionada antes de cargarla, por lo que no se envían los metadatos de la foto original."}},"fr":{"stringUnit":{"state":"translated","value":"Facultatif. BrassTune réencode votre photo sélectionnée avant le téléchargement, de sorte que ses métadonnées de photo originales ne sont pas envoyées."}},"ja":{"stringUnit":{"state":"translated","value":"オプション。 BrassTune は選択した写真をアップロード前に再エンコードするため、元の写真のメタデータは送信されません。"}},"ko":{"stringUnit":{"state":"translated","value":"선택사항. BrassTune은 업로드하기 전에 선택한 사진을 다시 인코딩하므로 원본 사진 메타데이터는 전송되지 않습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Opcional. O BrassTune recodifica a foto selecionada antes do upload, para que os metadados da foto original não sejam enviados."}},"ru":{"stringUnit":{"state":"translated","value":"Необязательно. BrassTune перекодирует выбранную вами фотографию перед загрузкой, поэтому исходные метаданные фотографии не отправляются."}},"vi":{"stringUnit":{"state":"translated","value":"Tùy chọn. BrassTune mã hóa lại ảnh đã chọn của bạn trước khi tải lên, do đó siêu dữ liệu ảnh gốc của ảnh sẽ không được gửi."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可选。 BrassTune 在上传之前重新编码您选择的照片，因此不会发送其原始照片元数据。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可選。 BrassTune 在上傳之前重新編碼您選擇的照片，因此不會發送其原始照片元資料。"}}}} ,
    "Profile" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Profile"}},"ar":{"stringUnit":{"state":"translated","value":"الملف الشخصي"}},"de":{"stringUnit":{"state":"translated","value":"Profil"}},"es":{"stringUnit":{"state":"translated","value":"Perfil"}},"fr":{"stringUnit":{"state":"translated","value":"Profil"}},"ja":{"stringUnit":{"state":"translated","value":"プロフィール"}},"ko":{"stringUnit":{"state":"translated","value":"프로필"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Perfil"}},"ru":{"stringUnit":{"state":"translated","value":"Профиль"}},"vi":{"stringUnit":{"state":"translated","value":"Hồ sơ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"公司简介"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"公司簡介"}}}} ,
