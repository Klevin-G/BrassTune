    "No self-assessed attempts logged yet." : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"لم تُسجَّل محاولات مقيّمة ذاتيًا بعد."}},"de":{"stringUnit":{"state":"translated","value":"Noch keine selbst eingeschätzten Versuche festgehalten."}},"en":{"stringUnit":{"state":"translated","value":"No self-assessed attempts logged yet."}},"es":{"stringUnit":{"state":"translated","value":"Aún no hay intentos autoevaluados registrados."}},"fr":{"stringUnit":{"state":"translated","value":"Aucune tentative auto-évaluée n’a encore été enregistrée."}},"ja":{"stringUnit":{"state":"translated","value":"自己評価した試行はまだ記録されていません。"}},"ko":{"stringUnit":{"state":"translated","value":"직접 평가한 시도가 아직 기록되지 않았습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ainda não há tentativas autoavaliadas registradas."}},"ru":{"stringUnit":{"state":"translated","value":"Самостоятельно оценённые попытки ещё не записаны."}},"vi":{"stringUnit":{"state":"translated","value":"Chưa có lượt thử tự đánh giá nào được ghi lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未记录自我评估的尝试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚未記錄自我評估的嘗試。"}}}},
