    "The account service couldn't refresh your sign-in right now. Your saved session will be retried later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على خدمة الحساب تحديث تسجيل دخولك الآن. ستتم إعادة محاولة جلستك المحفوظة لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontodienst konnte Ihre Anmeldung derzeit nicht aktualisieren. Ihre gespeicherte Sitzung wird später wiederholt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account service couldn't refresh your sign-in right now. Your saved session will be retried later."
          }
        },
        "es": {
          "stringUnit": {
