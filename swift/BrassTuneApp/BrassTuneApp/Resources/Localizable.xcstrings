    "Practice as a guest today. Account sign-in will be available when account access is ready." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدرب كضيف اليوم. سيكون تسجيل الدخول إلى الحساب متاحًا عندما يكون الوصول إلى الحساب جاهزًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üben Sie noch heute als Gast. Die Kontoanmeldung ist verfügbar, sobald der Kontozugriff bereit ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practice as a guest today. Account sign-in will be available when account access is ready."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practica como invitado hoy. El inicio de sesión de la cuenta estará disponible cuando el acceso a la cuenta esté listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entraînez-vous en tant qu'invité aujourd'hui. La connexion au compte sera disponible lorsque l’accès au compte sera prêt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日はゲストとして練習。アカウントへのアクセスの準備が整うと、アカウントへのサインインが可能になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 게스트로 연습해보세요. 계정 액세스가 준비되면 계정 로그인을 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratique como convidado hoje. O login da conta estará disponível quando o acesso à conta estiver pronto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потренируйтесь сегодня в качестве гостя. Вход в учетную запись будет доступен, когда доступ к учетной записи будет готов."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy tập làm khách ngay hôm nay. Đăng nhập tài khoản sẽ có sẵn khi quyền truy cập tài khoản đã sẵn sàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天以嘉宾身份练习。当帐户访问准备就绪时，即可使用帐户登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天以嘉賓身分練習。當帳戶存取準備就緒時，即可使用帳戶登入。"
          }
        }
      }
    },
    "Practice as a guest today. Account sign-in will be available when secure account access is ready." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدرب كضيف اليوم. سيكون تسجيل الدخول إلى الحساب متاحًا عندما يكون الوصول الآمن إلى الحساب جاهزًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üben Sie noch heute als Gast. Die Kontoanmeldung ist verfügbar, sobald der sichere Kontozugriff bereit ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practice as a guest today. Account sign-in will be available when secure account access is ready."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practica como invitado hoy. El inicio de sesión en la cuenta estará disponible cuando el acceso seguro a la cuenta esté listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entraînez-vous en tant qu'invité aujourd'hui. La connexion au compte sera disponible lorsque l’accès sécurisé au compte sera prêt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日はゲストとして練習。安全なアカウント アクセスの準備が整うと、アカウントのサインインが可能になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 게스트로 연습해보세요. 보안 계정 액세스가 준비되면 계정 로그인을 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratique como convidado hoje. O login da conta estará disponível quando o acesso seguro à conta estiver pronto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потренируйтесь сегодня в качестве гостя. Вход в учетную запись будет доступен, когда будет готов безопасный доступ к учетной записи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy tập làm khách ngay hôm nay. Việc đăng nhập tài khoản sẽ khả dụng khi quyền truy cập tài khoản an toàn sẵn sàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天以嘉宾身份练习。当安全帐户访问准备就绪时，帐户登录将可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天以嘉賓身分練習。當安全帳戶存取準備就緒時，帳戶登入將可用。"
          }
        }
      }
    },
    "Practice as a guest today. Online backup and Classes will appear when account access is available." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدرّب كضيف اليوم. سيظهر النسخ الاحتياطي عبر الإنترنت والصفوف عند توفر الوصول إلى الحساب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übe heute als Gast. Online-Backup und Kurse erscheinen, sobald der Kontozugriff verfügbar ist."
