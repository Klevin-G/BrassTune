    "See how your tuning changes as you practice." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انظر كيف يتغير ضبطك أثناء ممارستك."
          }
        },
        "de" : {
          "stringUnit" : {
