    "Deleting your account also removes practice history and sheet music saved on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي حذف حسابك أيضًا إلى إزالة سجل التدريبات والنوتات الموسيقية المحفوظة على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch das Löschen Ihres Kontos werden auch der Übungsverlauf und die auf diesem Gerät gespeicherten Noten gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting your account also removes practice history and sheet music saved on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar tu cuenta también se elimina el historial de práctica y las partituras guardadas en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de votre compte supprime également l'historique des entraînements et les partitions enregistrées sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを削除すると、本機に保存されている練習履歴や楽譜も削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 삭제하면 이 기기에 저장된 연습 기록과 악보도 제거됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir sua conta também remove o histórico de treinos e as partituras salvas neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление вашей учетной записи также приведет к удалению истории тренировок и нот, сохраненных на этом устройстве."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc xóa tài khoản của bạn cũng sẽ xóa lịch sử luyện tập và bản nhạc được lưu trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除您的帐户还会删除此设备上保存的练习历史记录和乐谱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除您的帳戶也會刪除此裝置上已儲存的練習記錄和樂譜。"
          }
        }
      }
    },
