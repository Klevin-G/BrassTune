    "Your sign-in expired. Sign in again before deleting your account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية تسجيل الدخول الخاص بك. قم بتسجيل الدخول مرة أخرى قبل حذف حسابك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Anmeldung ist abgelaufen. Melden Sie sich erneut an, bevor Sie Ihr Konto löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sign-in expired. Sign in again before deleting your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su inicio de sesión expiró. Inicie sesión nuevamente antes de eliminar su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre connexion a expiré. Connectez-vous à nouveau avant de supprimer votre compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインの有効期限が切れました。アカウントを削除する前に、再度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인이 만료되었습니다. 계정을 삭제하기 전에 다시 로그인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu login expirou. Faça login novamente antes de excluir sua conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия вашего входа истек. Прежде чем удалять свою учетную запись, войдите еще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập của bạn đã hết hạn. Đăng nhập lại trước khi xóa tài khoản của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的登录已过期。删除您的帐户之前请重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的登入已過期。刪除您的帳戶之前請重新登入。"
          }
        }
      }
    },
    "Your sign-in expired. Sign in again, then retry.": {
      "localizations": {
