          "stringUnit": {
            "state": "translated",
            "value": "銅管樂"
          }
        }
      }
    },
    "BrassTune can import PDF, JPEG, PNG, and HEIC score files.": {
      "localizations": {
        "ar": {
          "stringUnit": {
