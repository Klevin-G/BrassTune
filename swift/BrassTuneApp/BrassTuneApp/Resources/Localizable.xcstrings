    "The account service couldn't refresh your sign-in right now. Your saved session will be retried later." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على خدمة الحساب تحديث تسجيل دخولك الآن. ستتم إعادة محاولة جلستك المحفوظة لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kontodienst konnte Ihre Anmeldung derzeit nicht aktualisieren. Ihre gespeicherte Sitzung wird später wiederholt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account service couldn't refresh your sign-in right now. Your saved session will be retried later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio de cuenta no pudo actualizar su inicio de sesión en este momento. Su sesión guardada se volverá a intentar más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service de compte n'a pas pu actualiser votre connexion pour le moment. Votre session enregistrée sera réessayée plus tard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在、アカウント サービスはサインインを更新できませんでした。保存したセッションは後で再試行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 계정 서비스에서 로그인을 새로 고칠 수 없습니다. 저장된 세션은 나중에 다시 시도됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O serviço de conta não conseguiu atualizar seu login no momento. Sua sessão salva será repetida mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Службе учетных записей не удалось обновить данные для входа в систему. Сохраненный сеанс будет повторен позже."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch vụ tài khoản không thể làm mới thông tin đăng nhập của bạn ngay bây giờ. Phiên đã lưu của bạn sẽ được thử lại sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帐户服务目前无法刷新您的登录信息。您保存的会话稍后将重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帳戶服務目前無法刷新您的登入資訊。您儲存的會話稍後將重試。"
          }
        }
      }
    },
