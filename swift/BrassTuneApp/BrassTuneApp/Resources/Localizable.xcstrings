    "Breathe in quietly for 4 counts and release for 8. Keep shoulders loose." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استنشق بهدوء لأربع عدات وأطلق النفس لثماني عدات. أبقِ كتفيك مسترخيين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmen Sie vier Schläge lang leise ein und acht Schläge lang aus. Halten Sie die Schultern locker."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe in quietly for 4 counts and release for 8. Keep shoulders loose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala en silencio durante 4 tiempos y suelta el aire durante 8. Mantén los hombros relajados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez silencieusement pendant 4 temps et expirez pendant 8. Gardez les épaules détendues."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4拍で静かに息を吸い、8拍で吐きます。肩の力を抜きましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4박 동안 조용히 들이마시고 8박 동안 내쉬세요. 어깨에 힘을 빼세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire em silêncio por 4 tempos e solte o ar por 8. Mantenha os ombros relaxados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тихо вдохните на 4 счёта и выдохните на 8. Держите плечи расслабленными."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hít vào nhẹ nhàng trong 4 phách và thở ra trong 8 phách. Giữ vai thả lỏng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 4 拍安静地吸气，再用 8 拍呼气。保持肩膀放松。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 4 拍安靜地吸氣，再用 8 拍呼氣。保持肩膀放鬆。"
          }
        }
      }
    },
    "Breathe in quietly for 4 counts, hold for 1, and release for 8. Keep shoulders loose." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنفس بهدوء لمدة 4 عدات، ثم احبسه لمدة واحدة، ثم أطلق سراحه لمدة 8. وحافظ على كتفيك مفكوكتين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmen Sie 4 Mal ruhig ein, halten Sie 1 Mal die Luft und lassen Sie 8 Mal los. Halten Sie die Schultern locker."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe in quietly for 4 counts, hold for 1, and release for 8. Keep shoulders loose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale tranquilamente contando hasta 4, sostenga durante 1 y suelte durante 8. Mantenga los hombros relajados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez doucement pendant 4 temps, maintenez pendant 1 et relâchez pendant 8. Gardez les épaules lâches."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 数えながら静かに息を吸い、1 数えて息を止め、8 数えて手を離します。肩の力を抜いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4초 동안 조용히 숨을 들이쉬고, 1초 동안 참았다가 8초 동안 뗐습니다. 어깨를 느슨하게 유지하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire silenciosamente por 4 contagens, segure por 1 e solte por 8. Mantenha os ombros soltos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спокойно вдохните на 4 счета, задержите дыхание на 1 и расслабьтесь на 8. Держите плечи расслабленными."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hít vào nhẹ nhàng trong 4 nhịp đếm, giữ trong 1 nhịp và thả ra trong 8 nhịp. Giữ vai thả lỏng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安静地吸气 4 下，屏住 1 下，放松 8 下。保持肩膀放松。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安靜地吸氣 4 下，屏住 1 下，放鬆 8 下。保持肩膀放鬆。"
          }
        }
      }
