{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ minutes" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"%@ دقيقة"}},"de":{"stringUnit":{"state":"translated","value":"%@ Minuten"}},"en":{"stringUnit":{"state":"translated","value":"%@ minutes"}},"es":{"stringUnit":{"state":"translated","value":"%@ minutos"}},"fr":{"stringUnit":{"state":"translated","value":"%@ minutes"}},"ja":{"stringUnit":{"state":"translated","value":"%@分"}},"ko":{"stringUnit":{"state":"translated","value":"%@분"}},"pt-BR":{"stringUnit":{"state":"translated","value":"%@ minutos"}},"ru":{"stringUnit":{"state":"translated","value":"%@ мин"}},"vi":{"stringUnit":{"state":"translated","value":"%@ phút"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 分钟"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 分鐘"}}}},
    "Account sign-in needs secure service configuration. You can keep practicing as a guest." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"يتطلب تسجيل الدخول إلى الحساب إعدادًا آمنًا للخدمة. يمكنك مواصلة التدريب كضيف."}},"de":{"stringUnit":{"state":"translated","value":"Die Kontoanmeldung benötigt eine sichere Dienstkonfiguration. Du kannst als Gast weiterüben."}},"en":{"stringUnit":{"state":"translated","value":"Account sign-in needs secure service configuration. You can keep practicing as a guest."}},"es":{"stringUnit":{"state":"translated","value":"El inicio de sesión necesita una configuración segura del servicio. Puedes seguir practicando como invitado."}},"fr":{"stringUnit":{"state":"translated","value":"La connexion au compte nécessite une configuration sécurisée du service. Vous pouvez continuer en tant qu’invité."}},"ja":{"stringUnit":{"state":"translated","value":"アカウントのサインインには安全なサービス設定が必要です。ゲストとして練習を続けられます。"}},"ko":{"stringUnit":{"state":"translated","value":"계정 로그인에는 안전한 서비스 구성이 필요합니다. 게스트로 계속 연습할 수 있습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O início de sessão precisa de configuração segura do serviço. Você pode continuar praticando como convidado."}},"ru":{"stringUnit":{"state":"translated","value":"Для входа в аккаунт нужна безопасная настройка сервиса. Можно продолжить занятия как гость."}},"vi":{"stringUnit":{"state":"translated","value":"Đăng nhập tài khoản cần cấu hình dịch vụ bảo mật. Bạn có thể tiếp tục luyện tập với tư cách khách."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账户登录需要安全的服务配置。你可以继续以访客身份练习。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"帳戶登入需要安全的服務設定。你可以繼續以訪客身分練習。"}}}},
    "Apple and Google" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"Apple وGoogle"}},"de":{"stringUnit":{"state":"translated","value":"Apple und Google"}},"en":{"stringUnit":{"state":"translated","value":"Apple and Google"}},"es":{"stringUnit":{"state":"translated","value":"Apple y Google"}},"fr":{"stringUnit":{"state":"translated","value":"Apple et Google"}},"ja":{"stringUnit":{"state":"translated","value":"AppleとGoogle"}},"ko":{"stringUnit":{"state":"translated","value":"Apple 및 Google"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Apple e Google"}},"ru":{"stringUnit":{"state":"translated","value":"Apple и Google"}},"vi":{"stringUnit":{"state":"translated","value":"Apple và Google"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 和 Google"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Apple 和 Google"}}}},
    "Apple and Google sign-in need provider setup. Email and password still work." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"يتطلب تسجيل الدخول عبر Apple وGoogle إعداد موفري الخدمة. لا يزال البريد الإلكتروني وكلمة المرور يعملان."}},"de":{"stringUnit":{"state":"translated","value":"Die Anmeldung mit Apple und Google benötigt eine Anbieter-Einrichtung. E-Mail und Passwort funktionieren weiterhin."}},"en":{"stringUnit":{"state":"translated","value":"Apple and Google sign-in need provider setup. Email and password still work."}},"es":{"stringUnit":{"state":"translated","value":"El inicio con Apple y Google requiere configurar los proveedores. El correo y la contraseña siguen funcionando."}},"fr":{"stringUnit":{"state":"translated","value":"La connexion avec Apple et Google nécessite la configuration des fournisseurs. L’e-mail et le mot de passe fonctionnent toujours."}},"ja":{"stringUnit":{"state":"translated","value":"AppleとGoogleでのサインインにはプロバイダ設定が必要です。メールとパスワードは引き続き使用できます。"}},"ko":{"stringUnit":{"state":"translated","value":"Apple 및 Google 로그인에는 제공업체 설정이 필요합니다. 이메일과 비밀번호는 계속 사용할 수 있습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O início de sessão com Apple e Google precisa de configuração dos provedores. E-mail e senha continuam funcionando."}},"ru":{"stringUnit":{"state":"translated","value":"Для входа через Apple и Google нужна настройка провайдеров. Электронная почта и пароль по-прежнему работают."}},"vi":{"stringUnit":{"state":"translated","value":"Đăng nhập bằng Apple và Google cần thiết lập nhà cung cấp. Email và mật khẩu vẫn hoạt động."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 和 Google 登录需要配置提供商。电子邮件和密码仍可使用。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Apple 和 Google 登入需要設定提供者。電子郵件和密碼仍可使用。"}}}},
    "BrassTune couldn't check Apple and Google sign-in. Retry or use email and password." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"تعذر على BrassTune التحقق من تسجيل الدخول عبر Apple وGoogle. أعد المحاولة أو استخدم البريد الإلكتروني وكلمة المرور."}},"de":{"stringUnit":{"state":"translated","value":"BrassTune konnte die Apple- und Google-Anmeldung nicht prüfen. Versuche es erneut oder nutze E-Mail und Passwort."}},"en":{"stringUnit":{"state":"translated","value":"BrassTune couldn't check Apple and Google sign-in. Retry or use email and password."}},"es":{"stringUnit":{"state":"translated","value":"BrassTune no pudo comprobar el inicio con Apple y Google. Reintenta o usa el correo y la contraseña."}},"fr":{"stringUnit":{"state":"translated","value":"BrassTune n’a pas pu vérifier la connexion Apple et Google. Réessayez ou utilisez l’e-mail et le mot de passe."}},"ja":{"stringUnit":{"state":"translated","value":"AppleとGoogleでのサインインを確認できませんでした。再試行するか、メールとパスワードを使用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Apple 및 Google 로그인을 확인할 수 없습니다. 다시 시도하거나 이메일과 비밀번호를 사용하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O BrassTune não pôde verificar o início com Apple e Google. Tente novamente ou use e-mail e senha."}},"ru":{"stringUnit":{"state":"translated","value":"BrassTune не удалось проверить вход через Apple и Google. Повторите попытку или используйте почту и пароль."}},"vi":{"stringUnit":{"state":"translated","value":"BrassTune không thể kiểm tra đăng nhập Apple và Google. Thử lại hoặc dùng email và mật khẩu."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"BrassTune 无法检查 Apple 和 Google 登录。请重试或使用电子邮件和密码。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"BrassTune 無法檢查 Apple 和 Google 登入。請重試或使用電子郵件和密碼。"}}}},
    "Checking sign-in providers…" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"جارٍ التحقق من موفري تسجيل الدخول…"}},"de":{"stringUnit":{"state":"translated","value":"Anmeldeanbieter werden geprüft…"}},"en":{"stringUnit":{"state":"translated","value":"Checking sign-in providers…"}},"es":{"stringUnit":{"state":"translated","value":"Comprobando proveedores de inicio…"}},"fr":{"stringUnit":{"state":"translated","value":"Vérification des fournisseurs de connexion…"}},"ja":{"stringUnit":{"state":"translated","value":"サインインプロバイダを確認中…"}},"ko":{"stringUnit":{"state":"translated","value":"로그인 제공업체 확인 중…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verificando provedores de início…"}},"ru":{"stringUnit":{"state":"translated","value":"Проверка провайдеров входа…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang kiểm tra nhà cung cấp đăng nhập…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查登录提供商…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在檢查登入提供者…"}}}},
    "Google sign-in was cancelled." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"تم إلغاء تسجيل الدخول عبر Google."}},"de":{"stringUnit":{"state":"translated","value":"Die Google-Anmeldung wurde abgebrochen."}},"en":{"stringUnit":{"state":"translated","value":"Google sign-in was cancelled."}},"es":{"stringUnit":{"state":"translated","value":"Se canceló el inicio de sesión con Google."}},"fr":{"stringUnit":{"state":"translated","value":"La connexion avec Google a été annulée."}},"ja":{"stringUnit":{"state":"translated","value":"Googleでのサインインがキャンセルされました。"}},"ko":{"stringUnit":{"state":"translated","value":"Google 로그인이 취소되었습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O início de sessão com o Google foi cancelado."}},"ru":{"stringUnit":{"state":"translated","value":"Вход через Google отменён."}},"vi":{"stringUnit":{"state":"translated","value":"Đã hủy đăng nhập bằng Google."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已取消使用 Google 登录。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已取消使用 Google 登入。"}}}},
    "One sign-in provider needs setup. Use an available provider or email and password." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"يحتاج أحد موفري تسجيل الدخول إلى الإعداد. استخدم موفرًا متاحًا أو البريد الإلكتروني وكلمة المرور."}},"de":{"stringUnit":{"state":"translated","value":"Ein Anmeldeanbieter muss eingerichtet werden. Nutze einen verfügbaren Anbieter oder E-Mail und Passwort."}},"en":{"stringUnit":{"state":"translated","value":"One sign-in provider needs setup. Use an available provider or email and password."}},"es":{"stringUnit":{"state":"translated","value":"Un proveedor de inicio necesita configuración. Usa uno disponible o el correo y la contraseña."}},"fr":{"stringUnit":{"state":"translated","value":"Un fournisseur de connexion doit être configuré. Utilisez un fournisseur disponible ou l’e-mail et le mot de passe."}},"ja":{"stringUnit":{"state":"translated","value":"1つのサインインプロバイダに設定が必要です。利用可能なプロバイダかメールとパスワードを使用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"로그인 제공업체 하나에 설정이 필요합니다. 사용 가능한 제공업체 또는 이메일과 비밀번호를 사용하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Um provedor de início precisa ser configurado. Use um provedor disponível ou e-mail e senha."}},"ru":{"stringUnit":{"state":"translated","value":"Один провайдер входа требует настройки. Используйте доступный провайдер или почту и пароль."}},"vi":{"stringUnit":{"state":"translated","value":"Một nhà cung cấp đăng nhập cần thiết lập. Hãy dùng nhà cung cấp có sẵn hoặc email và mật khẩu."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"一个登录提供商需要配置。请使用可用的提供商或电子邮件和密码。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"一個登入提供者需要設定。請使用可用的提供者或電子郵件和密碼。"}}}},
    "Retry provider check" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"إعادة التحقق من الموفر"}},"de":{"stringUnit":{"state":"translated","value":"Anbieter erneut prüfen"}},"en":{"stringUnit":{"state":"translated","value":"Retry provider check"}},"es":{"stringUnit":{"state":"translated","value":"Reintentar comprobación"}},"fr":{"stringUnit":{"state":"translated","value":"Revérifier les fournisseurs"}},"ja":{"stringUnit":{"state":"translated","value":"プロバイダを再確認"}},"ko":{"stringUnit":{"state":"translated","value":"제공업체 다시 확인"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verificar provedores novamente"}},"ru":{"stringUnit":{"state":"translated","value":"Повторить проверку"}},"vi":{"stringUnit":{"state":"translated","value":"Kiểm tra lại nhà cung cấp"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新检查提供商"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重新檢查提供者"}}}},
    "Sign in with Google" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"تسجيل الدخول باستخدام Google"}},"de":{"stringUnit":{"state":"translated","value":"Mit Google anmelden"}},"en":{"stringUnit":{"state":"translated","value":"Sign in with Google"}},"es":{"stringUnit":{"state":"translated","value":"Iniciar sesión con Google"}},"fr":{"stringUnit":{"state":"translated","value":"Se connecter avec Google"}},"ja":{"stringUnit":{"state":"translated","value":"Googleでログイン"}},"ko":{"stringUnit":{"state":"translated","value":"Google로 로그인"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Entrar com o Google"}},"ru":{"stringUnit":{"state":"translated","value":"Войти через Google"}},"vi":{"stringUnit":{"state":"translated","value":"Đăng nhập bằng Google"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 Google 登录"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用 Google 登入"}}}},
    "Signed in with Google." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"تم تسجيل الدخول عبر Google."}},"de":{"stringUnit":{"state":"translated","value":"Mit Google angemeldet."}},"en":{"stringUnit":{"state":"translated","value":"Signed in with Google."}},"es":{"stringUnit":{"state":"translated","value":"Sesión iniciada con Google."}},"fr":{"stringUnit":{"state":"translated","value":"Connecté avec Google."}},"ja":{"stringUnit":{"state":"translated","value":"Googleでサインインしました。"}},"ko":{"stringUnit":{"state":"translated","value":"Google로 로그인했습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sessão iniciada com o Google."}},"ru":{"stringUnit":{"state":"translated","value":"Вход через Google выполнен."}},"vi":{"stringUnit":{"state":"translated","value":"Đã đăng nhập bằng Google."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已使用 Google 登录。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已使用 Google 登入。"}}}},
    "That sign-in provider is not available right now. Try another sign-in method or keep practicing as a guest." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"موفر تسجيل الدخول هذا غير متاح الآن. جرّب طريقة أخرى أو واصل التدريب كضيف."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Anmeldeanbieter ist gerade nicht verfügbar. Nutze eine andere Methode oder übe als Gast weiter."}},"en":{"stringUnit":{"state":"translated","value":"That sign-in provider is not available right now. Try another sign-in method or keep practicing as a guest."}},"es":{"stringUnit":{"state":"translated","value":"Ese proveedor no está disponible ahora. Prueba otro método o sigue practicando como invitado."}},"fr":{"stringUnit":{"state":"translated","value":"Ce fournisseur de connexion est indisponible pour le moment. Essayez une autre méthode ou continuez en tant qu’invité."}},"ja":{"stringUnit":{"state":"translated","value":"このサインインプロバイダは現在利用できません。別の方法を試すか、ゲストとして練習を続けてください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 로그인 제공업체는 지금 사용할 수 없습니다. 다른 방법을 시도하거나 게스트로 계속 연습하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esse provedor não está disponível agora. Tente outro método ou continue praticando como convidado."}},"ru":{"stringUnit":{"state":"translated","value":"Этот провайдер входа сейчас недоступен. Попробуйте другой способ или продолжите как гость."}},"vi":{"stringUnit":{"state":"translated","value":"Nhà cung cấp đăng nhập này hiện không khả dụng. Hãy thử cách khác hoặc tiếp tục với tư cách khách."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此登录提供商当前不可用。请尝试其他登录方式或继续以访客身份练习。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此登入提供者目前無法使用。請嘗試其他登入方式或繼續以訪客身分練習。"}}}},
    "The sign-in callback could not be verified. Start sign-in again." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"تعذر التحقق من استدعاء تسجيل الدخول. ابدأ تسجيل الدخول من جديد."}},"de":{"stringUnit":{"state":"translated","value":"Der Anmelderückruf konnte nicht geprüft werden. Starte die Anmeldung erneut."}},"en":{"stringUnit":{"state":"translated","value":"The sign-in callback could not be verified. Start sign-in again."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo verificar la devolución del inicio. Inicia sesión de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"Le retour de connexion n’a pas pu être vérifié. Recommencez la connexion."}},"ja":{"stringUnit":{"state":"translated","value":"サインインのコールバックを確認できませんでした。もう一度サインインしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"로그인 콜백을 확인할 수 없습니다. 로그인을 다시 시작하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível verificar o retorno do início. Comece o início de sessão novamente."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось проверить возврат входа. Начните вход заново."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể xác minh lệnh gọi lại đăng nhập. Hãy bắt đầu đăng nhập lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法验证登录回调。请重新开始登录。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法驗證登入回呼。請重新開始登入。"}}}},
    "You" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"أنت"}},"de":{"stringUnit":{"state":"translated","value":"Du"}},"en":{"stringUnit":{"state":"translated","value":"You"}},"es":{"stringUnit":{"state":"translated","value":"Tú"}},"fr":{"stringUnit":{"state":"translated","value":"Vous"}},"ja":{"stringUnit":{"state":"translated","value":"あなた"}},"ko":{"stringUnit":{"state":"translated","value":"나"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Você"}},"ru":{"stringUnit":{"state":"translated","value":"Вы"}},"vi":{"stringUnit":{"state":"translated","value":"Bạn"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"你"}}}},
    "A new class code is ready. The previous code no longer works." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"رمز صف جديد جاهز. لم يعد الرمز السابق صالحًا."}},"de":{"stringUnit":{"state":"translated","value":"Ein neuer Kurscode ist bereit. Der vorherige Code funktioniert nicht mehr."}},"en":{"stringUnit":{"state":"translated","value":"A new class code is ready. The previous code no longer works."}},"es":{"stringUnit":{"state":"translated","value":"Hay un nuevo código de clase. El código anterior ya no funciona."}},"fr":{"stringUnit":{"state":"translated","value":"Un nouveau code de classe est prêt. L’ancien code ne fonctionne plus."}},"ja":{"stringUnit":{"state":"translated","value":"新しいクラスコードを発行しました。以前のコードは使用できません。"}},"ko":{"stringUnit":{"state":"translated","value":"새 수업 코드가 준비되었습니다. 이전 코드는 더 이상 작동하지 않습니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Um novo código de turma está pronto. O código anterior não funciona mais."}},"ru":{"stringUnit":{"state":"translated","value":"Новый код класса готов. Предыдущий код больше не работает."}},"vi":{"stringUnit":{"state":"translated","value":"Mã lớp mới đã sẵn sàng. Mã trước không còn hoạt động."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新班级代码已生成。原代码不再有效。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新的班級代碼已產生。原代碼不再有效。"}}}},
    "Accept invitation" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"قبول الدعوة"}},"de":{"stringUnit":{"state":"translated","value":"Einladung annehmen"}},"en":{"stringUnit":{"state":"translated","value":"Accept invitation"}},"es":{"stringUnit":{"state":"translated","value":"Aceptar invitación"}},"fr":{"stringUnit":{"state":"translated","value":"Accepter l’invitation"}},"ja":{"stringUnit":{"state":"translated","value":"招待を承認"}},"ko":{"stringUnit":{"state":"translated","value":"초대 수락"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aceitar convite"}},"ru":{"stringUnit":{"state":"translated","value":"Принять приглашение"}},"vi":{"stringUnit":{"state":"translated","value":"Chấp nhận lời mời"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"接受邀请"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"接受邀請"}}}},
    "Aggregate activity since each student joined." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"النشاط الإجمالي منذ انضمام كل طالب."}},"de":{"stringUnit":{"state":"translated","value":"Zusammengefasste Aktivität seit dem Beitritt jedes Schülers."}},"en":{"stringUnit":{"state":"translated","value":"Aggregate activity since each student joined."}},"es":{"stringUnit":{"state":"translated","value":"Actividad agregada desde que se unió cada estudiante."}},"fr":{"stringUnit":{"state":"translated","value":"Activité agrégée depuis l’arrivée de chaque élève."}},"ja":{"stringUnit":{"state":"translated","value":"各生徒が参加してからの集計アクティビティ。"}},"ko":{"stringUnit":{"state":"translated","value":"각 학생이 참여한 이후의 집계 활동입니다."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atividade agregada desde a entrada de cada aluno."}},"ru":{"stringUnit":{"state":"translated","value":"Сводная активность с момента вступления каждого ученика."}},"vi":{"stringUnit":{"state":"translated","value":"Hoạt động tổng hợp kể từ khi từng học sinh tham gia."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每位学生加入后的汇总活动。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每位學生加入後的彙總活動。"}}}},
    "Choose your instrument before accepting." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"اختر آلتك قبل القبول."}},"de":{"stringUnit":{"state":"translated","value":"Wähle vor dem Annehmen dein Instrument."}},"en":{"stringUnit":{"state":"translated","value":"Choose your instrument before accepting."}},"es":{"stringUnit":{"state":"translated","value":"Elige tu instrumento antes de aceptar."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez votre instrument avant d’accepter."}},"ja":{"stringUnit":{"state":"translated","value":"承認する前に楽器を選んでください。"}},"ko":{"stringUnit":{"state":"translated","value":"수락하기 전에 악기를 선택하세요."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha seu instrumento antes de aceitar."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите инструмент перед принятием."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn nhạc cụ trước khi chấp nhận."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"接受前请选择你的乐器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"接受前請選擇你的樂器。"}}}},
