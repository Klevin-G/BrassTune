    },
    "This instrument doesn't have a verified written-to-concert transposition, so BrassTune did not play a tone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي هذه الآلة على تحويل مكتوب إلى الحفلة الموسيقية، لذلك لم يعزف BrassTune نغمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Instrument gibt es keine verifizierte schriftliche Umsetzung in ein Konzert, daher hat BrassTune keinen Ton gespielt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This instrument doesn't have a verified written-to-concert transposition, so BrassTune did not play a tone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este instrumento no tiene una transposición escrita a concierto verificada, por lo que BrassTune no tocó ningún tono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet instrument n'a pas de transposition écrite-concert vérifiée, donc BrassTune n'a pas joué de son."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この楽器には検証済みのコンサート用移調機能がないため、BrassTune はトーンを再生しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 악기에는 콘서트에 맞게 작곡된 조옮김이 검증되지 않았기 때문에 BrassTune에서 음을 연주하지 못했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este instrumento não possui uma transposição verificada escrita para o concerto, então o BrassTune não tocou nenhum tom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот инструмент не имеет проверенной транспозиции, записанной для концерта, поэтому BrassTune не воспроизводил ни звука."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhạc cụ này không có chuyển âm được viết cho buổi hòa nhạc đã được xác minh, vì vậy BrassTune không phát âm sắc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该乐器没有经过验证的音乐会变调，因此 BrassTune 没有演奏音色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該樂器沒有經過驗證的音樂會變調，因此 BrassTune 沒有演奏音色。"
          }
        }
      }
    },
    "This recording is no longer on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد هذا التسجيل موجودًا على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
