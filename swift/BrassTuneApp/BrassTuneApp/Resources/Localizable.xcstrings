    "Edit or remove saved exercises here. Removing one also clears its shortcuts." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرّر التمارين المحفوظة أو احذفها هنا. يؤدي حذف تمرين أيضًا إلى إزالة اختصاراته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeite oder entferne hier gespeicherte Übungen. Beim Entfernen werden auch die zugehörigen Kurzbefehle gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit or remove saved exercises here. Removing one also clears its shortcuts."
          }
        },
        "es" : {
