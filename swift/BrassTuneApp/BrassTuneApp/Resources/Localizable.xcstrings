    "Signed in. Guest practice was merged without replacing existing account data." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تسجيل الدخول. تم دمج ممارسة الضيف دون استبدال بيانات الحساب الموجودة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angemeldet. Gastpraxis wurde zusammengeführt, ohne bestehende Kontodaten zu ersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signed in. Guest practice was merged without replacing existing account data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciado sesión. La práctica de invitados se fusionó sin reemplazar los datos de la cuenta existente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecté. La pratique Invité a été fusionnée sans remplacer les données de compte existantes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインしました。既存のアカウント データを置き換えることなく、ゲスト プラクティスが統合されました。"
