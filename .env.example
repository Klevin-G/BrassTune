# Frontend (Vercel)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
# Optional full Git SHA override for builds outside Vercel or GitHub Actions.
BRASSTUNE_FRONTEND_BUILD_SHA=

# Backend (Render/local)
APP_ENV=local
BRASSTUNE_AUTH_MODE=disabled
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_REGEX=
BRASSTUNE_ALLOW_CORS_REGEX=
BACKEND_PUBLIC_URL=http://localhost:8000
DATABASE_URL=
BRASSTUNE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SESSION_AUDIO_STORAGE_BACKEND=local
SUPABASE_STORAGE_BUCKET=session-audio
SESSION_AUDIO_MAX_BYTES=52428800
# Supabase CLI Auth-provider configuration. Keep values in local/provider
# secret stores; config.toml references these names and contains no secret.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_APPLE_SECRET=
# Dedicated standard-base64 HMAC key (32+ decoded bytes) for signed maintenance
# requests. The previous pair is optional during bounded key rotation only.
BRASSTUNE_MAINTENANCE_HMAC_KEY_ID=
BRASSTUNE_MAINTENANCE_HMAC_KEY=
BRASSTUNE_MAINTENANCE_HMAC_PREVIOUS_KEY_ID=
BRASSTUNE_MAINTENANCE_HMAC_PREVIOUS_KEY=
# Dedicated stable 32+ byte HMAC key. Never reuse or casually rotate this value.
BRASSTUNE_DELETION_TOMBSTONE_SECRET=

# Deployment secret names only; set real values in provider secret stores.
RENDER_DEPLOY_HOOK_URL=
RENDER_SERVICE_ID=
RENDER_API_KEY=
RENDER_KEEPALIVE_URL=https://brasstune-u8qj.onrender.com/api/live
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
BRASSTUNE_VERCEL_AUTOMATION_BYPASS_SECRET=

# Hosted smoke defaults for local/provider-direct release verification.
BRASSTUNE_WEB_BASE_URL=https://brasstune.vercel.app
BRASSTUNE_WEB_ACCESS_URL=
BRASSTUNE_API_BASE_URL=https://brasstune-u8qj.onrender.com
BRASSTUNE_WS_BASE_URL=wss://brasstune-u8qj.onrender.com
BRASSTUNE_AUTH_TOKEN=
BRASSTUNE_EXPECTED_SHA=
BRASSTUNE_EXPECTED_FRONTEND_SHA=
