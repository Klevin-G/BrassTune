      "notes": ["C", "D"],
      "frames": [
        { "timestamp_ms": 0, "written_note": "C", "cents": 4, "confidence": 0.9 },
        { "timestamp_ms": 250, "written_note": "C", "cents": 4, "confidence": 0.9 },
        { "timestamp_ms": 500, "written_note": "C", "cents": 4, "confidence": 0.9 },
        { "timestamp_ms": 750, "written_note": "C", "cents": 4, "confidence": 0.9 },
        { "timestamp_ms": 1000, "written_note": "C", "cents": 4, "confidence": 0.9 },
